{"parentUuid":"6de0a482-e48f-4195-a16e-ae037147bc2b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/apps/validate/src/analyze.ts","snippet":"1\timport { readFileSync, existsSync, writeFileSync } from 'node:fs'\n2\timport type { ToolResult, NormalizedProp } from './types.ts'\n3\t\n4\t// ─── Loading ──────────────────────────────────────────────────────────────\n5\t\n6\tfunction loadBaseline(name: string): Map<string, ToolResult> | null {\n7\t  const p = `./baselines/${name}.json`\n8\t  if (!existsSync(p)) return null\n9\t  const results: ToolResult[] = JSON.parse(readFileSync(p, 'utf8'))\n10\t  return new Map(results.map((r) => [r.fixture, r]))\n11\t}\n12\t\n13\tconst ours = loadBaseline('oxc-react-docgen')\n14\t// react-docgen resolves no inherited/`extends` props of its own — compare against our\n15\t// html-attributes=none baseline (falls back to the full baseline if that variant wasn't\n16\t// generated) so this pair isn't dominated by an inheritance-resolution mismatch instead of\n17\t// an actual prop-level agreement signal.\n18\tconst oursForRdg = loadBaseline('oxc-react-docgen-none') ?? ours\n19\tconst rdt = loadBaseline('react-docgen-typescript')\n20\tconst rdg = loadBaseline('react-docgen')\n21\t\n22\tif (!ours) {\n23\t  console.error('No oxc-react-docgen baseline found — run `pnpm run:ours` first.')\n24\t  process.exit(1)\n25\t}\n26\t\n27\t// ─── Divergence taxonomy ──────────────────────────────────────────────────\n28\t//\n29\t// Classifies a (ours, comparator) type-string mismatch into a bucket by\n30\t// observable shape only — it can't see root cause, just the diff. Root\n31\t// causes for the recurring buckets are cross-referenced in docs/benchmarks.md\n32\t// against docs/rdt-coverage.md's already-investigated gap list.\n33\t\n34\ttype TypeDiffBucket =\n35\t  | 'cosmetic-formatting'\n36\t  | 'literal-narrowed-vs-widened'\n37\t  | 'union-member-order'\n38\t  | 'optional-undefined-representation'\n39\t  | 'structural-type-difference'\n40\t\n41\tfunction normalizeTypeString(s: string): string {\n42\t  return s.replace(/\\s+/g, ' ').replace(/\"/g, \"'\").trim()\n43\t}\n44\t\n45\tconst WIDENED = new Set(['string', 'number', 'boolean', 'unknown', 'any'])\n46\t\n47\tfunction classifyTypeDiff(oursType: string, otherType: string): TypeDiffBucket {\n48\t  if (normalizeTypeString(oursType) === normalizeTypeString(otherType)) return 'cosmetic-formatting'\n49\t\n50\t  const stripUndefined = (s: string) =>\n51\t    s\n52\t      .split('|')\n53\t      .map((m) => m.trim())\n54\t      .filter((m) => m !== 'undefined')\n55\t      .join(' | ')\n56\t  if (stripUndefined(oursType) === stripUndefined(otherType) && oursType !== otherType) {\n57\t    return 'optional-undefined-representation'\n58\t  }\n59\t\n60\t  const oursMembers = oursType.split('|').map((m) => m.trim())\n61\t  const otherMembers = otherType.split('|').map((m) => m.trim())\n62\t  if (\n63\t    oursMembers.length > 1 &&\n64\t    oursMembers.length === otherMembers.length &&\n65\t    new Set(oursMembers).size === oursMembers.length &&\n66\t    [...oursMembers].toSorted().join('|') === [...otherMembers].toSorted().join('|') &&\n67\t    oursType !== otherType\n68\t  ) {\n69\t    return 'union-member-order'\n70\t  }\n71\t\n72\t  const isLiteralish = (s: string) => /^['\"]/.test(s.trim()) || s.includes('|')\n73\t  if (\n74\t    (WIDENED.has(otherType.trim()) && isLiteralish(oursType)) ||\n75\t    (WIDENED.has(oursType.trim()) && isLiteralish(otherType))\n76\t  ) {\n77\t    return 'literal-narrowed-vs-widened'\n78\t  }\n79\t\n80\t  return 'structural-type-difference'\n81\t}\n82\t\n83\t// ─── Per-pair agreement computation ──────────────────────────────────────\n84\t\n85\tinterface PropDiff {\n86\t  fixture: string\n87\t  component: string\n88\t  prop: string\n89\t  kind: 'type-mismatch' | 'required-mismatch' | 'default-mismatch' | 'missing-in-ours' | 'extra-in-ours'\n90\t  bucket?: TypeDiffBucket\n91\t  ours?: string\n92\t  other?: string\n93\t  htmlInheritanceCovered?: boolean\n94\t}\n95\t\n96\tinterface PairSummary {\n97\t  comparator: 'react-docgen-typescript' | 'react-docgen'\n98\t  componentsCompared: number\n99\t  /** Components where the comparator returned zero props at all — relevant for\n100\t   *  react-docgen specifically, which has weak native support for interface-typed\n101\t   *  (non-PropTypes) TypeScript components and frequently returns nothing. A flat\n102\t   *  per-prop agreement rate is close to meaningless when this is high; the more\n103\t   *  honest number is \"how many real components does each tool find props for at all.\" */\n104\t  componentsWithEmptyComparatorOutput: number\n105\t  propsUnion: number\n106\t  matched: number\n107\t  mismatched: number\n108\t  missingInOurs: number\n109\t  missingButHtmlInheritanceCovered: number\n110\t  extraInOurs: number\n111\t  /** matched / (propsUnion - missingButHtmlInheritanceCovered) — the honest denominator excludes\n112\t   *  props we intentionally surface a different way (curated HTML-attribute inheritance) rather\n113\t   *  than pretending those never existed. */\n114\t  agreementRate: number\n115\t  typeDiffBuckets: Record<TypeDiffBucket, number>\n116\t  diffs: PropDiff[]\n117\t}\n118\t\n119\tfunction comparePair(\n120\t  oursMap: Map<string, ToolResult>,\n121\t  otherMap: Map<string, ToolResult>,\n122\t  comparatorName: 'react-docgen-typescript' | 'react-docgen',\n123\t): PairSummary {\n124\t  const summary: PairSummary = {\n125\t    comparator: comparatorName,\n126\t    componentsCompared: 0,\n127\t    componentsWithEmptyComparatorOutput: 0,\n128\t    propsUnion: 0,\n129\t    matched: 0,\n130\t    mismatched: 0,\n131\t    missingInOurs: 0,\n132\t    missingButHtmlInheritanceCovered: 0,\n133\t    extraInOurs: 0,\n134\t    agreementRate: 0,\n135\t    typeDiffBuckets: {\n136\t      'cosmetic-formatting': 0,\n137\t      'literal-narrowed-vs-widened': 0,\n138\t      'union-member-order': 0,\n139\t      'optional-undefined-representation': 0,\n140\t      'structural-type-difference': 0,\n141\t    },\n142\t    diffs: [],\n143\t  }\n144\t\n145\t  for (const [key, ourResult] of oursMap) {\n146\t    const otherResult = otherMap.get(key)\n147\t    if (!otherResult || ourResult.error || otherResult.error) continue\n148\t\n149\t    const [fixture, component] = [key.split('/').slice(0, -1).join('/'), key.split('/').at(-1) ?? key]\n150\t    const ourComp = Object.values(ourResult.output)[0]\n151\t    const otherComp = Object.values(otherResult.output)[0]\n152\t    if (!ourComp || !otherComp) continue\n153\t\n154\t    summary.componentsCompared++\n155\t    if (Object.keys(otherComp.props).length === 0) summary.componentsWithEmptyComparatorOutput++\n156\t    const notableInherited = new Set(ourResult.notableInheritedNames)\n157\t    const allPropNames = new Set([...Object.keys(ourComp.props), ...Object.keys(otherComp.props)])\n158\t\n159\t    for (const propName of allPropNames) {\n160\t      const op: NormalizedProp | undefined = ourComp.props[propName]\n161\t      const cp: NormalizedProp | undefined = otherComp.props[propName]\n162\t\n163\t      if (op && !cp) {\n164\t        summary.propsUnion++\n165\t        summary.extraInOurs++\n166\t        summary.diffs.push({ fixture, component, prop: propName, kind: 'extra-in-ours', ours: op.type })\n167\t        continue\n168\t      }\n169\t      if (!op && cp) {\n170\t        summary.propsUnion++\n171\t        if (notableInherited.has(propName)) {\n172\t          summary.missingButHtmlInheritanceCovered++\n173\t          summary.diffs.push({\n174\t            fixture,\n175\t            component,\n176\t            prop: propName,\n177\t            kind: 'missing-in-ours',\n178\t            other: cp.type,\n179\t            htmlInheritanceCovered: true,\n180\t          })\n181\t        } else {\n182\t          summary.missingInOurs++\n183\t          summary.diffs.push({ fixture, component, prop: propName, kind: 'missing-in-ours', other: cp.type })\n184\t        }\n185\t        continue\n186\t      }\n187\t      if (!op || !cp) continue // unreachable, both branches above cover the single-sided cases\n188\t\n189\t      summary.propsUnion++\n190\t      if (op.required !== cp.required) {\n191\t        summary.mismatched++\n192\t        summary.diffs.push({\n193\t          fixture,\n194\t          component,\n195\t          prop: propName,\n196\t          kind: 'required-mismatch',\n197\t          ours: String(op.required),\n198\t          other: String(cp.required),\n199\t        })\n200\t      } else if (op.type !== cp.type) {\n201\t        const bucket = classifyTypeDiff(op.type, cp.type)\n202\t        summary.typeDiffBuckets[bucket]++\n203\t        if (bucket === 'cosmetic-formatting') {\n\n... [71 lines truncated] ..."},"type":"attachment","uuid":"1093f5d7-2736-4a95-b023-670d9388e11d","timestamp":"2026-07-25T19:23:26.567Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
