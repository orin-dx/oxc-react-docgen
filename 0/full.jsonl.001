{"parentUuid":"03d02754-986f-4b45-981e-6e44ec2cad55","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TgeDYEpKkALodPmqQYjeRJ","type":"tool_result","content":"1\tuse std::sync::atomic::{AtomicU64, Ordering};\n2\tuse std::sync::{Arc, LazyLock};\n3\t\n4\tuse camino::Utf8Path;\n5\tuse dashmap::DashMap;\n6\tuse napi_derive::napi;\n7\t\n8\tuse oxc_react_docgen_core::pipeline::{\n9\t    extraction_output_to_json, incremental_update_to_json, PipelineOptions, WatchSession,\n10\t};\n11\t\n12\t// ─── Session store ────────────────────────────────────────────────────────────\n13\t\n14\tstatic SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>> = LazyLock::new(DashMap::new);\n15\tstatic NEXT_SESSION_ID: AtomicU64 = AtomicU64::new(0);\n16\t\n17\tfn next_session_id() -> u32 {\n18\t    let pid = std::process::id() as u64;\n19\t    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\n20\t    // Combine pid (upper 16 bits) with counter (lower 16 bits) into u32.\n21\t    // This avoids collisions across concurrent Vite dev server instances.\n22\t    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\n23\t}\n24\t\n25\t// ─── JsExtractOptions ─────────────────────────────────────────────────────────\n26\t\n27\t/// Options passed from TypeScript — flat struct for easy NAPI marshalling.\n28\t#[napi(object)]\n29\tpub struct JsExtractOptions {\n30\t    pub src_dirs: Vec<String>,\n31\t    pub exclude: Option<Vec<String>>,\n32\t    #[napi(ts_type = \"'react18' | 'react19'\")]\n33\t    pub react_version: Option<String>,\n34\t    pub cross_package: Option<bool>,\n35\t    pub pandacss_outdir: Option<String>,\n36\t    pub variant_functions: Option<Vec<String>>,\n37\t    #[napi(ts_type = \"'curated' | 'full' | 'none'\")]\n38\t    pub html_attributes: Option<String>,\n39\t    // Fields from architectural review:\n40\t    pub tsconfig_path: Option<String>,\n41\t    pub extra_builtins: Option<Vec<String>>,\n42\t    pub vanilla_extract: Option<bool>,\n43\t    pub cache_dir: Option<String>,\n44\t    pub resolve_complex_types: Option<bool>,\n45\t    // Complex fields accepted as JSON strings to avoid napi object complexity:\n46\t    /// JSON: Record<string, string[]>\n47\t    pub extra_paths_json: Option<String>,\n48\t    /// JSON: Record<string, {kind: ...}>\n49\t    pub known_type_overrides_json: Option<String>,\n50\t}\n51\t\n52\t// ─── TryFrom<JsExtractOptions> for PipelineOptions ────────────────────────────\n53\t\n54\timpl TryFrom<JsExtractOptions> for PipelineOptions {\n55\t    /// Names the bad `reactVersion` value — a typo (or a caller bypassing the\n56\t    /// `'react18' | 'react19'` TS type, e.g. via `as any`) must not silently\n57\t    /// fall back to react19 (crates/core/CLAUDE.md non-negotiable #6).\n58\t    type Error = String;\n59\t\n60\t    fn try_from(js: JsExtractOptions) -> Result<Self, Self::Error> {\n61\t        use compact_str::CompactString;\n62\t\n63\t        let extra_builtins: rustc_hash::FxHashSet<CompactString> =\n64\t            js.extra_builtins.unwrap_or_default().into_iter().map(CompactString::from).collect();\n65\t\n66\t        let extra_paths: rustc_hash::FxHashMap<String, Vec<camino::Utf8PathBuf>> = js\n67\t            .extra_paths_json\n68\t            .and_then(|s| serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&s).ok())\n69\t            .map(|map| {\n70\t                map.into_iter()\n71\t                    .filter_map(|(k, v)| {\n72\t                        let paths: Vec<camino::Utf8PathBuf> =\n73\t                            v.as_array()?.iter().filter_map(|p| p.as_str()).map(camino::Utf8PathBuf::from).collect();\n74\t                        Some((k, paths))\n75\t                    })\n76\t                    .collect()\n77\t            })\n78\t            .unwrap_or_default();\n79\t\n80\t        let known_type_overrides: rustc_hash::FxHashMap<String, oxc_react_docgen_core::pipeline::KnownTypeOverride> =\n81\t            js.known_type_overrides_json.and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default();\n82\t\n83\t        let react_version = match js.react_version.as_deref() {\n84\t            Some(v) => oxc_react_docgen_core::react_types::parse_react_version(v)\n85\t                .map_err(|bad| format!(\"reactVersion is '{bad}', expected \\\"react18\\\" or \\\"react19\\\"\"))?,\n86\t            None => oxc_react_docgen_core::react_types::REACT_19,\n87\t        };\n88\t\n89\t        Ok(PipelineOptions {\n90\t            src_dirs: js.src_dirs.into_iter().map(Into::into).collect(),\n91\t            exclude_patterns: js.exclude.unwrap_or_default(),\n92\t            react_version,\n93\t            cross_package: js.cross_package.unwrap_or(true),\n94\t            pandacss_outdir: js.pandacss_outdir.map(Into::into),\n95\t            variant_functions: js\n96\t                .variant_functions\n97\t                .unwrap_or_else(|| vec![\"cva\".into(), \"tv\".into(), \"defineRecipe\".into(), \"recipe\".into()]),\n98\t            html_attributes: match js.html_attributes.as_deref() {\n99\t                Some(\"full\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Full,\n100\t                Some(\"none\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::None,\n101\t                _ => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Curated,\n102\t            },\n103\t            tsconfig_path: js.tsconfig_path.map(Into::into),\n104\t            extra_paths,\n105\t            known_type_overrides,\n106\t            extra_builtins,\n107\t            vanilla_extract: js.vanilla_extract.unwrap_or(false),\n108\t            cache_dir: js.cache_dir.map(Into::into),\n109\t            resolve_complex_types: js.resolve_complex_types.unwrap_or(false),\n110\t            exclude_prefixes: vec![],\n111\t        })\n112\t    }\n113\t}\n114\t\n115\t// ─── Public NAPI functions ────────────────────────────────────────────────────\n116\t\n117\t/// Cold extraction — returns JSON string of ExtractionOutput.\n118\t/// Use for: build-time extraction, CLI backing, one-off runs.\n119\t#[napi]\n120\tpub async fn extract_all(options: JsExtractOptions) -> napi::Result<String> {\n121\t    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n122\t    tokio::task::spawn_blocking(move || {\n123\t        let output = oxc_react_docgen_core::pipeline::extract(&pipeline_options);\n124\t        extraction_output_to_json(&output).map_err(|e| napi::Error::from_reason(e.to_string()))\n125\t    })\n126\t    .await\n127\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n128\t}\n129\t\n130\t/// Create a persistent watch session. Returns session ID.\n131\t/// Call this in Vite's configResolved hook.\n132\t#[napi]\n133\tpub fn create_session(options: JsExtractOptions) -> napi::Result<u32> {\n134\t    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n135\t    let id = next_session_id();\n136\t    let session = Arc::new(WatchSession::new(pipeline_options));\n137\t    SESSIONS.insert(id, session);\n138\t    Ok(id)\n139\t}\n140\t\n141\t/// Incremental extraction for a single changed file.\n142\t/// Returns JSON string of IncrementalUpdate.\n143\t/// Use for: Vite HMR hotUpdate.\n144\t#[napi]\n145\tpub async fn extract_file_incremental(\n146\t    file_path: String,\n147\t    session_id: u32,\n148\t    options: JsExtractOptions,\n149\t) -> napi::Result<String> {\n150\t    let session = match SESSIONS.get(&session_id) {\n151\t        Some(s) => s.clone(),\n152\t        None => {\n153\t            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n154\t            let s = Arc::new(WatchSession::new(pipeline_options));\n155\t            SESSIONS.insert(session_id, s.clone());\n156\t            s\n157\t        }\n158\t    };\n159\t\n160\t    tokio::task::spawn_blocking(move || {\n161\t        let path = Utf8Path::new(&file_path);\n162\t        let update = session.update_file(path);\n163\t        incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n164\t    })\n165\t    .await\n166\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n167\t}\n168\t\n169\t/// Initialize a watch session with a full cold extraction.\n170\t/// Returns JSON string of ExtractionOutput.\n171\t/// Call this after create_session(), in configureServer.\n172\t#[napi]\n173\tpub async fn initialize_session(session_id: u32, options: JsExtractOptions) -> napi::Result<String> {\n174\t    let session = match SESSIONS.get(&session_id) {\n175\t        Some(s) => s.clone(),\n176\t        None => {\n177\t            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n178\t            let s = Arc::new(WatchSession::new(pipeline_options));\n179\t            SESSIONS.insert(session_id, s.clone());\n180\t            s\n181\t        }\n182\t    };\n183\t    tokio::task::spawn_blocking(move || {\n184\t        let output = session.initialize();\n185\t        oxc_react_docgen_core::pipeline::extraction_output_to_json(&output)\n186\t            .map_err(|e| napi::Error::from_reason(e.to_string()))\n187\t    })\n188\t    .await\n189\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n190\t}\n191\t\n192\t/// Release session state. Call in Vite's buildEnd hook.\n193\t#[napi]\n194\tpub fn close_session(session_id: u32) {\n195\t    SESSIONS.remove(&session_id);\n196\t}\n197\t"}]},"uuid":"f381ab4a-f971-4184-a9f5-4074e488e784","timestamp":"2026-07-22T21:07:33.062Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/binding/src/lib.rs","content":"use std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, LazyLock};\n\nuse camino::Utf8Path;\nuse dashmap::DashMap;\nuse napi_derive::napi;\n\nuse oxc_react_docgen_core::pipeline::{\n    extraction_output_to_json, incremental_update_to_json, PipelineOptions, WatchSession,\n};\n\n// ─── Session store ────────────────────────────────────────────────────────────\n\nstatic SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>> = LazyLock::new(DashMap::new);\nstatic NEXT_SESSION_ID: AtomicU64 = AtomicU64::new(0);\n\nfn next_session_id() -> u32 {\n    let pid = std::process::id() as u64;\n    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\n    // Combine pid (upper 16 bits) with counter (lower 16 bits) into u32.\n    // This avoids collisions across concurrent Vite dev server instances.\n    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\n}\n\n// ─── JsExtractOptions ─────────────────────────────────────────────────────────\n\n/// Options passed from TypeScript — flat struct for easy NAPI marshalling.\n#[napi(object)]\npub struct JsExtractOptions {\n    pub src_dirs: Vec<String>,\n    pub exclude: Option<Vec<String>>,\n    #[napi(ts_type = \"'react18' | 'react19'\")]\n    pub react_version: Option<String>,\n    pub cross_package: Option<bool>,\n    pub pandacss_outdir: Option<String>,\n    pub variant_functions: Option<Vec<String>>,\n    #[napi(ts_type = \"'curated' | 'full' | 'none'\")]\n    pub html_attributes: Option<String>,\n    // Fields from architectural review:\n    pub tsconfig_path: Option<String>,\n    pub extra_builtins: Option<Vec<String>>,\n    pub vanilla_extract: Option<bool>,\n    pub cache_dir: Option<String>,\n    pub resolve_complex_types: Option<bool>,\n    // Complex fields accepted as JSON strings to avoid napi object complexity:\n    /// JSON: Record<string, string[]>\n    pub extra_paths_json: Option<String>,\n    /// JSON: Record<string, {kind: ...}>\n    pub known_type_overrides_json: Option<String>,\n}\n\n// ─── TryFrom<JsExtractOptions> for PipelineOptions ────────────────────────────\n\nimpl TryFrom<JsExtractOptions> for PipelineOptions {\n    /// Names the bad `reactVersion` value — a typo (or a caller bypassing the\n    /// `'react18' | 'react19'` TS type, e.g. via `as any`) must not silently\n    /// fall back to react19 (crates/core/CLAUDE.md non-negotiable #6).\n    type Error = String;\n\n    fn try_from(js: JsExtractOptions) -> Result<Self, Self::Error> {\n        use compact_str::CompactString;\n\n        let extra_builtins: rustc_hash::FxHashSet<CompactString> =\n            js.extra_builtins.unwrap_or_default().into_iter().map(CompactString::from).collect();\n\n        let extra_paths: rustc_hash::FxHashMap<String, Vec<camino::Utf8PathBuf>> = js\n            .extra_paths_json\n            .and_then(|s| serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&s).ok())\n            .map(|map| {\n                map.into_iter()\n                    .filter_map(|(k, v)| {\n                        let paths: Vec<camino::Utf8PathBuf> =\n                            v.as_array()?.iter().filter_map(|p| p.as_str()).map(camino::Utf8PathBuf::from).collect();\n                        Some((k, paths))\n                    })\n                    .collect()\n            })\n            .unwrap_or_default();\n\n        let known_type_overrides: rustc_hash::FxHashMap<String, oxc_react_docgen_core::pipeline::KnownTypeOverride> =\n            js.known_type_overrides_json.and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default();\n\n        let react_version = match js.react_version.as_deref() {\n            Some(v) => oxc_react_docgen_core::react_types::parse_react_version(v)\n                .map_err(|bad| format!(\"reactVersion is '{bad}', expected \\\"react18\\\" or \\\"react19\\\"\"))?,\n            None => oxc_react_docgen_core::react_types::REACT_19,\n        };\n\n        Ok(PipelineOptions {\n            src_dirs: js.src_dirs.into_iter().map(Into::into).collect(),\n            exclude_patterns: js.exclude.unwrap_or_default(),\n            react_version,\n            cross_package: js.cross_package.unwrap_or(true),\n            pandacss_outdir: js.pandacss_outdir.map(Into::into),\n            variant_functions: js\n                .variant_functions\n                .unwrap_or_else(|| vec![\"cva\".into(), \"tv\".into(), \"defineRecipe\".into(), \"recipe\".into()]),\n            html_attributes: match js.html_attributes.as_deref() {\n                Some(\"full\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Full,\n                Some(\"none\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::None,\n                _ => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Curated,\n            },\n            tsconfig_path: js.tsconfig_path.map(Into::into),\n            extra_paths,\n            known_type_overrides,\n            extra_builtins,\n            vanilla_extract: js.vanilla_extract.unwrap_or(false),\n            cache_dir: js.cache_dir.map(Into::into),\n            resolve_complex_types: js.resolve_complex_types.unwrap_or(false),\n            exclude_prefixes: vec![],\n        })\n    }\n}\n\n// ─── Public NAPI functions ────────────────────────────────────────────────────\n\n/// Cold extraction — returns JSON string of ExtractionOutput.\n/// Use for: build-time extraction, CLI backing, one-off runs.\n#[napi]\npub async fn extract_all(options: JsExtractOptions) -> napi::Result<String> {\n    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n    tokio::task::spawn_blocking(move || {\n        let output = oxc_react_docgen_core::pipeline::extract(&pipeline_options);\n        extraction_output_to_json(&output).map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n}\n\n/// Create a persistent watch session. Returns session ID.\n/// Call this in Vite's configResolved hook.\n#[napi]\npub fn create_session(options: JsExtractOptions) -> napi::Result<u32> {\n    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n    let id = next_session_id();\n    let session = Arc::new(WatchSession::new(pipeline_options));\n    SESSIONS.insert(id, session);\n    Ok(id)\n}\n\n/// Incremental extraction for a single changed file.\n/// Returns JSON string of IncrementalUpdate.\n/// Use for: Vite HMR hotUpdate.\n#[napi]\npub async fn extract_file_incremental(\n    file_path: String,\n    session_id: u32,\n    options: JsExtractOptions,\n) -> napi::Result<String> {\n    let session = match SESSIONS.get(&session_id) {\n        Some(s) => s.clone(),\n        None => {\n            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n            let s = Arc::new(WatchSession::new(pipeline_options));\n            SESSIONS.insert(session_id, s.clone());\n            s\n        }\n    };\n\n    tokio::task::spawn_blocking(move || {\n        let path = Utf8Path::new(&file_path);\n        let update = session.update_file(path);\n        incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n}\n\n/// Initialize a watch session with a full cold extraction.\n/// Returns JSON string of ExtractionOutput.\n/// Call this after create_session(), in configureServer.\n#[napi]\npub async fn initialize_session(session_id: u32, options: JsExtractOptions) -> napi::Result<String> {\n    let session = match SESSIONS.get(&session_id) {\n        Some(s) => s.clone(),\n        None => {\n            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n            let s = Arc::new(WatchSession::new(pipeline_options));\n            SESSIONS.insert(session_id, s.clone());\n            s\n        }\n    };\n    tokio::task::spawn_blocking(move || {\n        let output = session.initialize();\n        oxc_react_docgen_core::pipeline::extraction_output_to_json(&output)\n            .map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n}\n\n/// Release session state. Call in Vite's buildEnd hook.\n#[napi]\npub fn close_session(session_id: u32) {\n    SESSIONS.remove(&session_id);\n}\n","numLines":197,"startLine":1,"totalLines":197}},"sourceToolAssistantUUID":"03d02754-986f-4b45-981e-6e44ec2cad55","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
