{"parentUuid":"bce222e2-6071-4002-9b88-ceadcb134ba1","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/cli/src/config.rs","snippet":"1\tuse miette::{IntoDiagnostic, Result, WrapErr};\n2\tuse oxc_react_docgen_core::pipeline::{HtmlAttributeMode, PipelineOptions};\n3\tuse serde::Deserialize;\n4\t\n5\t/// The JSON-facing shape of `docgen.config.ts`'s default export.\n6\t///\n7\t/// A deliberate subset of `PipelineOptions` — everything except the fields that\n8\t/// need complex map/object values (`extraPaths`, `knownTypeOverrides`), which\n9\t/// aren't supported via config file yet. `deny_unknown_fields` means a config\n10\t/// using one of those (or a typo'd key) gets a clear error naming the field, not\n11\t/// a silently-ignored setting — same reasoning as this module's existing \"found\n12\t/// but unsupported\" hard error above.\n13\t#[derive(Debug, Default, Deserialize)]\n14\t#[serde(rename_all = \"camelCase\", deny_unknown_fields)]\n15\tstruct DocgenConfigSchema {\n16\t    src_dirs: Option<Vec<String>>,\n17\t    exclude_patterns: Option<Vec<String>>,\n18\t    exclude_prefixes: Option<Vec<String>>,\n19\t    react_version: Option<String>,\n20\t    cross_package: Option<bool>,\n21\t    pandacss_outdir: Option<String>,\n22\t    variant_functions: Option<Vec<String>>,\n23\t    html_attributes: Option<String>,\n24\t    tsconfig_path: Option<String>,\n25\t    vanilla_extract: Option<bool>,\n26\t    cache_dir: Option<String>,\n27\t    extra_builtins: Option<Vec<String>>,\n28\t}\n29\t\n30\timpl DocgenConfigSchema {\n31\t    /// `Err` names the bad `reactVersion` value — a typo must not silently\n32\t    /// fall back to react19 (non-negotiable #6: never fail silently).\n33\t    fn into_pipeline_options(self) -> Result<PipelineOptions, String> {\n34\t        let mut opts = PipelineOptions::default();\n35\t        if let Some(dirs) = self.src_dirs {\n36\t            opts.src_dirs = dirs.into_iter().map(Into::into).collect();\n37\t        }\n38\t        if let Some(patterns) = self.exclude_patterns {\n39\t            opts.exclude_patterns = patterns;\n40\t        }\n41\t        if let Some(prefixes) = self.exclude_prefixes {\n42\t            opts.exclude_prefixes = prefixes;\n43\t        }\n44\t        if let Some(v) = self.react_version.as_deref() {\n45\t            opts.react_version = oxc_react_docgen_core::react_types::parse_react_version(v)\n46\t                .map_err(|bad| format!(\"reactVersion is '{bad}', expected \\\"react18\\\" or \\\"react19\\\"\"))?;\n47\t        }\n48\t        if let Some(cross_package) = self.cross_package {\n49\t            opts.cross_package = cross_package;\n50\t        }\n51\t        if let Some(dir) = self.pandacss_outdir {\n52\t            opts.pandacss_outdir = Some(dir.into());\n53\t        }\n54\t        if let Some(fns) = self.variant_functions {\n55\t            opts.variant_functions = fns;\n56\t        }\n57\t        if let Some(mode) = self.html_attributes.as_deref() {\n58\t            opts.html_attributes = match mode {\n59\t                \"full\" => HtmlAttributeMode::Full,\n60\t                \"none\" => HtmlAttributeMode::None,\n61\t                _ => HtmlAttributeMode::Curated,\n62\t            };\n63\t        }\n64\t        if let Some(path) = self.tsconfig_path {\n65\t            opts.tsconfig_path = Some(path.into());\n66\t        }\n67\t        if let Some(vanilla_extract) = self.vanilla_extract {\n68\t            opts.vanilla_extract = vanilla_extract;\n69\t        }\n70\t        if let Some(dir) = self.cache_dir {\n71\t            opts.cache_dir = Some(dir.into());\n72\t        }\n73\t        if let Some(names) = self.extra_builtins {\n74\t            opts.extra_builtins = names.into_iter().map(Into::into).collect();\n75\t        }\n76\t        Ok(opts)\n77\t    }\n78\t}\n79\t\n80\t/// Find and load docgen.config.ts, walking up from start_dir to workspace root.\n81\t///\n82\t/// Returns `Ok(None)` when no config file exists anywhere between `start_dir` and the\n83\t/// workspace root — callers fall back to [`PipelineOptions::default`]. Returns `Err` when\n84\t/// a config file IS found but can't be honored; see [`try_load_config`].\n85\tpub fn load_config_file(start_dir: &std::path::Path) -> Result<Option<PipelineOptions>> {\n86\t    let mut dir = start_dir;\n87\t    loop {\n88\t        let candidate = dir.join(\"docgen.config.ts\");\n89\t        if candidate.exists() {\n90\t            return try_load_config(&candidate);\n91\t        }\n92\t        // Stop at workspace root signals\n93\t        for signal in &[\"pnpm-workspace.yaml\", \"turbo.json\", \".moon/workspace.yml\"] {\n94\t            if dir.join(signal).exists() {\n95\t                return Ok(None);\n96\t            }\n97\t        }\n98\t        let Some(parent) = dir.parent() else { return Ok(None) };\n99\t        dir = parent;\n100\t    }\n101\t}\n102\t\n103\t/// Execute `docgen.config.ts` at `path` and map its default export onto\n104\t/// [`PipelineOptions`].\n105\t///\n106\t/// A config file that fails to evaluate, or evaluates to something that doesn't\n107\t/// match [`DocgenConfigSchema`] (a typo'd key, wrong value type, or a field this\n108\t/// module doesn't support yet), is a hard error rather than silently falling back\n109\t/// to defaults — crates/core/CLAUDE.md non-negotiable #6: never fail silently. A\n110\t/// config a user explicitly wrote getting quietly ignored is a plausible-looking\n111\t/// but wrong result forever.\n112\tpub fn try_load_config(path: &std::path::Path) -> Result<Option<PipelineOptions>> {\n113\t    use std::io::Write;\n114\t\n115\t    // Pass the config path via environment variable to avoid any path content\n116\t    // being interpreted as JavaScript (command injection via crafted filenames).\n117\t    let script = \"import { pathToFileURL } from 'node:url';\\\n118\t        const p = process.env.__DOCGEN_CONFIG_PATH;\\\n119\t        const m = await import(pathToFileURL(p).href);\\\n120\t        process.stdout.write(JSON.stringify(m.default ?? m));\";\n121\t\n122\t    let mut command = std::process::Command::new(\"node\");\n123\t    command\n124\t        .args([\"--input-type=module\"])\n125\t        .env(\"NODE_OPTIONS\", \"--import=tsx/esm\")\n126\t        .env(\"__DOCGEN_CONFIG_PATH\", path)\n127\t        .stdin(std::process::Stdio::piped())\n128\t        .stdout(std::process::Stdio::piped())\n129\t        .stderr(std::process::Stdio::piped());\n130\t    // Resolve `tsx` (and anything the config file itself imports) relative to the\n131\t    // config file's own directory, not wherever the CLI happened to be invoked\n132\t    // from — matters for `--config ../other-project/docgen.config.ts` pointing\n133\t    // outside the current project, and for a project whose `tsx` devDependency\n134\t    // isn't hoisted to whatever the caller's own cwd happens to be.\n135\t    if let Some(dir) = path.parent() {\n136\t        command.current_dir(dir);\n137\t    }\n138\t    let mut child = command\n139\t        .spawn()\n140\t        .into_diagnostic()\n141\t        .wrap_err(\"Failed to spawn node to evaluate docgen.config.ts — is node installed and on PATH?\")?;\n142\t\n143\t    // Write the script to stdin, then close stdin to signal EOF.\n144\t    let mut stdin =\n145\t        child.stdin.take().ok_or_else(|| miette::miette!(\"failed to open stdin for the node subprocess\"))?;\n146\t    stdin.write_all(script.as_bytes()).into_diagnostic()?;\n147\t    drop(stdin);\n148\t\n149\t    let output = child.wait_with_output().into_diagnostic()?;\n150\t\n151\t    if !output.status.success() {\n152\t        let stderr = String::from_utf8_lossy(&output.stderr);\n153\t        return Err(miette::miette!(\n154\t            help = \"Check docgen.config.ts for syntax errors, or remove it to use defaults.\",\n155\t            \"docgen.config.ts at {} failed to evaluate ({}):\\n{}\",\n156\t            path.display(),\n157\t            output.status,\n158\t            stderr.trim(),\n159\t        ));\n160\t    }\n161\t\n162\t    let schema: DocgenConfigSchema = serde_json::from_slice(&output.stdout).map_err(|e| {\n163\t        miette::miette!(\n164\t            help = \"Check docgen.config.ts's exported fields against the supported schema \\\n165\t                    (srcDirs, excludePatterns, excludePrefixes, reactVersion, crossPackage, \\\n166\t                    pandacssOutdir, variantFunctions, htmlAttributes, tsconfigPath, \\\n167\t                    vanillaExtract, cacheDir, extraBuiltins).\",\n168\t            \"docgen.config.ts at {} doesn't match the expected shape: {}\",\n169\t            path.display(),\n170\t            e,\n171\t        )\n172\t    })?;\n173\t\n174\t    let opts =\n\n... [221 lines truncated] ..."},"type":"attachment","uuid":"cd91f2a4-5421-4608-a9bc-f571aeb82ea1","timestamp":"2026-07-22T20:28:35.481Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
