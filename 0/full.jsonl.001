       );\n776-\n777-        let table = output.components.get(\"Table\").expect(\"Table component not found\");\n778-        assert!(\n779-            table.props.contains_key(\"cellRendererDependencies\"),\n780-            \"expected 'cellRendererDependencies' prop, got: {:?}\",\n781-            table.props.keys().collect::<Vec<_>>()\n782-        );\n783-    }\n784-\n785-    // ── test_native_js_global_resolves_via_real_typescript_lib_files ─────────\n786-    //\n787-    // Regression test for: `Date` (and any other native/DOM ambient global —\n788-    // never imported, so nothing ever had a reason to resolve it) spuriously\n789-    // triggered \"Cannot resolve type 'Date' — it will appear as opaque\",\n790-    // hundreds of times on a real date-picker-shaped fixture. Real TypeScript","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"04be879f-1fb6-4d1e-911b-780355d5c516","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
