, \"Foo\"].into_iter().map(String::from).collect());\n    }\n\n    #[test]","numLines":20,"startLine":305,"totalLines":359}},"sourceToolAssistantUUID":"b4ac6261-719f-4891-9f07-ae503e8052af","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
