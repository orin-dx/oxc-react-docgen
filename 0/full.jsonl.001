{"parentUuid":"5e351b22-1c54-42e2-bed9-46df662c0392","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ox7LZpVVfRP7JqgBPCy9r","type":"tool_result","content":"1\t//! Extraction pipeline — Phase 3b.\n2\t//!\n3\t//! Orchestrates: file discovery → parallel parse → global merge → parallel resolve → output.\n4\t//! Also manages DTS cache and incremental watch-mode state.\n5\t\n6\tuse std::collections::VecDeque;\n7\tuse std::sync::atomic::{AtomicU32, Ordering};\n8\tuse std::sync::Arc;\n9\tuse std::time::Instant;\n10\t\n11\tuse camino::{Utf8Path, Utf8PathBuf};\n12\tuse rayon::prelude::*;\n13\tuse rustc_hash::{FxHashMap, FxHashSet};\n14\tuse serde::{Deserialize, Serialize};\n15\t\n16\tuse crate::cache::DtsCache;\n17\tuse crate::resolver::{resolve_component, ResolutionContext};\n18\tuse crate::types::*;\n19\t\n20\tmod discover;\n21\tpub mod watch;\n22\t\n23\tuse discover::{discover_files, should_skip};\n24\tpub use watch::WatchSession;\n25\t\n26\t// ─── PipelineOptions ─────────────────────────────────────────────────────────\n27\t\n28\t/// User-supplied known type override for custom library patterns.\n29\t#[derive(Debug, Clone, Serialize, Deserialize)]\n30\t#[serde(tag = \"kind\", rename_all = \"camelCase\")]\n31\tpub enum KnownTypeOverride {\n32\t    Opaque { label: Option<String> },\n33\t    Alias { arg_index: usize },\n34\t    Skip,\n35\t}\n36\t\n37\t/// How much of an inherited HTML element's attribute surface to expose.\n38\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n39\t#[serde(rename_all = \"camelCase\")]\n40\tpub enum HtmlAttributeMode {\n41\t    /// ~15-20 curated, commonly-documented attributes per element (onClick,\n42\t    /// disabled, aria-*, etc.) — the default. Matches RDT's shape for consumers\n43\t    /// that filter node_modules-sourced props, just with a smaller, hand-picked set.\n44\t    Curated,\n45\t    /// Actually resolve @types/react's real HTMLAttributes/AriaAttributes/\n46\t    /// DOMAttributes/<Element>HTMLAttributes interface chain, matching RDT's full\n47\t    /// ~250-300 attributes per element.\n48\t    Full,\n49\t    /// Don't synthesize any inherited HTML attributes at all — own props only.\n50\t    None,\n51\t}\n52\t\n53\t/// Configuration for a single extraction run.\n54\t#[derive(Debug, Clone)]\n55\tpub struct PipelineOptions {\n56\t    /// Source directories to scan.\n57\t    pub src_dirs: Vec<Utf8PathBuf>,\n58\t    /// Extra glob-like patterns to exclude (on top of built-in: stories, tests, snapshots).\n59\t    pub exclude_patterns: Vec<String>,\n60\t    /// Component name prefixes to skip.\n61\t    pub exclude_prefixes: Vec<String>,\n62\t    /// React version — default: React 19.\n63\t    pub react_version: crate::react_types::ReactVersion,\n64\t    /// Whether to resolve cross-package types.\n65\t    pub cross_package: bool,\n66\t    /// PandaCSS generated output dir, if applicable.\n67\t    pub pandacss_outdir: Option<Utf8PathBuf>,\n68\t    /// Extra function names to treat as cva-like variant functions.\n69\t    pub variant_functions: Vec<String>,\n70\t    /// How much of an inherited HTML element's attributes to expose.\n71\t    pub html_attributes: HtmlAttributeMode,\n72\t    // ── Fields from architectural review ─────────────────────────────────────\n73\t    /// Path to tsconfig.json (auto-detected if None).\n74\t    pub tsconfig_path: Option<Utf8PathBuf>,\n75\t    /// Monorepo path aliases: package name → list of candidate root dirs.\n76\t    pub extra_paths: FxHashMap<String, Vec<Utf8PathBuf>>,\n77\t    /// User-supplied overrides for specific named types.\n78\t    pub known_type_overrides: FxHashMap<String, KnownTypeOverride>,\n79\t    /// Additional builtin type names beyond the React standard set.\n80\t    pub extra_builtins: FxHashSet<compact_str::CompactString>,"}]},"uuid":"2ad4bff7-669b-43f7-abab-5d417834c3d9","timestamp":"2026-07-22T19:55:01.874Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/pipeline/mod.rs","content":"//! Extraction pipeline — Phase 3b.\n//!\n//! Orchestrates: file discovery → parallel parse → global merge → parallel resolve → output.\n//! Also manages DTS cache and incremental watch-mode state.\n\nuse std::collections::VecDeque;\nuse std::sync::atomic::{AtomicU32, Ordering};\nuse std::sync::Arc;\nuse std::time::Instant;\n\nuse camino::{Utf8Path, Utf8PathBuf};\nuse rayon::prelude::*;\nuse rustc_hash::{FxHashMap, FxHashSet};\nuse serde::{Deserialize, Serialize};\n\nuse crate::cache::DtsCache;\nuse crate::resolver::{resolve_component, ResolutionContext};\nuse crate::types::*;\n\nmod discover;\npub mod watch;\n\nuse discover::{discover_files, should_skip};\npub use watch::WatchSession;\n\n// ─── PipelineOptions ─────────────────────────────────────────────────────────\n\n/// User-supplied known type override for custom library patterns.\n#[derive(Debug, Clone, Serialize, Deserialize)]\n#[serde(tag = \"kind\", rename_all = \"camelCase\")]\npub enum KnownTypeOverride {\n    Opaque { label: Option<String> },\n    Alias { arg_index: usize },\n    Skip,\n}\n\n/// How much of an inherited HTML element's attribute surface to expose.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"camelCase\")]\npub enum HtmlAttributeMode {\n    /// ~15-20 curated, commonly-documented attributes per element (onClick,\n    /// disabled, aria-*, etc.) — the default. Matches RDT's shape for consumers\n    /// that filter node_modules-sourced props, just with a smaller, hand-picked set.\n    Curated,\n    /// Actually resolve @types/react's real HTMLAttributes/AriaAttributes/\n    /// DOMAttributes/<Element>HTMLAttributes interface chain, matching RDT's full\n    /// ~250-300 attributes per element.\n    Full,\n    /// Don't synthesize any inherited HTML attributes at all — own props only.\n    None,\n}\n\n/// Configuration for a single extraction run.\n#[derive(Debug, Clone)]\npub struct PipelineOptions {\n    /// Source directories to scan.\n    pub src_dirs: Vec<Utf8PathBuf>,\n    /// Extra glob-like patterns to exclude (on top of built-in: stories, tests, snapshots).\n    pub exclude_patterns: Vec<String>,\n    /// Component name prefixes to skip.\n    pub exclude_prefixes: Vec<String>,\n    /// React version — default: React 19.\n    pub react_version: crate::react_types::ReactVersion,\n    /// Whether to resolve cross-package types.\n    pub cross_package: bool,\n    /// PandaCSS generated output dir, if applicable.\n    pub pandacss_outdir: Option<Utf8PathBuf>,\n    /// Extra function names to treat as cva-like variant functions.\n    pub variant_functions: Vec<String>,\n    /// How much of an inherited HTML element's attributes to expose.\n    pub html_attributes: HtmlAttributeMode,\n    // ── Fields from architectural review ─────────────────────────────────────\n    /// Path to tsconfig.json (auto-detected if None).\n    pub tsconfig_path: Option<Utf8PathBuf>,\n    /// Monorepo path aliases: package name → list of candidate root dirs.\n    pub extra_paths: FxHashMap<String, Vec<Utf8PathBuf>>,\n    /// User-supplied overrides for specific named types.\n    pub known_type_overrides: FxHashMap<String, KnownTypeOverride>,\n    /// Additional builtin type names beyond the React standard set.\n    pub extra_builtins: FxHashSet<compact_str::CompactString>,","numLines":80,"startLine":1,"totalLines":940}},"sourceToolAssistantUUID":"5e351b22-1c54-42e2-bed9-46df662c0392","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
