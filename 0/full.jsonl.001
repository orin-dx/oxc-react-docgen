{"parentUuid":"85f16b99-41d8-42f9-b6d9-bfa407d81bf8","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01TNjeKRNsXa6ca7QWyJhgB2","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"d83be67f-8b07-459c-989b-529791ef5ca7\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/oxc-react-codegen\\\",\\\"project\\\":\\\"oxc-react-codegen\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":54},"type":"attachment","uuid":"c3f24d51-b0fa-43a3-bb5c-f515914847ba","timestamp":"2026-07-22T20:54:59.093Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"c3f24d51-b0fa-43a3-bb5c-f515914847ba","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/import_map.rs","snippet":"1\t//! Import resolution map — built from `GlobalSourceData`, used read-only during resolution.\n2\t//!\n3\t//! Answers the question: \"in file F, the name N was imported — what specifier and\n4\t//! canonical name does it refer to?\"  Actual path resolution (specifier → absolute\n5\t//! path) is left to the caller via `oxc_resolver`.\n6\t\n7\tuse camino::{Utf8Path, Utf8PathBuf};\n8\tuse compact_str::CompactString;\n9\tuse rustc_hash::FxHashMap;\n10\t\n11\tuse crate::types::{GlobalSourceData, LexedExport};\n12\t\n13\t// ─── Public Types ─────────────────────────────────────────────────────────────\n14\t\n15\t/// Where an imported name comes from, as written in the source.\n16\t#[derive(Debug, Clone)]\n17\tpub struct ImportRef {\n18\t    /// The import specifier as written: `\"@radix-ui/react-button\"`, `\"./types\"`, etc.\n19\t    pub specifier: String,\n20\t    /// The exported name in the source module (original name before `as` rename).\n21\t    pub exported_name: CompactString,\n22\t    /// `true` for `import type { ... }` bindings.\n23\t    #[allow(dead_code)]\n24\t    pub is_type_only: bool,\n25\t}\n26\t\n27\t/// Result of walking one step of a re-export chain.\n28\t#[derive(Debug, Clone)]\n29\tpub enum ReExportStep {\n30\t    /// Found a named re-export — caller resolves `source_specifier` to a file and recurses.\n31\t    Named { source_specifier: String, source_name: String },\n32\t    /// Found one or more `export * from \"...\"` entries — caller checks each.\n33\t    Wildcards(Vec<String>),\n34\t}\n35\t\n36\t// ─── ImportResolutionMap ──────────────────────────────────────────────────────\n37\t\n38\t/// Maps `(consuming_file, local_name)` → import reference.\n39\t/// Built once from `GlobalSourceData`, then used read-only during parallel resolution.\n40\tpub struct ImportResolutionMap {\n41\t    /// `file_path` → (`local_name` → specifier + original exported name).\n42\t    /// Nested (rather than a flat `(Utf8PathBuf, CompactString)` key) so lookups can\n43\t    /// borrow `&Utf8Path` directly instead of cloning the whole path per call.\n44\t    /// Note: we store the specifier string, not the resolved file path.\n45\t    /// The resolver calls `oxc_resolver` to turn specifiers into absolute paths.\n46\t    bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>>,\n47\t}\n48\t\n49\timpl ImportResolutionMap {\n50\t    /// Build from a fully-merged `GlobalSourceData`.\n51\t    /// Called once per extraction run, before parallel resolution starts.\n52\t    ///\n53\t    /// No I/O — pure data transformation.\n54\t    pub fn build(global: &GlobalSourceData) -> Self {\n55\t        let mut bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>> = FxHashMap::default();\n56\t\n57\t        for (file_path, import_bindings) in &global.import_map {\n58\t            let per_file = bindings.entry(file_path.clone()).or_default();\n59\t            for binding in import_bindings {\n60\t                per_file.insert(\n61\t                    binding.local_name.clone(),\n62\t                    ImportRef {\n63\t                        specifier: binding.specifier.clone(),\n64\t                        exported_name: binding.exported_name.clone(),\n65\t                        is_type_only: binding.is_type_only,\n66\t                    },\n67\t                );\n68\t            }\n69\t        }\n70\t\n71\t        Self { bindings }\n72\t    }\n73\t\n74\t    /// Given a file and a local name used in that file, return where it was imported from.\n75\t    ///\n76\t    /// Returns `None` if the name is locally defined (not imported).\n77\t    pub fn find_import(&self, file: &Utf8Path, local_name: &str) -> Option<&ImportRef> {\n78\t        self.bindings.get(file)?.get(local_name)\n79\t    }\n80\t\n81\t    /// Walk one step of the re-export chain for `barrel_file`.\n82\t    ///\n83\t    /// - If a `ReExportNamed` entry matches `exported_name`, returns `Named { .. }`.\n84\t    /// - If no named match is found but there are `ReExportAll` entries, returns `Wildcards(..)`.\n85\t    /// - Returns `None` if the barrel file has no relevant re-exports.\n86\t    pub fn resolve_reexport_chain(\n87\t        &self,\n88\t        barrel_file: &Utf8Path,\n89\t        exported_name: &str,\n90\t        global: &GlobalSourceData,\n91\t    ) -> Option<ReExportStep> {\n92\t        let exports = global.re_export_map.get(barrel_file)?;\n93\t\n94\t        let mut wildcard_specifiers: Vec<String> = Vec::new();\n95\t\n96\t        for export in exports {\n97\t            match export {\n98\t                LexedExport::ReExportNamed { local_name, source_name, source_specifier, .. } => {\n99\t                    if local_name == exported_name {\n100\t                        return Some(ReExportStep::Named {\n101\t                            source_specifier: source_specifier.clone(),\n102\t                            source_name: source_name.clone(),\n103\t                        });\n104\t                    }\n105\t                }\n106\t                LexedExport::ReExportAll { source_specifier, .. } => {\n107\t                    wildcard_specifiers.push(source_specifier.clone());\n108\t                }\n109\t                // Namespace re-exports and local declarations are not relevant here.\n110\t                _ => {}\n111\t            }\n112\t        }\n113\t\n114\t        if !wildcard_specifiers.is_empty() {\n115\t            Some(ReExportStep::Wildcards(wildcard_specifiers))\n116\t        } else {\n117\t            None\n118\t        }\n119\t    }\n120\t}\n121\t\n122\t// ─── Tests ────────────────────────────────────────────────────────────────────\n123\t\n124\t#[cfg(test)]\n125\tmod tests {\n126\t    use super::*;\n127\t    use crate::types::{GlobalSourceData, ImportBinding, LexedExport};\n128\t    use camino::Utf8PathBuf;\n129\t    use compact_str::CompactString;\n130\t\n131\t    /// Convenience builder for `GlobalSourceData`.\n132\t    fn make_global(\n133\t        imports: Vec<(Utf8PathBuf, Vec<ImportBinding>)>,\n134\t        exports: Vec<(Utf8PathBuf, Vec<LexedExport>)>,\n135\t    ) -> GlobalSourceData {\n136\t        let mut g = GlobalSourceData::default();\n137\t        for (path, bindings) in imports {\n138\t            g.import_map.insert(path, bindings);\n139\t        }\n140\t        for (path, exps) in exports {\n141\t            g.re_export_map.insert(path, exps);\n142\t        }\n143\t        g\n144\t    }\n145\t\n146\t    fn make_binding(local_name: &str, exported_name: &str, specifier: &str, is_type_only: bool) -> ImportBinding {\n147\t        ImportBinding {\n148\t            local_name: CompactString::from(local_name),\n149\t            exported_name: CompactString::from(exported_name),\n150\t            specifier: specifier.to_owned(),\n151\t            is_type_only,\n152\t        }\n153\t    }\n154\t\n155\t    #[test]\n156\t    fn test_named_import_lookup() {\n157\t        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n158\t        let global = make_global(\n159\t            vec![(file.clone(), vec![make_binding(\"ButtonProps\", \"ButtonProps\", \"@radix-ui/react-button\", false)])],\n160\t            vec![],\n161\t        );\n162\t\n163\t        let map = ImportResolutionMap::build(&global);\n164\t\n165\t        let result = map.find_import(&file, \"ButtonProps\").expect(\"should find import\");\n166\t        assert_eq!(result.specifier, \"@radix-ui/react-button\");\n167\t        assert_eq!(result.exported_name.as_str(), \"ButtonProps\");\n168\t        assert!(!result.is_type_only);\n169\t    }\n170\t\n171\t    #[test]\n172\t    fn test_named_import_not_found() {\n173\t        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n174\t        let global = make_global(vec![], vec![]);\n175\t        let map = ImportResolutionMap::build(&global);\n176\t\n177\t        assert!(map.find_import(&file, \"LocalType\").is_none());\n178\t    }\n179\t\n180\t    #[test]\n181\t    fn test_renamed_import() {\n182\t        // import { Button as Btn } from \"@radix-ui/react-button\"\n183\t        let file = Utf8PathBuf::from(\"/project/src/Wrapper.tsx\");\n184\t        let global = make_global(\n185\t            vec![(file.clone(), vec![make_binding(\"Btn\", \"Button\", \"@radix-ui/react-button\", false)])],\n186\t            vec![],\n187\t        );\n188\t\n189\t        let map = ImportResolutionMap::build(&global);\n190\t\n191\t        // Looking up by local alias \"Btn\"\n192\t        let result = map.find_import(&file, \"Btn\").expect(\"should find renamed import\");\n\n... [144 lines truncated] ..."},"type":"attachment","uuid":"f6bda232-14bb-4082-afb9-c58667c28a7f","timestamp":"2026-07-22T20:54:59.115Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
