{"parentUuid":"3760d72e-63f7-4657-b808-c342d3dbc8c4","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdPTpWLCz5tVnXYubN7AV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YR2QobBxMEWJnmbqeR7drP","name":"Read","input":{"file_path":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/chain.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1149,"cache_read_input_tokens":635676,"output_tokens":220,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1149,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":220,"cache_read_input_tokens":635676,"cache_creation_input_tokens":1149,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1149},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdPTpQZgxJCnCY4VGm3ZM","type":"assistant","uuid":"ea72442b-59d3-48ff-85ee-ba1a28374608","timestamp":"2026-07-25T21:11:19.475Z","effort":"medium","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"ea72442b-59d3-48ff-85ee-ba1a28374608","isSidechain":false,"promptId":"03d4cbdd-7029-4e04-9b9b-1c6c4e4aec9b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YR2QobBxMEWJnmbqeR7drP","type":"tool_result","content":"1\t//! Props chain resolution — the recursive core of prop resolution.\n2\t\n3\tuse camino::Utf8Path;\n4\tuse compact_str::CompactString;\n5\t\n6\tuse crate::known::{push_known_opaque_diagnostic, resolve_known, KnownPatternResult};\n7\tuse crate::react_types;\n8\tuse crate::types::*;\n9\t\n10\tuse super::alias::resolve_type_alias_chain;\n11\tuse super::collected::resolve_collected_type;\n12\tuse super::extends::resolve_extends_ref;\n13\tuse super::import::{lookup_interface, lookup_type_alias, resolve_to_canonical};\n14\tuse super::react::resolve_react_types_file;\n15\tuse super::{ResolutionContext, ResolvedChain, MAX_DEPTH};\n16\t\n17\t/// Resolve a named type to a chain of props.\n18\t/// This is the recursive core — handles interfaces, aliases, known patterns, etc.\n19\t#[allow(clippy::too_many_arguments)]\n20\tpub(super) fn resolve_props_chain(\n21\t    type_name: &str,\n22\t    type_args: &[String],\n23\t    consuming_file: &Utf8Path,\n24\t    mapping: &ComponentMapping,\n25\t    ctx: &ResolutionContext,\n26\t    state: &mut ResolveState,\n27\t    depth: u8,\n28\t) -> ResolvedChain {\n29\t    if depth > MAX_DEPTH {\n30\t        state.diagnostics.push(super::max_depth_diagnostic(&format!(\"type '{}'\", type_name), consuming_file));\n31\t        return ResolvedChain::empty_with_compose(type_name.to_owned());\n32\t    }\n33\t\n34\t    // Cycle detection — scoped by file so same type name in different files is OK.\n35\t    // Must include type_args: distinct instantiations of the same generic alias\n36\t    // (e.g. `Partial<RowHeights>` vs `Partial<ColumnWidths>` in the same interface's\n37\t    // extends list) are not the same visit and must not collide on the bare name alone.\n38\t    let visit_key: CompactString = format!(\"{}:{}<{}>\", consuming_file, type_name, type_args.join(\",\")).into();\n39\t    if !state.visited.insert(visit_key) {\n40\t        return ResolvedChain::default();\n41\t    }\n42\t\n43\t    // Strip \"React.\" namespace prefix before all builtin/utility checks.\n44\t    let type_name_bare = type_name.strip_prefix(\"React.\").unwrap_or(type_name);\n45\t\n46\t    // ── Step 0.5: Inline utility type in extends position ─────────────────────\n47\t    // Pick/Omit/Partial/Readonly appearing directly in `extends Pick<T,K>`\n48\t    // have non-empty type_args. Route through alias resolver (same logic as\n49\t    // `type X = Pick<T,K>`) instead of the step-1 silent no-op.\n50\t    if !type_args.is_empty() {\n51\t        let synthetic = match type_name_bare {\n52\t            // Guard: skip if the base type is itself generic (contains '<').\n53\t            // Raw string type_args can't represent nested generics reliably.\n54\t            \"Pick\" if type_args.len() >= 2 && !type_args[0].contains('<') => {\n55\t                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n56\t                Some(CollectedTypeAlias::Pick {\n57\t                    base,\n58\t                    picked_keys: parse_string_union_keys(&type_args[1]),\n59\t                    file_path: consuming_file.to_owned(),\n60\t                })\n61\t            }\n62\t            \"Omit\" if type_args.len() >= 2 && !type_args[0].contains('<') => {\n63\t                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n64\t                Some(CollectedTypeAlias::Omit {\n65\t                    base,\n66\t                    omitted_keys: parse_string_union_keys(&type_args[1]),\n67\t                    omitted_keys_of: None,\n68\t                    file_path: consuming_file.to_owned(),\n69\t                })\n70\t            }\n71\t            \"Partial\" if !type_args.is_empty() && !type_args[0].contains('<') => {\n72\t                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n73\t                Some(CollectedTypeAlias::Partial { base, file_path: consuming_file.to_owned() })\n74\t            }\n75\t            \"Readonly\" if !type_args.is_empty() && !type_args[0].contains('<') => {\n76\t                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n77\t                Some(CollectedTypeAlias::Passthrough { target: base, file_path: consuming_file.to_owned() })\n78\t            }\n79\t            _ => None,\n80\t        };\n81\t        if let Some(alias) = synthetic {\n82\t            return resolve_type_alias_chain(&alias, consuming_file, mapping, ctx, state, depth);\n83\t        }\n84\t    }\n85\t\n86\t    // ── Step 1: TypeScript built-in utility types — silent no-op ─────────────\n87\t    // Not prop providers; suppress false \"unresolvable\" warnings.\n88\t    if super::is_ts_utility_type(type_name_bare) {\n89\t        return ResolvedChain::default();\n90\t    }\n91\t\n92\t    // ── Step 2: Known pattern check (SxProps, VariantProps, ComponentProps…) ─\n93\t    // Run BEFORE is_react_builtin: some builtins (ComponentPropsWithoutRef,\n94\t    // PropsWithChildren, etc.) expand into props via known.rs and must NOT be\n95\t    // short-circuited as terminal types. resolve_known with the bare name handles\n96\t    // both \"ComponentPropsWithoutRef\" and \"React.ComponentPropsWithoutRef\".\n97\t    {\n98\t        let resolved_args: Vec<PropType> = type_args\n99\t            .iter()\n100\t            .map(|a| {\n101\t                let ct = CollectedType::Raw(a.clone());\n102\t                resolve_collected_type(&ct, consuming_file, ctx, state, depth + 1)\n103\t            })\n104\t            .collect();\n105\t\n106\t        if let Some(result) = resolve_known(type_name_bare, &resolved_args, &ctx.global, &ctx.enum_bare_index) {\n107\t            return match result {\n108\t                KnownPatternResult::Props(props) => ResolvedChain { props, ..Default::default() },\n109\t                KnownPatternResult::Type(PropType::HtmlAttributes { element, omitted }) => {\n110\t                    // HtmlAttributes from ComponentPropsWithoutRef<'button'> or\n111\t                    // HTMLChakraProps<'button'> — record as InheritedLayer so\n112\t                    // notable_inherited can be synthesized from the element's attr table.\n113\t                    let layer = InheritedLayer {\n114\t                        type_name: type_name.to_owned(),\n115\t                        file_name: resolve_react_types_file(consuming_file, ctx),\n116\t                        omitted,\n117\t                        html_element: Some(element),\n118\t                        total_props: 0,\n119\t                    };\n120\t                    ResolvedChain { inheritance: vec![layer], ..Default::default() }\n121\t                }\n122\t                KnownPatternResult::Type(pt) => {\n123\t                    if let PropType::Opaque { reason, .. } = &pt {\n124\t                        push_known_opaque_diagnostic(&mut state.diagnostics, reason, type_name_bare, consuming_file);\n125\t                    }\n126\t                    ResolvedChain::empty_with_compose(pt.raw_string())\n127\t                }\n128\t                KnownPatternResult::Alias { name } => {\n129\t                    resolve_props_chain(&name, &[], consuming_file, mapping, ctx, state, depth + 1)\n130\t                }\n131\t            };\n132\t        }\n133\t    }\n134\t\n135\t    // ── Step 2.5: React builtin check (after known patterns) ─────────────────\n136\t    // Terminal React types (ReactNode, Ref, FC, etc.) that survived the known-pattern\n137\t    // check are not prop providers — add to composes and stop.\n138\t    if react_types::is_react_builtin(type_name_bare, &ctx.extra_builtins) {\n139\t        return ResolvedChain::empty_with_compose(type_name.to_owned());\n140\t    }\n141\t\n142\t    // ── Step 3: Resolve import to canonical (file, name) ─────────────────────\n143\t    let (canonical_file, canonical_name) = resolve_to_canonical(type_name, consuming_file, ctx, &mut state.diagnostics)\n144\t        .unwrap_or_else(|| (consuming_file.to_owned(), type_name.to_owned()));\n145\t\n146\t    // ── Step 4: Type alias (Omit, Pick, Partial, Union, etc.) ────────────────\n147\t    if let Some((matched_key, alias)) = lookup_type_alias(&ctx.global, canonical_file.as_str(), &canonical_name) {\n148\t        let alias = alias.clone();\n149\t        // Substitute declared type parameters (`type Assign<T, U> = ...`) with the\n150\t        // call site's concrete `type_args` before resolving the body. No-op for\n151\t        // non-generic aliases (the common case) — see resolver/substitute.rs.\n152\t        let alias = super::substitute::apply_generic_args(alias, &matched_key, type_args, consuming_file, ctx);\n153\t        return resolve_type_alias_chain(&alias, consuming_file, mapping, ctx, state, depth);\n154\t    }\n155\t\n156\t    // ── Step 5: Interface ─────────────────────────────────────────────────────\n157\t    if let Some(iface) = lookup_interface(&ctx.global, canonical_file.as_str(), &canonical_name) {\n158\t        return resolve_interface_chain(iface, type_args, consuming_file, mapping, ctx, state, depth);\n159\t    }\n160\t\n161\t    // ── Step 6: Unresolvable ──────────────────────────────────────────────────\n162\t    // Import resolution may have redirected `type_name` to a different name/file\n163\t    // (re-exports, barrel files) — surface that resolved location when it differs,\n164\t    // since \"Cannot resolve X in file A\" is confusing if X actually lives in file B.\n165\t    let location_note = super::unresolved_location_note(type_name, consuming_file, &canonical_file, &canonical_name);\n166\t    state.diagnostics.push(Diagnostic {\n167\t        severity: DiagnosticSeverity::Warning,\n168\t        message: format!(\"Cannot resolve type '{}' in '{}'{}\", type_name, consuming_file, location_note),\n169\t        file: Some(consuming_file.to_string()),\n170\t        line: None,\n171\t        column: None,\n172\t        help: Some(\n173\t            \"Type may be in an unresolvable cross-package location. Check that the package is installed.\".into(),\n174\t        ),\n175\t        code: DiagnosticCode::UnresolvableImport,\n176\t    });\n177\t    ResolvedChain::empty_with_compose(type_name.to_owned())\n178\t}\n179\t\n180\t/// Resolve an interface to a chain of props.\n181\t#[allow(clippy::too_many_arguments)]\n182\tpub(super) fn resolve_interface_chain(\n183\t    iface: &CollectedInterface,\n184\t    _type_args: &[String],\n185\t    _consuming_file: &Utf8Path,\n186\t    mapping: &ComponentMapping,\n187\t    ctx: &ResolutionContext,\n188\t    state: &mut ResolveState,\n189\t    depth: u8,\n190\t) -> ResolvedChain {\n191\t    let mut chain = ResolvedChain::default();\n192\t\n193\t    // A generic interface's own declared type parameters (`interface Foo<TData>`)\n194\t    // are expected, unexpandable placeholders wherever referenced in its body —\n195\t    // not unresolvable types. Register them so `resolve_named` doesn't warn.\n196\t    if let Some(params) = ctx.global.interface_type_params.get(&iface.scoped_key) {\n197\t        state.in_scope_type_params.extend(params.iter().cloned());\n198\t    }\n199\t\n200\t    // ── Resolve extends first — parent props come before own props ────────────\n201\t    for extends_ref in &iface.extends {\n202\t        let (parent_chain, maybe_layer) =\n203\t            resolve_extends_ref(extends_ref, &iface.file_path, mapping, ctx, state, depth + 1);\n204\t        if let Some(layer) = maybe_layer {\n205\t            chain.inheritance.push(layer);\n206\t        }\n207\t        chain.merge_parent(parent_chain);\n208\t    }\n209\t\n210\t    // ── Resolve own props ────────────────────────────────────────────────────\n211\t    let parent = PropParent { name: iface.name.to_string(), file_name: iface.file_path.to_string() };\n212\t\n213\t    for raw_prop in &iface.props {\n214\t        let prop_type = resolve_collected_type(&raw_prop.collected_type, &iface.file_path, ctx, state, depth);\n215\t\n216\t        // Default value: code default takes precedence over JSDoc @default.\n217\t        let code_default = mapping.param_defaults.get(&raw_prop.name);\n218\t        let jsdoc_default =\n219\t            raw_prop.tags.get(\"default\").or_else(|| raw_prop.tags.get(\"defaultValue\")).map(|s| s.trim());\n220\t\n221\t        let default_value = match (code_default, jsdoc_default) {\n222\t            (Some(code), Some(jsdoc))\n223\t                if code.value.trim_matches('\"').trim_matches('\\'') != jsdoc.trim_matches('\"').trim_matches('\\'') =>\n224\t            {\n225\t                state.diagnostics.push(Diagnostic {\n226\t                    severity: DiagnosticSeverity::Info,\n227\t                    message: format!(\n228\t                        \"JSDoc @default '{}' differs from code default '{}' for prop '{}' — using code value\",\n229\t                        jsdoc, code.value, raw_prop.name\n230\t                    ),\n231\t                    file: Some(iface.file_path.to_string()),\n232\t                    line: None,\n233\t                    column: None,\n234\t                    help: Some(\"Update the JSDoc @default to match the code default.\".into()),\n235\t                    code: DiagnosticCode::JsDocDefaultMismatch,\n236\t                });\n237\t                Some(DefaultValue { value: code.value.clone(), computed: code.computed })\n238\t            }\n239\t            (Some(code), _) => Some(DefaultValue { value: code.value.clone(), computed: code.computed }),\n240\t            (None, Some(jsdoc)) => Some(DefaultValue { value: jsdoc.to_owned(), computed: false }),\n241\t            (None, None) => None,\n242\t        };\n243\t\n244\t        chain.props.push(ParsedProp {\n245\t            name: raw_prop.name.clone(),\n246\t            prop_type,\n247\t            required: raw_prop.required,\n248\t            default_value,\n249\t            description: raw_prop.description.clone(),\n250\t            tags: raw_prop.tags.clone(),\n251\t            parent: Some(parent.clone()),\n252\t            declarations: vec![parent.clone()],\n253\t        });\n254\t    }\n255\t\n256\t    chain\n257\t}\n258\t\n259\t/// Find a discriminant prop — a prop that has a distinct string literal type across all members.\n260\tpub(super) fn find_discriminant_prop(members: &[(&str, Vec<ParsedProp>)]) -> Option<String> {\n261\t    if members.is_empty() {\n262\t        return None;\n263\t    }\n264\t\n265\t    // Collect candidate prop names: appear in all members AND have PropType::StringLiteral in at least one.\n266\t    // Use the intersection of all member prop names as candidates.\n267\t    let mut candidate_names: Option<std::collections::BTreeSet<&str>> = None;\n268\t    for (_, member_props) in members {\n269\t        let names: std::collections::BTreeSet<&str> = member_props.iter().map(|p| p.name.as_str()).collect();\n270\t        candidate_names = Some(match candidate_names {\n271\t            None => names,\n272\t            Some(existing) => existing.intersection(&names).copied().collect(),\n273\t        });\n274\t    }\n275\t    let candidate_names = candidate_names.unwrap_or_default();\n276\t\n277\t    'outer: for candidate in &candidate_names {\n278\t        // Check that this prop has a string literal type in at least one member.\n279\t        let has_literal = members.iter().any(|(_, props)| {\n280\t            props.iter().any(|p| p.name.as_str() == *candidate && matches!(p.prop_type, PropType::StringLiteral(_)))\n281\t        });\n282\t        if !has_literal {\n283\t            continue;\n284\t        }\n285\t\n286\t        let mut literal_values: Vec<&str> = Vec::new();\n287\t        for (_, member_props) in members {\n288\t            let found = member_props.iter().find(|p| p.name.as_str() == *candidate);\n289\t            match found {\n290\t                Some(p) => {\n291\t                    if let PropType::StringLiteral(ref s) = p.prop_type {\n292\t                        if literal_values.contains(&s.as_str()) {\n293\t                            // Not distinct — try next prop.\n294\t                            continue 'outer;\n295\t                        }\n296\t                        literal_values.push(s.as_str());\n297\t                    } else {\n298\t                        continue 'outer; // Not a literal in this member.\n299\t                    }\n300\t                }\n301\t                None => continue 'outer, // Not present in all members.\n302\t            }\n303\t        }\n304\t\n305\t        if literal_values.len() == members.len() {\n306\t            return Some((*candidate).to_owned());\n307\t        }\n308\t    }\n309\t\n310\t    None\n311\t}\n312\t\n313\t/// Parse a TypeScript string union like `'disabled' | 'type' | 'form'` into individual key strings.\n314\tfn parse_string_union_keys(raw: &str) -> Vec<String> {\n315\t    raw.split('|').map(|s| s.trim().trim_matches('\\'').trim_matches('\"').to_owned()).filter(|s| !s.is_empty()).collect()\n316\t}\n317\t"}]},"uuid":"a7b31554-599c-4a05-a032-d5c6f5e588d6","timestamp":"2026-07-25T21:11:19.557Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/chain.rs","content":"//! Props chain resolution — the recursive core of prop resolution.\n\nuse camino::Utf8Path;\nuse compact_str::CompactString;\n\nuse crate::known::{push_known_opaque_diagnostic, resolve_known, KnownPatternResult};\nuse crate::react_types;\nuse crate::types::*;\n\nuse super::alias::resolve_type_alias_chain;\nuse super::collected::resolve_collected_type;\nuse super::extends::resolve_extends_ref;\nuse super::import::{lookup_interface, lookup_type_alias, resolve_to_canonical};\nuse super::react::resolve_react_types_file;\nuse super::{ResolutionContext, ResolvedChain, MAX_DEPTH};\n\n/// Resolve a named type to a chain of props.\n/// This is the recursive core — handles interfaces, aliases, known patterns, etc.\n#[allow(clippy::too_many_arguments)]\npub(super) fn resolve_props_chain(\n    type_name: &str,\n    type_args: &[String],\n    consuming_file: &Utf8Path,\n    mapping: &ComponentMapping,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> ResolvedChain {\n    if depth > MAX_DEPTH {\n        state.diagnostics.push(super::max_depth_diagnostic(&format!(\"type '{}'\", type_name), consuming_file));\n        return ResolvedChain::empty_with_compose(type_name.to_owned());\n    }\n\n    // Cycle detection — scoped by file so same type name in different files is OK.\n    // Must include type_args: distinct instantiations of the same generic alias\n    // (e.g. `Partial<RowHeights>` vs `Partial<ColumnWidths>` in the same interface's\n    // extends list) are not the same visit and must not collide on the bare name alone.\n    let visit_key: CompactString = format!(\"{}:{}<{}>\", consuming_file, type_name, type_args.join(\",\")).into();\n    if !state.visited.insert(visit_key) {\n        return ResolvedChain::default();\n    }\n\n    // Strip \"React.\" namespace prefix before all builtin/utility checks.\n    let type_name_bare = type_name.strip_prefix(\"React.\").unwrap_or(type_name);\n\n    // ── Step 0.5: Inline utility type in extends position ─────────────────────\n    // Pick/Omit/Partial/Readonly appearing directly in `extends Pick<T,K>`\n    // have non-empty type_args. Route through alias resolver (same logic as\n    // `type X = Pick<T,K>`) instead of the step-1 silent no-op.\n    if !type_args.is_empty() {\n        let synthetic = match type_name_bare {\n            // Guard: skip if the base type is itself generic (contains '<').\n            // Raw string type_args can't represent nested generics reliably.\n            \"Pick\" if type_args.len() >= 2 && !type_args[0].contains('<') => {\n                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n                Some(CollectedTypeAlias::Pick {\n                    base,\n                    picked_keys: parse_string_union_keys(&type_args[1]),\n                    file_path: consuming_file.to_owned(),\n                })\n            }\n            \"Omit\" if type_args.len() >= 2 && !type_args[0].contains('<') => {\n                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n                Some(CollectedTypeAlias::Omit {\n                    base,\n                    omitted_keys: parse_string_union_keys(&type_args[1]),\n                    omitted_keys_of: None,\n                    file_path: consuming_file.to_owned(),\n                })\n            }\n            \"Partial\" if !type_args.is_empty() && !type_args[0].contains('<') => {\n                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n                Some(CollectedTypeAlias::Partial { base, file_path: consuming_file.to_owned() })\n            }\n            \"Readonly\" if !type_args.is_empty() && !type_args[0].contains('<') => {\n                let base = CollectedType::Named { name: type_args[0].as_str().into(), args: vec![] };\n                Some(CollectedTypeAlias::Passthrough { target: base, file_path: consuming_file.to_owned() })\n            }\n            _ => None,\n        };\n        if let Some(alias) = synthetic {\n            return resolve_type_alias_chain(&alias, consuming_file, mapping, ctx, state, depth);\n        }\n    }\n\n    // ── Step 1: TypeScript built-in utility types — silent no-op ─────────────\n    // Not prop providers; suppress false \"unresolvable\" warnings.\n    if super::is_ts_utility_type(type_name_bare) {\n        return ResolvedChain::default();\n    }\n\n    // ── Step 2: Known pattern check (SxProps, VariantProps, ComponentProps…) ─\n    // Run BEFORE is_react_builtin: some builtins (ComponentPropsWithoutRef,\n    // PropsWithChildren, etc.) expand into props via known.rs and must NOT be\n    // short-circuited as terminal types. resolve_known with the bare name handles\n    // both \"ComponentPropsWithoutRef\" and \"React.ComponentPropsWithoutRef\".\n    {\n        let resolved_args: Vec<PropType> = type_args\n            .iter()\n            .map(|a| {\n                let ct = CollectedType::Raw(a.clone());\n                resolve_collected_type(&ct, consuming_file, ctx, state, depth + 1)\n            })\n            .collect();\n\n        if let Some(result) = resolve_known(type_name_bare, &resolved_args, &ctx.global, &ctx.enum_bare_index) {\n            return match result {\n                KnownPatternResult::Props(props) => ResolvedChain { props, ..Default::default() },\n                KnownPatternResult::Type(PropType::HtmlAttributes { element, omitted }) => {\n                    // HtmlAttributes from ComponentPropsWithoutRef<'button'> or\n                    // HTMLChakraProps<'button'> — record as InheritedLayer so\n                    // notable_inherited can be synthesized from the element's attr table.\n                    let layer = InheritedLayer {\n                        type_name: type_name.to_owned(),\n                        file_name: resolve_react_types_file(consuming_file, ctx),\n                        omitted,\n                        html_element: Some(element),\n                        total_props: 0,\n                    };\n                    ResolvedChain { inheritance: vec![layer], ..Default::default() }\n                }\n                KnownPatternResult::Type(pt) => {\n                    if let PropType::Opaque { reason, .. } = &pt {\n                        push_known_opaque_diagnostic(&mut state.diagnostics, reason, type_name_bare, consuming_file);\n                    }\n                    ResolvedChain::empty_with_compose(pt.raw_string())\n                }\n                KnownPatternResult::Alias { name } => {\n                    resolve_props_chain(&name, &[], consuming_file, mapping, ctx, state, depth + 1)\n                }\n            };\n        }\n    }\n\n    // ── Step 2.5: React builtin check (after known patterns) ─────────────────\n    // Terminal React types (ReactNode, Ref, FC, etc.) that survived the known-pattern\n    // check are not prop providers — add to composes and stop.\n    if react_types::is_react_builtin(type_name_bare, &ctx.extra_builtins) {\n        return ResolvedChain::empty_with_compose(type_name.to_owned());\n    }\n\n    // ── Step 3: Resolve import to canonical (file, name) ─────────────────────\n    let (canonical_file, canonical_name) = resolve_to_canonical(type_name, consuming_file, ctx, &mut state.diagnostics)\n        .unwrap_or_else(|| (consuming_file.to_owned(), type_name.to_owned()));\n\n    // ── Step 4: Type alias (Omit, Pick, Partial, Union, etc.) ────────────────\n    if let Some((matched_key, alias)) = lookup_type_alias(&ctx.global, canonical_file.as_str(), &canonical_name) {\n        let alias = alias.clone();\n        // Substitute declared type parameters (`type Assign<T, U> = ...`) with the\n        // call site's concrete `type_args` before resolving the body. No-op for\n        // non-generic aliases (the common case) — see resolver/substitute.rs.\n        let alias = super::substitute::apply_generic_args(alias, &matched_key, type_args, consuming_file, ctx);\n        return resolve_type_alias_chain(&alias, consuming_file, mapping, ctx, state, depth);\n    }\n\n    // ── Step 5: Interface ─────────────────────────────────────────────────────\n    if let Some(iface) = lookup_interface(&ctx.global, canonical_file.as_str(), &canonical_name) {\n        return resolve_interface_chain(iface, type_args, consuming_file, mapping, ctx, state, depth);\n    }\n\n    // ── Step 6: Unresolvable ──────────────────────────────────────────────────\n    // Import resolution may have redirected `type_name` to a different name/file\n    // (re-exports, barrel files) — surface that resolved location when it differs,\n    // since \"Cannot resolve X in file A\" is confusing if X actually lives in file B.\n    let location_note = super::unresolved_location_note(type_name, consuming_file, &canonical_file, &canonical_name);\n    state.diagnostics.push(Diagnostic {\n        severity: DiagnosticSeverity::Warning,\n        message: format!(\"Cannot resolve type '{}' in '{}'{}\", type_name, consuming_file, location_note),\n        file: Some(consuming_file.to_string()),\n        line: None,\n        column: None,\n        help: Some(\n            \"Type may be in an unresolvable cross-package location. Check that the package is installed.\".into(),\n        ),\n        code: DiagnosticCode::UnresolvableImport,\n    });\n    ResolvedChain::empty_with_compose(type_name.to_owned())\n}\n\n/// Resolve an interface to a chain of props.\n#[allow(clippy::too_many_arguments)]\npub(super) fn resolve_interface_chain(\n    iface: &CollectedInterface,\n    _type_args: &[String],\n    _consuming_file: &Utf8Path,\n    mapping: &ComponentMapping,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> ResolvedChain {\n    let mut chain = ResolvedChain::default();\n\n    // A generic interface's own declared type parameters (`interface Foo<TData>`)\n    // are expected, unexpandable placeholders wherever referenced in its body —\n    // not unresolvable types. Register them so `resolve_named` doesn't warn.\n    if let Some(params) = ctx.global.interface_type_params.get(&iface.scoped_key) {\n        state.in_scope_type_params.extend(params.iter().cloned());\n    }\n\n    // ── Resolve extends first — parent props come before own props ────────────\n    for extends_ref in &iface.extends {\n        let (parent_chain, maybe_layer) =\n            resolve_extends_ref(extends_ref, &iface.file_path, mapping, ctx, state, depth + 1);\n        if let Some(layer) = maybe_layer {\n            chain.inheritance.push(layer);\n        }\n        chain.merge_parent(parent_chain);\n    }\n\n    // ── Resolve own props ────────────────────────────────────────────────────\n    let parent = PropParent { name: iface.name.to_string(), file_name: iface.file_path.to_string() };\n\n    for raw_prop in &iface.props {\n        let prop_type = resolve_collected_type(&raw_prop.collected_type, &iface.file_path, ctx, state, depth);\n\n        // Default value: code default takes precedence over JSDoc @default.\n        let code_default = mapping.param_defaults.get(&raw_prop.name);\n        let jsdoc_default =\n            raw_prop.tags.get(\"default\").or_else(|| raw_prop.tags.get(\"defaultValue\")).map(|s| s.trim());\n\n        let default_value = match (code_default, jsdoc_default) {\n            (Some(code), Some(jsdoc))\n                if code.value.trim_matches('\"').trim_matches('\\'') != jsdoc.trim_matches('\"').trim_matches('\\'') =>\n            {\n                state.diagnostics.push(Diagnostic {\n                    severity: DiagnosticSeverity::Info,\n                    message: format!(\n                        \"JSDoc @default '{}' differs from code default '{}' for prop '{}' — using code value\",\n                        jsdoc, code.value, raw_prop.name\n                    ),\n                    file: Some(iface.file_path.to_string()),\n                    line: None,\n                    column: None,\n                    help: Some(\"Update the JSDoc @default to match the code default.\".into()),\n                    code: DiagnosticCode::JsDocDefaultMismatch,\n                });\n                Some(DefaultValue { value: code.value.clone(), computed: code.computed })\n            }\n            (Some(code), _) => Some(DefaultValue { value: code.value.clone(), computed: code.computed }),\n            (None, Some(jsdoc)) => Some(DefaultValue { value: jsdoc.to_owned(), computed: false }),\n            (None, None) => None,\n        };\n\n        chain.props.push(ParsedProp {\n            name: raw_prop.name.clone(),\n            prop_type,\n            required: raw_prop.required,\n            default_value,\n            description: raw_prop.description.clone(),\n            tags: raw_prop.tags.clone(),\n            parent: Some(parent.clone()),\n            declarations: vec![parent.clone()],\n        });\n    }\n\n    chain\n}\n\n/// Find a discriminant prop — a prop that has a distinct string literal type across all members.\npub(super) fn find_discriminant_prop(members: &[(&str, Vec<ParsedProp>)]) -> Option<String> {\n    if members.is_empty() {\n        return None;\n    }\n\n    // Collect candidate prop names: appear in all members AND have PropType::StringLiteral in at least one.\n    // Use the intersection of all member prop names as candidates.\n    let mut candidate_names: Option<std::collections::BTreeSet<&str>> = None;\n    for (_, member_props) in members {\n        let names: std::collections::BTreeSet<&str> = member_props.iter().map(|p| p.name.as_str()).collect();\n        candidate_names = Some(match candidate_names {\n            None => names,\n            Some(existing) => existing.intersection(&names).copied().collect(),\n        });\n    }\n    let candidate_names = candidate_names.unwrap_or_default();\n\n    'outer: for candidate in &candidate_names {\n        // Check that this prop has a string literal type in at least one member.\n        let has_literal = members.iter().any(|(_, props)| {\n            props.iter().any(|p| p.name.as_str() == *candidate && matches!(p.prop_type, PropType::StringLiteral(_)))\n        });\n        if !has_literal {\n            continue;\n        }\n\n        let mut literal_values: Vec<&str> = Vec::new();\n        for (_, member_props) in members {\n            let found = member_props.iter().find(|p| p.name.as_str() == *candidate);\n            match found {\n                Some(p) => {\n                    if let PropType::StringLiteral(ref s) = p.prop_type {\n                        if literal_values.contains(&s.as_str()) {\n                            // Not distinct — try next prop.\n                            continue 'outer;\n                        }\n                        literal_values.push(s.as_str());\n                    } else {\n                        continue 'outer; // Not a literal in this member.\n                    }\n                }\n                None => continue 'outer, // Not present in all members.\n            }\n        }\n\n        if literal_values.len() == members.len() {\n            return Some((*candidate).to_owned());\n        }\n    }\n\n    None\n}\n\n/// Parse a TypeScript string union like `'disabled' | 'type' | 'form'` into individual key strings.\nfn parse_string_union_keys(raw: &str) -> Vec<String> {\n    raw.split('|').map(|s| s.trim().trim_matches('\\'').trim_matches('\"').to_owned()).filter(|s| !s.is_empty()).collect()\n}\n","numLines":317,"startLine":1,"totalLines":317}},"sourceToolAssistantUUID":"ea72442b-59d3-48ff-85ee-ba1a28374608","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
