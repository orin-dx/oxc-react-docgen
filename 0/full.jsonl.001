{"parentUuid":"bb64a511-b18a-41d8-832d-3b1fb64bfd29","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01KVqSpCid7U5c1JrX2xVoYL","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"d83be67f-8b07-459c-989b-529791ef5ca7\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/oxc-react-codegen\\\",\\\"project\\\":\\\"oxc-react-codegen\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":61},"type":"attachment","uuid":"73785ff4-4f23-43b2-b145-84ce29005bcd","timestamp":"2026-07-22T19:46:28.253Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
