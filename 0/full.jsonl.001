{"parentUuid":"680d0223-7fdb-4b81-b8b7-10d58fba5a2b","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdHg9toinU136Ne5UW1Cv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Xshp2Rnw5MEaioeizyKmdR","name":"Read","input":{"file_path":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/extractor/interface.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":605,"cache_read_input_tokens":648504,"output_tokens":3200,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":605,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3200,"cache_read_input_tokens":648504,"cache_creation_input_tokens":605,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":605},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdHg9no4pZ2R3E2yTC3EU","type":"assistant","uuid":"1b44ab2c-d703-4b8a-9c13-7fbc6a78a50f","timestamp":"2026-07-22T19:50:00.941Z","effort":"xhigh","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"1b44ab2c-d703-4b8a-9c13-7fbc6a78a50f","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xshp2Rnw5MEaioeizyKmdR","type":"tool_result","content":"1\t//! Interface-adjacent collection: const enums, cva variants, displayName scanning.\n2\t\n3\tuse oxc_ast::ast::*;\n4\tuse rustc_hash::FxHashMap;\n5\t\n6\tuse crate::types::{DefaultSource, EnumEntry, EnumValue, RawDefault};\n7\t\n8\tuse super::SourceDataCollector;\n9\t\n10\timpl<'src> SourceDataCollector<'src> {\n11\t    // ─── `const` enum (as-const objects) collection ──────────────────────────\n12\t\n13\t    pub(super) fn try_collect_const_enum<'a>(&mut self, decl: &VariableDeclarator<'a>) {\n14\t        // Only collect `const X = { ... } as const` patterns\n15\t        let name = match &decl.id {\n16\t            BindingPattern::BindingIdentifier(id) => id.name.as_str().to_owned(),\n17\t            _ => return,\n18\t        };\n19\t\n20\t        let init = match &decl.init {\n21\t            Some(e) => e,\n22\t            None => return,\n23\t        };\n24\t\n25\t        // Handle `{ ... } as const` (TSAsExpression) or `<const>{ ... }` (TSTypeAssertion)\n26\t        let obj_expr = match init {\n27\t            Expression::TSAsExpression(tsa) => &tsa.expression,\n28\t            Expression::TSTypeAssertion(ta) => &ta.expression,\n29\t            _ => return,\n30\t        };\n31\t\n32\t        let obj = match obj_expr {\n33\t            Expression::ObjectExpression(o) => o,\n34\t            _ => return,\n35\t        };\n36\t\n37\t        let entries: Vec<EnumEntry> = obj\n38\t            .properties\n39\t            .iter()\n40\t            .filter_map(|prop| match prop {\n41\t                ObjectPropertyKind::ObjectProperty(op) => {\n42\t                    let key = op.key.static_name()?.to_string();\n43\t                    let value = self.expression_to_enum_value(&op.value)?;\n44\t                    let desc = self.find_jsdoc(op.span.start);\n45\t                    Some(EnumEntry { name: key, value, description: desc })\n46\t                }\n47\t                _ => None,\n48\t            })\n49\t            .collect();\n50\t\n51\t        if !entries.is_empty() {\n52\t            let key = self.scoped_key(&name);\n53\t            self.data.enums.insert(key, entries);\n54\t        }\n55\t    }\n56\t\n57\t    // ─── `const` array (as-const arrays) collection ───────────────────────────\n58\t\n59\t    /// Detect: `const X = [...] as const` — a flat array literal, referenced via\n60\t    /// `(typeof X)[number]` to build a literal union without an explicit `enum`\n61\t    /// (e.g. antd's `type ButtonType = (typeof _ButtonTypes)[number]`). Distinct\n62\t    /// from `try_collect_const_enum` above (object, not array) and stored\n63\t    /// separately in `SourceData::const_arrays` — see that field's doc comment\n64\t    /// for why it isn't folded into `enums`.\n65\t    pub(super) fn try_collect_const_array<'a>(&mut self, decl: &VariableDeclarator<'a>) {\n66\t        let name = match &decl.id {\n67\t            BindingPattern::BindingIdentifier(id) => id.name.as_str().to_owned(),\n68\t            _ => return,\n69\t        };\n70\t\n71\t        let init = match &decl.init {\n72\t            Some(e) => e,\n73\t            None => return,\n74\t        };\n75\t\n76\t        // Handle `[ ... ] as const` (TSAsExpression) or `<const>[ ... ]` (TSTypeAssertion)\n77\t        let arr_expr = match init {\n78\t            Expression::TSAsExpression(tsa) => &tsa.expression,\n79\t            Expression::TSTypeAssertion(ta) => &ta.expression,\n80\t            _ => return,\n81\t        };\n82\t\n83\t        let arr = match arr_expr {\n84\t            Expression::ArrayExpression(a) => a,\n85\t            _ => return,\n86\t        };\n87\t\n88\t        let values: Vec<EnumValue> = arr\n89\t            .elements\n90\t            .iter()\n91\t            .filter_map(|el| el.as_expression())\n92\t            .filter_map(|e| self.expression_to_enum_value(e))\n93\t            .collect();\n94\t\n95\t        if !values.is_empty() {\n96\t            let key = self.scoped_key(&name);\n97\t            self.data.const_arrays.insert(key, values);\n98\t        }\n99\t    }\n100\t\n101\t    /// Detect: `const X = cva(base, { variants: { key: { val: \"...\", ... } } })`\n102\t    /// Store each variant key's values in self.data.enums under the scoped key.\n103\t    pub(super) fn try_collect_cva_call<'a>(&mut self, decl: &VariableDeclarator<'a>, name: &str) {\n104\t        let Some(init) = decl.init.as_ref() else { return };\n105\t        let call = match init {\n106\t            Expression::CallExpression(ce) => ce,\n107\t            _ => return,\n108\t        };\n109\t\n110\t        // Check callee is a known variant function\n111\t        let callee_name = match &call.callee {\n112\t            Expression::Identifier(id) => id.name.as_str().to_owned(),\n113\t            Expression::StaticMemberExpression(m) => m.property.name.as_str().to_owned(),\n114\t            _ => return,\n115\t        };\n116\t\n117\t        if !matches!(callee_name.as_str(), \"cva\" | \"tv\" | \"defineRecipe\" | \"recipe\" | \"defineSlotRecipe\") {\n118\t            return;\n119\t        }\n120\t\n121\t        // cva(baseClasses, { variants }) takes config at index 1; all other callees take it at index 0\n122\t        let arg_index = usize::from(callee_name == \"cva\");\n123\t        let Some(second_arg) = call.arguments.get(arg_index) else { return };\n124\t        let second_expr = match second_arg {\n125\t            Argument::SpreadElement(_) => return,\n126\t            other => match other.as_expression() {\n127\t                Some(e) => e,\n128\t                None => return,\n129\t            },\n130\t        };\n131\t        let obj = match second_expr {\n132\t            Expression::ObjectExpression(o) => o,\n133\t            _ => return,\n134\t        };\n135\t\n136\t        // Find the \"variants\" property\n137\t        let variants_value = obj.properties.iter().find_map(|prop| {\n138\t            if let ObjectPropertyKind::ObjectProperty(p) = prop {\n139\t                if let PropertyKey::StaticIdentifier(key) = &p.key {\n140\t                    if key.name.as_str() == \"variants\" {\n141\t                        return match &p.value {\n142\t                            Expression::ObjectExpression(o) => Some(o),\n143\t                            _ => None,\n144\t                        };\n145\t                    }\n146\t                }\n147\t            }\n148\t            None\n149\t        });\n150\t        let Some(variants_value) = variants_value else { return };\n151\t\n152\t        let scoped_key = self.scoped_key(name);\n153\t        let mut entries: Vec<EnumEntry> = Vec::new();\n154\t\n155\t        for prop in &variants_value.properties {\n156\t            if let ObjectPropertyKind::ObjectProperty(variant_prop) = prop {\n157\t                let variant_key = match &variant_prop.key {\n158\t                    PropertyKey::StaticIdentifier(id) => id.name.as_str().to_owned(),\n159\t                    PropertyKey::StringLiteral(s) => s.value.as_str().to_owned(),\n160\t                    _ => continue,\n161\t                };\n162\t\n163\t                // The value is another object: { default: \"...\", sm: \"...\", ... }\n164\t                let values_obj = match &variant_prop.value {\n165\t                    Expression::ObjectExpression(o) => o,\n166\t                    _ => continue,\n167\t                };\n168\t\n169\t                for value_prop in &values_obj.properties {\n170\t                    if let ObjectPropertyKind::ObjectProperty(vp) = value_prop {\n171\t                        let value_name = match &vp.key {\n172\t                            PropertyKey::StaticIdentifier(id) => id.name.as_str().to_owned(),\n173\t                            PropertyKey::StringLiteral(s) => s.value.as_str().to_owned(),\n174\t                            _ => continue,\n175\t                        };\n176\t\n177\t                        entries.push(EnumEntry {\n178\t                            name: variant_key.clone(),\n179\t                            value: EnumValue::String(value_name),\n180\t                            description: String::new(),\n181\t                        });\n182\t                    }\n183\t                }\n184\t            }\n185\t        }\n186\t\n187\t        if !entries.is_empty() {\n188\t            self.data.enums.insert(scoped_key, entries);\n189\t        }\n190\t    }\n191\t\n192\t    pub(super) fn expression_to_enum_value<'a>(&self, expr: &Expression<'a>) -> Option<EnumValue> {\n193\t        match expr {\n194\t            Expression::StringLiteral(s) => Some(EnumValue::String(s.value.as_str().to_owned())),\n195\t            Expression::NumericLiteral(n) => Some(EnumValue::Number(n.value)),\n196\t            Expression::BooleanLiteral(b) => Some(EnumValue::Bool(b.value)),\n197\t            Expression::UnaryExpression(u) if u.operator == UnaryOperator::UnaryNegation => match &u.argument {\n198\t                Expression::NumericLiteral(n) => Some(EnumValue::Number(-n.value)),\n199\t                _ => None,\n200\t            },\n201\t            _ => None,\n202\t        }\n203\t    }\n204\t\n205\t    // ─── `displayName` scanning ───────────────────────────────────────────────\n206\t\n207\t    /// Scan `Button.displayName = \"Button\"` and update the matching component mapping.\n208\t    pub(super) fn try_scan_display_name<'a>(&mut self, stmt: &ExpressionStatement<'a>) {\n209\t        let assign = match &stmt.expression {\n210\t            Expression::AssignmentExpression(ae) => ae,\n211\t            _ => return,\n212\t        };\n213\t\n214\t        // Left side must be `X.displayName`\n215\t        let (obj_name, prop_name) = match &assign.left {\n216\t            AssignmentTarget::StaticMemberExpression(sme) => {\n217\t                let obj = self.expression_to_ident_name(&sme.object);\n218\t                let prop = sme.property.name.as_str().to_owned();\n219\t                (obj, prop)\n220\t            }\n221\t            _ => return,\n222\t        };\n223\t\n224\t        if prop_name != \"displayName\" {\n225\t            return;\n226\t        }\n227\t\n228\t        // Right side must be a string literal\n229\t        let display_name = match &assign.right {\n230\t            Expression::StringLiteral(s) => s.value.as_str().to_owned(),\n231\t            _ => return,\n232\t        };\n233\t\n234\t        // Update matching component mapping\n235\t        for mapping in &mut self.data.component_mappings {\n236\t            if mapping.component_name == obj_name {\n237\t                mapping.component_name = display_name.clone();\n238\t                return;\n239\t            }\n240\t        }\n241\t    }\n242\t\n243\t    // ─── `defaultProps` scanning ───────────────────────────────────────────────\n244\t\n245\t    /// Scan `Button.defaultProps = { size: 'md' }` and merge into the matching\n246\t    /// component mapping's `param_defaults` — the same field destructured\n247\t    /// defaults (`function Button({ size = 'md' })`) populate, via\n248\t    /// `extract_param_defaults`. Deprecated in React 19 but still shipped in\n249\t    /// real .d.ts/.tsx (MUI, among others).\n250\t    pub(super) fn try_scan_default_props<'a>(&mut self, stmt: &ExpressionStatement<'a>) {\n251\t        let assign = match &stmt.expression {\n252\t            Expression::AssignmentExpression(ae) => ae,\n253\t            _ => return,\n254\t        };\n255\t\n256\t        // Left side must be `X.defaultProps`\n257\t        let (obj_name, prop_name) = match &assign.left {\n258\t            AssignmentTarget::StaticMemberExpression(sme) => {\n259\t                let obj = self.expression_to_ident_name(&sme.object);\n260\t                let prop = sme.property.name.as_str().to_owned();\n261\t                (obj, prop)\n262\t            }\n263\t            _ => return,\n264\t        };\n265\t\n266\t        if prop_name != \"defaultProps\" {\n267\t            return;\n268\t        }\n269\t\n270\t        // Right side must be an object literal\n271\t        let defaults_obj = match &assign.right {\n272\t            Expression::ObjectExpression(o) => o,\n273\t            _ => return,\n274\t        };\n275\t\n276\t        let defaults: FxHashMap<std::string::String, RawDefault> = defaults_obj\n277\t            .properties\n278\t            .iter()\n279\t            .filter_map(|prop| match prop {\n280\t                ObjectPropertyKind::ObjectProperty(op) => {\n281\t                    let key = op.key.static_name()?.to_string();\n282\t                    let raw_default = self.eval_expr_as_default(&op.value, DefaultSource::DefaultProps);\n283\t                    Some((key, raw_default))\n284\t                }\n285\t                _ => None,\n286\t            })\n287\t            .collect();\n288\t\n289\t        if defaults.is_empty() {\n290\t            return;\n291\t        }\n292\t\n293\t        for mapping in &mut self.data.component_mappings {\n294\t            if mapping.component_name == obj_name {\n295\t                mapping.param_defaults.extend(defaults);\n296\t                return;\n297\t            }\n298\t        }\n299\t    }\n300\t}\n301\t"}]},"uuid":"09583284-6f96-4bbd-ae1d-be3a281e4dcc","timestamp":"2026-07-22T19:50:01.031Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/extractor/interface.rs","content":"//! Interface-adjacent collection: const enums, cva variants, displayName scanning.\n\nuse oxc_ast::ast::*;\nuse rustc_hash::FxHashMap;\n\nuse crate::types::{DefaultSource, EnumEntry, EnumValue, RawDefault};\n\nuse super::SourceDataCollector;\n\nimpl<'src> SourceDataCollector<'src> {\n    // ─── `const` enum (as-const objects) collection ──────────────────────────\n\n    pub(super) fn try_collect_const_enum<'a>(&mut self, decl: &VariableDeclarator<'a>) {\n        // Only collect `const X = { ... } as const` patterns\n        let name = match &decl.id {\n            BindingPattern::BindingIdentifier(id) => id.name.as_str().to_owned(),\n            _ => return,\n        };\n\n        let init = match &decl.init {\n            Some(e) => e,\n            None => return,\n        };\n\n        // Handle `{ ... } as const` (TSAsExpression) or `<const>{ ... }` (TSTypeAssertion)\n        let obj_expr = match init {\n            Expression::TSAsExpression(tsa) => &tsa.expression,\n            Expression::TSTypeAssertion(ta) => &ta.expression,\n            _ => return,\n        };\n\n        let obj = match obj_expr {\n            Expression::ObjectExpression(o) => o,\n            _ => return,\n        };\n\n        let entries: Vec<EnumEntry> = obj\n            .properties\n            .iter()\n            .filter_map(|prop| match prop {\n                ObjectPropertyKind::ObjectProperty(op) => {\n                    let key = op.key.static_name()?.to_string();\n                    let value = self.expression_to_enum_value(&op.value)?;\n                    let desc = self.find_jsdoc(op.span.start);\n                    Some(EnumEntry { name: key, value, description: desc })\n                }\n                _ => None,\n            })\n            .collect();\n\n        if !entries.is_empty() {\n            let key = self.scoped_key(&name);\n            self.data.enums.insert(key, entries);\n        }\n    }\n\n    // ─── `const` array (as-const arrays) collection ───────────────────────────\n\n    /// Detect: `const X = [...] as const` — a flat array literal, referenced via\n    /// `(typeof X)[number]` to build a literal union without an explicit `enum`\n    /// (e.g. antd's `type ButtonType = (typeof _ButtonTypes)[number]`). Distinct\n    /// from `try_collect_const_enum` above (object, not array) and stored\n    /// separately in `SourceData::const_arrays` — see that field's doc comment\n    /// for why it isn't folded into `enums`.\n    pub(super) fn try_collect_const_array<'a>(&mut self, decl: &VariableDeclarator<'a>) {\n        let name = match &decl.id {\n            BindingPattern::BindingIdentifier(id) => id.name.as_str().to_owned(),\n            _ => return,\n        };\n\n        let init = match &decl.init {\n            Some(e) => e,\n            None => return,\n        };\n\n        // Handle `[ ... ] as const` (TSAsExpression) or `<const>[ ... ]` (TSTypeAssertion)\n        let arr_expr = match init {\n            Expression::TSAsExpression(tsa) => &tsa.expression,\n            Expression::TSTypeAssertion(ta) => &ta.expression,\n            _ => return,\n        };\n\n        let arr = match arr_expr {\n            Expression::ArrayExpression(a) => a,\n            _ => return,\n        };\n\n        let values: Vec<EnumValue> = arr\n            .elements\n            .iter()\n            .filter_map(|el| el.as_expression())\n            .filter_map(|e| self.expression_to_enum_value(e))\n            .collect();\n\n        if !values.is_empty() {\n            let key = self.scoped_key(&name);\n            self.data.const_arrays.insert(key, values);\n        }\n    }\n\n    /// Detect: `const X = cva(base, { variants: { key: { val: \"...\", ... } } })`\n    /// Store each variant key's values in self.data.enums under the scoped key.\n    pub(super) fn try_collect_cva_call<'a>(&mut self, decl: &VariableDeclarator<'a>, name: &str) {\n        let Some(init) = decl.init.as_ref() else { return };\n        let call = match init {\n            Expression::CallExpression(ce) => ce,\n            _ => return,\n        };\n\n        // Check callee is a known variant function\n        let callee_name = match &call.callee {\n            Expression::Identifier(id) => id.name.as_str().to_owned(),\n            Expression::StaticMemberExpression(m) => m.property.name.as_str().to_owned(),\n            _ => return,\n        };\n\n        if !matches!(callee_name.as_str(), \"cva\" | \"tv\" | \"defineRecipe\" | \"recipe\" | \"defineSlotRecipe\") {\n            return;\n        }\n\n        // cva(baseClasses, { variants }) takes config at index 1; all other callees take it at index 0\n        let arg_index = usize::from(callee_name == \"cva\");\n        let Some(second_arg) = call.arguments.get(arg_index) else { return };\n        let second_expr = match second_arg {\n            Argument::SpreadElement(_) => return,\n            other => match other.as_expression() {\n                Some(e) => e,\n                None => return,\n            },\n        };\n        let obj = match second_expr {\n            Expression::ObjectExpression(o) => o,\n            _ => return,\n        };\n\n        // Find the \"variants\" property\n        let variants_value = obj.properties.iter().find_map(|prop| {\n            if let ObjectPropertyKind::ObjectProperty(p) = prop {\n                if let PropertyKey::StaticIdentifier(key) = &p.key {\n                    if key.name.as_str() == \"variants\" {\n                        return match &p.value {\n                            Expression::ObjectExpression(o) => Some(o),\n                            _ => None,\n                        };\n                    }\n                }\n            }\n            None\n        });\n        let Some(variants_value) = variants_value else { return };\n\n        let scoped_key = self.scoped_key(name);\n        let mut entries: Vec<EnumEntry> = Vec::new();\n\n        for prop in &variants_value.properties {\n            if let ObjectPropertyKind::ObjectProperty(variant_prop) = prop {\n                let variant_key = match &variant_prop.key {\n                    PropertyKey::StaticIdentifier(id) => id.name.as_str().to_owned(),\n                    PropertyKey::StringLiteral(s) => s.value.as_str().to_owned(),\n                    _ => continue,\n                };\n\n                // The value is another object: { default: \"...\", sm: \"...\", ... }\n                let values_obj = match &variant_prop.value {\n                    Expression::ObjectExpression(o) => o,\n                    _ => continue,\n                };\n\n                for value_prop in &values_obj.properties {\n                    if let ObjectPropertyKind::ObjectProperty(vp) = value_prop {\n                        let value_name = match &vp.key {\n                            PropertyKey::StaticIdentifier(id) => id.name.as_str().to_owned(),\n                            PropertyKey::StringLiteral(s) => s.value.as_str().to_owned(),\n                            _ => continue,\n                        };\n\n                        entries.push(EnumEntry {\n                            name: variant_key.clone(),\n                            value: EnumValue::String(value_name),\n                            description: String::new(),\n                        });\n                    }\n                }\n            }\n        }\n\n        if !entries.is_empty() {\n            self.data.enums.insert(scoped_key, entries);\n        }\n    }\n\n    pub(super) fn expression_to_enum_value<'a>(&self, expr: &Expression<'a>) -> Option<EnumValue> {\n        match expr {\n            Expression::StringLiteral(s) => Some(EnumValue::String(s.value.as_str().to_owned())),\n            Expression::NumericLiteral(n) => Some(EnumValue::Number(n.value)),\n            Expression::BooleanLiteral(b) => Some(EnumValue::Bool(b.value)),\n            Expression::UnaryExpression(u) if u.operator == UnaryOperator::UnaryNegation => match &u.argument {\n                Expression::NumericLiteral(n) => Some(EnumValue::Number(-n.value)),\n                _ => None,\n            },\n            _ => None,\n        }\n    }\n\n    // ─── `displayName` scanning ───────────────────────────────────────────────\n\n    /// Scan `Button.displayName = \"Button\"` and update the matching component mapping.\n    pub(super) fn try_scan_display_name<'a>(&mut self, stmt: &ExpressionStatement<'a>) {\n        let assign = match &stmt.expression {\n            Expression::AssignmentExpression(ae) => ae,\n            _ => return,\n        };\n\n        // Left side must be `X.displayName`\n        let (obj_name, prop_name) = match &assign.left {\n            AssignmentTarget::StaticMemberExpression(sme) => {\n                let obj = self.expression_to_ident_name(&sme.object);\n                let prop = sme.property.name.as_str().to_owned();\n                (obj, prop)\n            }\n            _ => return,\n        };\n\n        if prop_name != \"displayName\" {\n            return;\n        }\n\n        // Right side must be a string literal\n        let display_name = match &assign.right {\n            Expression::StringLiteral(s) => s.value.as_str().to_owned(),\n            _ => return,\n        };\n\n        // Update matching component mapping\n        for mapping in &mut self.data.component_mappings {\n            if mapping.component_name == obj_name {\n                mapping.component_name = display_name.clone();\n                return;\n            }\n        }\n    }\n\n    // ─── `defaultProps` scanning ───────────────────────────────────────────────\n\n    /// Scan `Button.defaultProps = { size: 'md' }` and merge into the matching\n    /// component mapping's `param_defaults` — the same field destructured\n    /// defaults (`function Button({ size = 'md' })`) populate, via\n    /// `extract_param_defaults`. Deprecated in React 19 but still shipped in\n    /// real .d.ts/.tsx (MUI, among others).\n    pub(super) fn try_scan_default_props<'a>(&mut self, stmt: &ExpressionStatement<'a>) {\n        let assign = match &stmt.expression {\n            Expression::AssignmentExpression(ae) => ae,\n            _ => return,\n        };\n\n        // Left side must be `X.defaultProps`\n        let (obj_name, prop_name) = match &assign.left {\n            AssignmentTarget::StaticMemberExpression(sme) => {\n                let obj = self.expression_to_ident_name(&sme.object);\n                let prop = sme.property.name.as_str().to_owned();\n                (obj, prop)\n            }\n            _ => return,\n        };\n\n        if prop_name != \"defaultProps\" {\n            return;\n        }\n\n        // Right side must be an object literal\n        let defaults_obj = match &assign.right {\n            Expression::ObjectExpression(o) => o,\n            _ => return,\n        };\n\n        let defaults: FxHashMap<std::string::String, RawDefault> = defaults_obj\n            .properties\n            .iter()\n            .filter_map(|prop| match prop {\n                ObjectPropertyKind::ObjectProperty(op) => {\n                    let key = op.key.static_name()?.to_string();\n                    let raw_default = self.eval_expr_as_default(&op.value, DefaultSource::DefaultProps);\n                    Some((key, raw_default))\n                }\n                _ => None,\n            })\n            .collect();\n\n        if defaults.is_empty() {\n            return;\n        }\n\n        for mapping in &mut self.data.component_mappings {\n            if mapping.component_name == obj_name {\n                mapping.param_defaults.extend(defaults);\n                return;\n            }\n        }\n    }\n}\n","numLines":301,"startLine":1,"totalLines":301}},"sourceToolAssistantUUID":"1b44ab2c-d703-4b8a-9c13-7fbc6a78a50f","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
