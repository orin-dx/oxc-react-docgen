{"parentUuid":"1673ca2c-41a5-4bd2-9cbe-ed7ffb4fa109","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/apps/validate/src/run-ours.ts","snippet":"1\timport { execSync } from 'node:child_process'\n2\timport { existsSync, readdirSync, statSync } from 'node:fs'\n3\timport { resolve } from 'node:path'\n4\timport type { ToolResult, NormalizedOutput } from './types.ts'\n5\t\n6\tconst __dirname = import.meta.dirname\n7\tconst FIXTURES_ROOT = resolve(__dirname, '../../../fixtures')\n8\t// Prefer release build (faster, has all fixes); fall back to debug for dev convenience.\n9\tconst CLI = existsSync(resolve(__dirname, '../../../target/release/oxc-react-docgen'))\n10\t  ? resolve(__dirname, '../../../target/release/oxc-react-docgen')\n11\t  : resolve(__dirname, '../../../target/debug/oxc-react-docgen')\n12\t\n13\t// Find library directories under fixtures/\n14\tfunction discoverLibraries(): string[] {\n15\t  return readdirSync(FIXTURES_ROOT)\n16\t    .filter((d) => statSync(resolve(FIXTURES_ROOT, d)).isDirectory())\n17\t    .toSorted()\n18\t}\n19\t\n20\t// Map our PropType to a human-readable string for comparison\n21\tfunction propTypeToString(pt: any): string {\n22\t  if (!pt || typeof pt !== 'object') return 'unknown'\n23\t  switch (pt.kind) {\n24\t    case 'string': {\n25\t      return 'string'\n26\t    }\n27\t    case 'number': {\n28\t      return 'number'\n29\t    }\n30\t    case 'boolean': {\n31\t      return 'boolean'\n32\t    }\n33\t    case 'null': {\n34\t      return 'null'\n35\t    }\n36\t    case 'undefined': {\n37\t      return 'undefined'\n38\t    }\n39\t    case 'any': {\n40\t      return 'any'\n41\t    }\n42\t    case 'never': {\n43\t      return 'never'\n44\t    }\n45\t    case 'unknown': {\n46\t      return 'unknown'\n47\t    }\n48\t    case 'void': {\n49\t      return 'void'\n50\t    }\n51\t    case 'reactNode': {\n52\t      return 'ReactNode'\n53\t    }\n54\t    case 'cssProperties': {\n55\t      return 'CSSProperties'\n56\t    }\n57\t    case 'elementType': {\n58\t      return 'ElementType'\n59\t    }\n60\t    case 'sxProps': {\n61\t      return 'SxProps'\n62\t    }\n63\t    case 'stringLiteral': {\n64\t      return JSON.stringify(pt.value)\n65\t    }\n66\t    case 'numberLiteral': {\n67\t      return String(pt.value)\n68\t    }\n69\t    case 'boolLiteral': {\n70\t      return String(pt.value)\n71\t    }\n72\t    case 'union': {\n73\t      return (pt.members as any[]).map((pt) => propTypeToString(pt)).join(' | ')\n74\t    }\n75\t    case 'intersection': {\n76\t      return (pt.members as any[]).map((pt) => propTypeToString(pt)).join(' & ')\n77\t    }\n78\t    case 'array': {\n79\t      return `${propTypeToString(pt.element)}[]`\n80\t    }\n81\t    case 'tuple': {\n82\t      return `[${(pt.elements as any[]).map((pt) => propTypeToString(pt)).join(', ')}]`\n83\t    }\n84\t    case 'object': {\n85\t      return '{ ... }'\n86\t    }\n87\t    case 'named': {\n88\t      return pt.args?.length ? `${pt.name}<${pt.args.map((pt) => propTypeToString(pt)).join(', ')}>` : pt.name\n89\t    }\n90\t    case 'eventHandler': {\n91\t      return `(${pt.paramName ?? 'e'}: ${pt.eventType}) => void`\n92\t    }\n93\t    case 'ref': {\n94\t      return pt.element ? `Ref<${pt.element}>` : 'Ref'\n95\t    }\n96\t    case 'htmlAttributes': {\n97\t      return `${pt.element}HTMLAttributes`\n98\t    }\n99\t    case 'literalUnion': {\n100\t      return pt.members.map((m: string) => JSON.stringify(m)).join(' | ')\n101\t    }\n102\t    case 'opaque': {\n103\t      return pt.raw\n104\t    }\n105\t    default: {\n106\t      return JSON.stringify(pt)\n107\t    }\n108\t  }\n109\t}\n110\t\n111\tfunction normalize(output: any): NormalizedOutput {\n112\t  const result: NormalizedOutput = {}\n113\t  for (const [_key, comp] of Object.entries(output.components ?? {})) {\n114\t    const c = comp as any\n115\t    result[c.displayName] = {\n116\t      displayName: c.displayName,\n117\t      description: c.description ?? '',\n118\t      props: Object.fromEntries(\n119\t        Object.entries(c.props ?? {}).map(([propName, prop]: [string, any]) => [\n120\t          propName,\n121\t          {\n122\t            name: propName,\n123\t            required: prop.required ?? false,\n124\t            type: propTypeToString(prop.type),\n125\t            description: prop.description ?? '',\n126\t            defaultValue: prop.defaultValue?.value,\n127\t          },\n128\t        ]),\n129\t      ),\n130\t    }\n131\t  }\n132\t  return result\n133\t}\n134\t\n135\tconst libraries = discoverLibraries()\n136\tconst results: ToolResult[] = []\n137\t\n138\tfor (const lib of libraries) {\n139\t  const libPath = resolve(FIXTURES_ROOT, lib)\n140\t  const start = performance.now()\n141\t  try {\n142\t    const raw = execSync(`${CLI} extract --src ${libPath} --format canonical`, {\n143\t      encoding: 'utf8',\n144\t      stdio: ['pipe', 'pipe', 'pipe'],\n145\t    })\n146\t    // CLI prints a spinner line then JSON — find the JSON start\n147\t    const jsonStart = raw.indexOf('{')\n148\t    const json = jsonStart !== -1 ? raw.slice(jsonStart) : raw\n149\t    const parsed = JSON.parse(json)\n150\t    const durationMs = performance.now() - start\n151\t\n152\t    for (const [_key, comp] of Object.entries(parsed.components ?? {})) {\n153\t      const c = comp as any\n154\t      const inheritedElements = (c.inheritance ?? []).map((l: any) => l.htmlElement).filter(Boolean)\n155\t      const notableInheritedNames = Object.keys(c.notableInherited ?? {})\n156\t      // Key by displayName (not file path) to avoid collision when multiple components share a file.\n157\t      const basename =\n158\t        c.filePath\n159\t          .split('/')\n160\t          .pop()\n161\t          ?.replace(/\\.tsx?$/, '')\n162\t          .replace(/\\.d$/, '') ?? c.displayName\n163\t      results.push({\n164\t        tool: 'oxc-react-docgen',\n165\t        fixture: `${lib}/${basename}/${c.displayName}`,\n166\t        durationMs,\n167\t        output: normalize({ components: { [c.displayName]: c } }),\n168\t        inheritedElements,\n169\t        notableInheritedNames,\n170\t      })\n171\t    }\n172\t  } catch (error: any) {\n173\t    results.push({\n174\t      tool: 'oxc-react-docgen',\n175\t      fixture: lib,\n176\t      durationMs: performance.now() - start,\n177\t      output: {},\n178\t      error: error.stderr ?? error.message,\n179\t    })\n180\t  }\n181\t}\n182\t\n183\tconsole.log(JSON.stringify(results, null, 2))"},"type":"attachment","uuid":"3d5b1dea-da78-4db9-b968-c858945b66f8","timestamp":"2026-07-24T22:25:57.516Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
