{"parentUuid":"7dcf7d06-dd5e-4a59-98c5-738863dbdd36","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/cli/src/commands/check.rs","snippet":"47\t}\n48\t\n49\t#[cfg(test)]\n50\tmod tests {\n51\t    use super::*;\n52\t\n53\t    #[test]\n54\t    fn json_mode_still_returns_the_error_exit_code() {\n55\t        let args = crate::CheckArgs { src: vec![\"/nonexistent/does-not-exist\".into()], strict: false, json: true };\n56\t        let code = cmd_check(args, true, None).expect(\"cmd_check itself should not error\");\n57\t        assert_eq!(code, 2, \"expected exit code 2 for a nonexistent src dir even in --json mode\");\n58\t    }\n59\t}"},"type":"attachment","uuid":"6adb5316-13d8-45e2-b3ee-9d0f84d40c7b","timestamp":"2026-07-22T20:22:04.519Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"6adb5316-13d8-45e2-b3ee-9d0f84d40c7b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/cli/src/commands/extract.rs","snippet":"1\tuse miette::{IntoDiagnostic, Result, WrapErr};\n2\t\n3\tuse crate::config::{build_options, BuildOptionsArgs};\n4\tuse crate::output::{print_diagnostics, print_summary};\n5\t\n6\t/// Returns the process exit code (0 = success, 2 = extraction reported an\n7\t/// error-severity diagnostic) rather than calling `std::process::exit`\n8\t/// directly — keeps the exit decision testable and lets `main()` be the only\n9\t/// place that actually terminates the process.\n10\tpub fn cmd_extract(args: crate::ExtractArgs, quiet: bool, config_path: Option<&str>) -> Result<i32> {\n11\t    use indicatif::{ProgressBar, ProgressStyle};\n12\t\n13\t    let html_attributes = args.html_attributes.map(|m| match m {\n14\t        crate::HtmlAttributeModeArg::Curated => \"curated\",\n15\t        crate::HtmlAttributeModeArg::Full => \"full\",\n16\t        crate::HtmlAttributeModeArg::None => \"none\",\n17\t    });\n18\t    let options = build_options(BuildOptionsArgs {\n19\t        src: &args.src,\n20\t        no_cross_package: args.no_cross_package,\n21\t        react_version: args.react_version.as_deref(),\n22\t        cache_dir: args.cache_dir.as_deref(),\n23\t        html_attributes,\n24\t        config_path,\n25\t        extra_builtins: &args.extra_builtins,\n26\t    })?;\n27\t\n28\t    let pb = if !quiet && !args.json {\n29\t        let pb = ProgressBar::new_spinner();\n30\t        pb.set_style(ProgressStyle::default_spinner().template(\"{spinner:.cyan} {msg}\").into_diagnostic()?);\n31\t        pb.set_message(\"Extracting...\");\n32\t        pb.enable_steady_tick(std::time::Duration::from_millis(80));\n33\t        Some(pb)\n34\t    } else {\n35\t        None\n36\t    };\n37\t\n38\t    let output = oxc_react_docgen_core::pipeline::extract(&options);\n39\t\n40\t    if let Some(pb) = pb {\n41\t        pb.finish_and_clear();\n42\t    }\n43\t\n44\t    // --json ignores --out/--format — see ExtractArgs::json's doc comment.\n45\t    if args.json {\n46\t        println!(\"{}\", serde_json::to_string(&output).into_diagnostic()?);\n47\t    } else {\n48\t        if !quiet {\n49\t            print_summary(&output, quiet);\n50\t            print_diagnostics(&output.diagnostics);\n51\t        }\n52\t\n53\t        let json = match args.format {\n54\t            crate::OutputFormat::Canonical => serde_json::to_string_pretty(&output).into_diagnostic()?,\n55\t            crate::OutputFormat::Rdt => serialize_rdt(&output),\n56\t            crate::OutputFormat::Storybook => serialize_storybook(&output),\n57\t        };\n58\t\n59\t        match args.out {\n60\t            Some(ref path) => std::fs::write(path, &json).into_diagnostic().wrap_err(format!(\"Writing to {path}\"))?,\n61\t            None => println!(\"{json}\"),\n62\t        }\n63\t    }\n64\t\n65\t    // Must run regardless of --json — this is the one thing CI actually\n66\t    // depends on the exit code for.\n67\t    let has_errors = output\n68\t        .diagnostics\n69\t        .iter()\n70\t        .any(|d| matches!(d.severity, oxc_react_docgen_core::types::DiagnosticSeverity::Error));\n71\t\n72\t    Ok(if has_errors { 2 } else { 0 })\n73\t}\n74\t\n75\t/// RDT's type-name convention for literal unions: `{\"name\": \"enum\", \"value\": [...]}`\n76\t/// instead of inlining the literal text into `type.name` as a plain string. Lets\n77\t/// prop-table renderers that pattern-match `type.name === \"enum\"` (a common\n78\t/// Storybook addon integration point) show a `<select>` control for the most\n79\t/// common, most curated props in any design system (variant, size, color…).\n80\tfn rdt_type_json(prop_type: &oxc_react_docgen_core::types::PropType) -> serde_json::Value {\n81\t    use oxc_react_docgen_core::types::PropType;\n82\t\n83\t    if prop_type.is_literal_union() {\n84\t        let values: Vec<serde_json::Value> = match prop_type {\n85\t            PropType::Union(members) => members.iter().map(|m| serde_json::json!({\"value\": m.raw_string()})).collect(),\n86\t            PropType::LiteralUnion { members, .. } => {\n87\t                members.iter().map(|m| serde_json::json!({\"value\": format!(\"\\\"{m}\\\"\")})).collect()\n88\t            }\n89\t            _ => vec![],\n90\t        };\n91\t        return serde_json::json!({ \"name\": \"enum\", \"value\": values });\n92\t    }\n93\t    serde_json::json!({ \"name\": prop_type.raw_string() })\n94\t}\n95\t\n96\tpub fn serialize_rdt(output: &oxc_react_docgen_core::types::ExtractionOutput) -> String {\n97\t    // RDT-compatible shape: flatten to Record<string, ComponentDoc>\n98\t    let mut map = serde_json::Map::new();\n99\t    for (name, entry) in &output.components {\n100\t        let props: serde_json::Map<String, serde_json::Value> = entry\n101\t            .props\n102\t            .iter()\n103\t            .map(|(k, prop)| {\n104\t                let obj = serde_json::json!({\n105\t                    \"name\": prop.name,\n106\t                    \"type\": rdt_type_json(&prop.prop_type),\n107\t                    \"required\": prop.required,\n108\t                    \"defaultValue\": prop.default_value.as_ref().map(|d| serde_json::json!({\"value\": d.value, \"computed\": d.computed})),\n109\t                    \"description\": prop.description,\n110\t                    \"parent\": prop.parent.as_ref().map(|p| serde_json::json!({\"name\": p.name, \"fileName\": p.file_name})),\n111\t                });\n112\t                (k.clone(), obj)\n113\t            })\n114\t            .collect();\n115\t        map.insert(\n116\t            name.clone(),\n117\t            serde_json::json!({\n118\t                \"displayName\": entry.display_name,\n119\t                \"props\": serde_json::Value::Object(props),\n120\t                \"description\": entry.description,\n121\t                \"methods\": [],\n122\t                \"tags\": entry.tags,\n123\t            }),\n124\t        );\n125\t    }\n126\t    serde_json::to_string_pretty(&serde_json::Value::Object(map)).unwrap_or_default()\n127\t}\n128\t\n129\tpub fn serialize_storybook(output: &oxc_react_docgen_core::types::ExtractionOutput) -> String {\n130\t    // Storybook __docgenInfo shape\n131\t    let mut map = serde_json::Map::new();\n132\t    for (name, entry) in &output.components {\n133\t        let props: serde_json::Map<String, serde_json::Value> = entry\n134\t            .props\n135\t            .iter()\n136\t            .map(|(k, prop)| {\n137\t                let obj = serde_json::json!({\n138\t                    \"name\": prop.name,\n139\t                    \"type\": { \"name\": prop.prop_type.raw_string() },\n140\t                    \"required\": prop.required,\n141\t                    \"defaultValue\": prop.default_value.as_ref().map(|d| serde_json::json!({\"value\": d.value})),\n142\t                    \"description\": prop.description,\n143\t                });\n144\t                (k.clone(), obj)\n145\t            })\n146\t            .collect();\n147\t        map.insert(\n148\t            name.clone(),\n149\t            serde_json::json!({\n150\t                \"displayName\": entry.display_name,\n151\t                \"props\": serde_json::Value::Object(props),\n152\t                \"description\": entry.description,\n153\t                \"methods\": [],\n154\t            }),\n155\t        );\n156\t    }\n157\t    serde_json::to_string_pretty(&serde_json::Value::Object(map)).unwrap_or_default()\n158\t}\n159\t\n160\t#[cfg(test)]\n161\tmod tests {\n162\t    use super::*;\n163\t\n164\t    fn args_for(src: &str, json: bool) -> crate::ExtractArgs {\n165\t        crate::ExtractArgs {\n166\t            src: vec![src.to_owned()],\n167\t            out: None,\n168\t            format: crate::OutputFormat::Canonical,\n169\t            no_cross_package: false,\n170\t            react_version: None,\n171\t            cache_dir: None,\n172\t            html_attributes: None,\n173\t            extra_builtins: vec![],\n174\t            json,\n175\t        }\n176\t    }\n177\t\n178\t    #[test]\n179\t    fn json_mode_still_returns_the_error_exit_code() {\n180\t        // Adversarial review finding: --json returned before the error-\n181\t        // diagnostic exit-code check, so `extract --json` always exited 0\n182\t        // even on hard errors — the one signal CI actually depends on.\n183\t        let code = cmd_extract(args_for(\"/nonexistent/does-not-exist\", true), true, None)\n184\t            .expect(\"cmd_extract itself should not error\");\n185\t        assert_eq!(code, 2, \"expected exit code 2 for a nonexistent src dir even in --json mode\");\n186\t    }\n187\t\n188\t    #[test]\n189\t    fn non_json_mode_returns_the_same_error_exit_code() {\n\n... [6 lines truncated] ..."},"type":"attachment","uuid":"317e478c-05e3-4fde-863b-e2c137819328","timestamp":"2026-07-22T20:22:04.520Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
