{"parentUuid":"3cfdfbd3-d953-4881-bb33-63ce25d0c59b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/extractor/component.rs","snippet":"1\t//! Component detection: FC annotation, forwardRef, HOC-wrapped, ForwardRefExoticComponent.\n2\t\n3\tuse std::collections::BTreeMap;\n4\t\n5\tuse oxc_ast::ast::*;\n6\t\n7\tuse crate::types::ComponentMapping;\n8\t\n9\tuse super::{is_pascal_case, SourceDataCollector};\n10\t\n11\t/// Peel any wrapping `as X` casts down to the real expression underneath.\n12\t/// Needed because component libraries commonly cast a forwardRef/HOC call to a\n13\t/// hand-rolled wrapper type instead of relying on `@types/react`'s own generics\n14\t/// (Fluent UI's own source notes this is \"required due to lack of distributive\n15\t/// union to support unions on @types/react\").\n16\tfn unwrap_as_expression<'a, 'b>(expr: &'b Expression<'a>) -> &'b Expression<'a> {\n17\t    let mut expr = expr;\n18\t    while let Expression::TSAsExpression(as_expr) = expr {\n19\t        expr = &as_expr.expression;\n20\t    }\n21\t    expr\n22\t}\n23\t\n24\timpl<'src> SourceDataCollector<'src> {\n25\t    // ─── Component detection helpers ──────────────────────────────────────────\n26\t\n27\t    /// Try to extract a PascalCase name from a VariableDeclarator's binding.\n28\t    pub(super) fn extract_pascal_name<'a>(&self, decl: &VariableDeclarator<'a>) -> Option<String> {\n29\t        match &decl.id {\n30\t            BindingPattern::BindingIdentifier(id) => {\n31\t                let name = id.name.as_str();\n32\t                if is_pascal_case(name) {\n33\t                    Some(name.to_owned())\n34\t                } else {\n35\t                    None\n36\t                }\n37\t            }\n38\t            _ => None,\n39\t        }\n40\t    }\n41\t\n42\t    /// Try to detect: `const Button: FC<ButtonProps> = ({ variant = 'primary' }) => ...`\n43\t    pub(super) fn try_fc_annotation<'a>(\n44\t        &mut self,\n45\t        decl: &VariableDeclarator<'a>,\n46\t        name: &str,\n47\t    ) -> Option<ComponentMapping> {\n48\t        let type_ann = decl.type_annotation.as_ref()?;\n49\t        let init_params = match decl.init.as_ref() {\n50\t            Some(Expression::ArrowFunctionExpression(afe)) => Some(&*afe.params),\n51\t            Some(Expression::FunctionExpression(fe)) => Some(&*fe.params),\n52\t            _ => None,\n53\t        };\n54\t        self.extract_props_from_type_annotation(\n55\t            &type_ann.type_annotation,\n56\t            name,\n57\t            decl.span.start,\n58\t            decl.span.end,\n59\t            init_params,\n60\t        )\n61\t    }\n62\t\n63\t    pub(super) fn extract_props_from_type_annotation<'a>(\n64\t        &mut self,\n65\t        ty: &TSType<'a>,\n66\t        name: &str,\n67\t        span_start: u32,\n68\t        span_end: u32,\n69\t        init_params: Option<&FormalParameters<'a>>,\n70\t    ) -> Option<ComponentMapping> {\n71\t        match ty {\n72\t            TSType::TSTypeReference(tr) => {\n73\t                let type_name = self.extract_type_ref_name(tr);\n74\t                let bare_name = type_name.strip_prefix(\"React.\").unwrap_or(&type_name);\n75\t                if !matches!(\n76\t                    bare_name,\n77\t                    \"FC\" | \"FunctionComponent\"\n78\t                        | \"ComponentType\"\n79\t                        | \"VFC\"\n80\t                        | \"VoidFunctionComponent\"\n81\t                        | \"ForwardRefComponent\"\n82\t                ) {\n83\t                    return None;\n84\t                }\n85\t                let (props_name, type_args) = self.extract_props_arg(&tr.type_arguments)?;\n86\t                let (description, tags) = self.find_jsdoc_with_tags(span_start);\n87\t                Some(ComponentMapping {\n88\t                    component_name: name.to_owned(),\n89\t                    props_type_name: props_name,\n90\t                    props_type_args: type_args,\n91\t                    file_path: self.file_path.clone(),\n92\t                    description,\n93\t                    tags,\n94\t                    span_start,\n95\t                    span_end,\n96\t                    param_defaults: init_params.map(|p| self.extract_param_defaults(p)).unwrap_or_default(),\n97\t                })\n98\t            }\n99\t            TSType::TSParenthesizedType(p) => {\n100\t                self.extract_props_from_type_annotation(&p.type_annotation, name, span_start, span_end, init_params)\n101\t            }\n102\t            _ => None,\n103\t        }\n104\t    }\n105\t\n106\t    /// Try to detect: `const Button = React.forwardRef<HTMLButtonElement, ButtonProps>(...)`\n107\t    pub(super) fn try_forward_ref<'a>(\n108\t        &mut self,\n109\t        decl: &VariableDeclarator<'a>,\n110\t        name: &str,\n111\t    ) -> Option<ComponentMapping> {\n112\t        let init = decl.init.as_ref()?;\n113\t        let call = match unwrap_as_expression(init) {\n114\t            Expression::CallExpression(ce) => ce,\n115\t            _ => return None,\n116\t        };\n117\t        let callee_name = self.extract_callee_name(call)?;\n118\t\n119\t        if !matches!(callee_name.as_str(), \"forwardRef\" | \"React.forwardRef\") {\n120\t            return None;\n121\t        }\n122\t\n123\t        // forwardRef<RefType, PropsType>(fn) — PropsType is the second type parameter\n124\t        let type_params = call.type_arguments.as_ref()?;\n125\t        if type_params.params.len() < 2 {\n126\t            return None;\n127\t        }\n128\t        let props_type = &type_params.params[1];\n129\t        let (props_name, type_args) = self.extract_type_name_from_type(props_type)?;\n130\t\n131\t        // The render function is forwardRef's call argument — its first parameter is\n132\t        // props (the second is `ref`, which never carries destructured defaults we care about).\n133\t        let render_params = match call.arguments.first() {\n134\t            Some(Argument::FunctionExpression(fe)) => Some(&fe.params),\n135\t            Some(Argument::ArrowFunctionExpression(afe)) => Some(&afe.params),\n136\t            _ => None,\n137\t        };\n138\t        let param_defaults = render_params.map(|p| self.extract_param_defaults(p)).unwrap_or_default();\n139\t        let (description, tags) = self.find_jsdoc_with_tags(decl.span.start);\n140\t\n141\t        Some(ComponentMapping {\n142\t            component_name: name.to_owned(),\n143\t            props_type_name: props_name,\n144\t            props_type_args: type_args,\n145\t            file_path: self.file_path.clone(),\n146\t            description,\n147\t            tags,\n148\t            span_start: decl.span.start,\n149\t            span_end: decl.span.end,\n150\t            param_defaults,\n151\t        })\n152\t    }\n153\t\n154\t    /// Try to detect: `const Button = anyHOC(function Button(props: ButtonProps) {...})`\n155\t    pub(super) fn try_hoc_wrapped<'a>(\n156\t        &mut self,\n157\t        decl: &VariableDeclarator<'a>,\n158\t        name: &str,\n159\t    ) -> Option<ComponentMapping> {\n160\t        let init = decl.init.as_ref()?;\n161\t        let call = match unwrap_as_expression(init) {\n162\t            Expression::CallExpression(ce) => ce,\n163\t            _ => return None,\n164\t        };\n165\t\n166\t        // First arg should be a function with a typed props param — or a forwardRef() call.\n167\t        let first_arg = call.arguments.first()?;\n168\t\n169\t        // Handle memo(forwardRef<Ref, Props>(...)) — inner call is forwardRef\n170\t        if let Argument::CallExpression(inner) = first_arg {\n171\t            if let Some(inner_name) = self.extract_callee_name(inner) {\n172\t                if matches!(inner_name.as_str(), \"forwardRef\" | \"React.forwardRef\") {\n173\t                    let type_params = inner.type_arguments.as_ref()?;\n174\t                    if type_params.params.len() >= 2 {\n175\t                        let (props_name, type_args) = self.extract_type_name_from_type(&type_params.params[1])?;\n176\t                        let (description, tags) = self.find_jsdoc_with_tags(decl.span.start);\n177\t                        return Some(ComponentMapping {\n178\t                            component_name: name.to_owned(),\n179\t                            props_type_name: props_name,\n180\t                            props_type_args: type_args,\n181\t                            file_path: self.file_path.clone(),\n182\t                            description,\n183\t                            tags,\n184\t                            span_start: decl.span.start,\n185\t                            span_end: decl.span.end,\n\n... [148 lines truncated] ..."},"type":"attachment","uuid":"bd1be9a0-f55c-4253-8958-ada7f684a220","timestamp":"2026-07-25T20:06:18.671Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
