{"parentUuid":"0e78adde-dc4b-422c-897a-e483c1715498","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdPTpqHUqxgmYM5fNBEPE","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6558,"cache_read_input_tokens":636825,"output_tokens":246,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6558,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":246,"cache_read_input_tokens":636825,"cache_creation_input_tokens":6558,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6558},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdPTpmP5VyGEBxqq4CdYc","type":"assistant","uuid":"8f85c878-77dc-465e-994d-589f547af4f6","timestamp":"2026-07-25T21:11:24.263Z","effort":"medium","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"8f85c878-77dc-465e-994d-589f547af4f6","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdPTpqHUqxgmYM5fNBEPE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CEZTqvWqy2XpWSo2CqJPMi","name":"Read","input":{"file_path":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/alias.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6558,"cache_read_input_tokens":636825,"output_tokens":246,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6558,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":246,"cache_read_input_tokens":636825,"cache_creation_input_tokens":6558,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6558},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdPTpmP5VyGEBxqq4CdYc","type":"assistant","uuid":"1a8b4193-4758-4836-930e-9e4d8596a492","timestamp":"2026-07-25T21:11:24.960Z","effort":"medium","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"1a8b4193-4758-4836-930e-9e4d8596a492","isSidechain":false,"promptId":"03d4cbdd-7029-4e04-9b9b-1c6c4e4aec9b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEZTqvWqy2XpWSo2CqJPMi","type":"tool_result","content":"1\t//! Type alias chain and type-level resolution.\n2\t\n3\tuse std::collections::BTreeMap;\n4\t\n5\tuse camino::Utf8Path;\n6\tuse rustc_hash::FxHashSet;\n7\t\n8\tuse crate::types::*;\n9\t\n10\tuse super::chain::resolve_props_chain;\n11\tuse super::collected::resolve_collected_type;\n12\tuse super::{ResolutionContext, ResolvedChain};\n13\t\n14\t/// Resolve a `CollectedTypeAlias` as a props chain.\n15\t#[allow(clippy::too_many_arguments)]\n16\tpub(super) fn resolve_type_alias_chain(\n17\t    alias: &CollectedTypeAlias,\n18\t    _consuming_file: &Utf8Path,\n19\t    mapping: &ComponentMapping,\n20\t    ctx: &ResolutionContext,\n21\t    state: &mut ResolveState,\n22\t    depth: u8,\n23\t) -> ResolvedChain {\n24\t    match alias {\n25\t        // Delegate to the generic CollectedType→chain resolver, which already\n26\t        // handles Named (interfaces/type aliases), Object (inline literals),\n27\t        // Intersection, and Union targets. Previously this arm only matched\n28\t        // `Named` and silently dropped everything else (e.g. an inline\n29\t        // `{ x: string }` object literal used directly as props), which lost\n30\t        // the whole component's props with no diagnostic.\n31\t        CollectedTypeAlias::Passthrough { target, file_path } => {\n32\t            resolve_base_as_chain(target, file_path, mapping, ctx, state, depth)\n33\t        }\n34\t\n35\t        CollectedTypeAlias::Omit { base, omitted_keys, omitted_keys_of, file_path } => {\n36\t            // Resolve the base type first, then remove omitted keys.\n37\t            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n38\t\n39\t            let mut all_omitted: Vec<String> = omitted_keys.clone();\n40\t            if let Some(keys_of) = omitted_keys_of {\n41\t                // `Omit<Base, keyof Other>` — `Other`'s key set isn't known statically.\n42\t                // Purely structural, not type inference: resolve `Other` as its own\n43\t                // props chain (the same machinery used for `base` above) and take its\n44\t                // field names as the omitted set.\n45\t                //\n46\t                // Branch on a cloned `visited` set (same pattern as `resolve_union_alias`'s\n47\t                // discriminant probe below): `Other` is very often *also* resolved for real\n48\t                // elsewhere in the same alias (e.g. the `& U` half of `Omit<T, keyof U> & U`).\n49\t                // Sharing the main cycle-detection set would mark it visited here and make\n50\t                // that later, legitimate resolution come back empty.\n51\t                let mut branch_state = ResolveState {\n52\t                    visited: state.visited.clone(),\n53\t                    diagnostics: vec![],\n54\t                    in_scope_type_params: state.in_scope_type_params.clone(),\n55\t                };\n56\t                let other_chain = resolve_base_as_chain(keys_of, file_path, mapping, ctx, &mut branch_state, depth);\n57\t                state.diagnostics.extend(branch_state.diagnostics);\n58\t                all_omitted.extend(other_chain.props.into_iter().map(|p| p.name));\n59\t            }\n60\t\n61\t            let omitted_set: FxHashSet<&str> = all_omitted.iter().map(|k| k.as_str()).collect();\n62\t            chain.props.retain(|p| !omitted_set.contains(p.name.as_str()));\n63\t            // Record omitted keys in the relevant inheritance layer.\n64\t            for layer in &mut chain.inheritance {\n65\t                for key in &all_omitted {\n66\t                    if !layer.omitted.contains(key) {\n67\t                        layer.omitted.push(key.clone());\n68\t                    }\n69\t                }\n70\t            }\n71\t            chain\n72\t        }\n73\t\n74\t        CollectedTypeAlias::Pick { base, picked_keys, file_path } => {\n75\t            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n76\t            let picked_set: FxHashSet<&str> = picked_keys.iter().map(|k| k.as_str()).collect();\n77\t            chain.props.retain(|p| picked_set.contains(p.name.as_str()));\n78\t            chain\n79\t        }\n80\t\n81\t        CollectedTypeAlias::Partial { base, file_path } => {\n82\t            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n83\t            // Make all props optional.\n84\t            for prop in &mut chain.props {\n85\t                prop.required = false;\n86\t            }\n87\t            chain\n88\t        }\n89\t\n90\t        CollectedTypeAlias::Required { base, file_path } => {\n91\t            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n92\t            // Make all props required.\n93\t            for prop in &mut chain.props {\n94\t                prop.required = true;\n95\t            }\n96\t            chain\n97\t        }\n98\t\n99\t        CollectedTypeAlias::Union { members, file_path } => {\n100\t            // Discriminated union — try to find the discriminant and merge all members.\n101\t            resolve_union_alias(members, file_path, mapping, ctx, state, depth)\n102\t        }\n103\t\n104\t        CollectedTypeAlias::Intersection { members, file_path } => {\n105\t            // Merge all members' props.\n106\t            let mut chain = ResolvedChain::default();\n107\t            for member in members {\n108\t                let member_chain = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n109\t                chain.merge_parent(member_chain);\n110\t            }\n111\t            chain\n112\t        }\n113\t\n114\t        CollectedTypeAlias::LiteralUnion { .. } => {\n115\t            // Pure string union used as a type alias — not a props provider.\n116\t            ResolvedChain::default()\n117\t        }\n118\t    }\n119\t}\n120\t\n121\t/// Resolve a `CollectedType` as a props chain (for base types in aliases).\n122\tpub(super) fn resolve_base_as_chain(\n123\t    base: &CollectedType,\n124\t    file_path: &Utf8Path,\n125\t    mapping: &ComponentMapping,\n126\t    ctx: &ResolutionContext,\n127\t    state: &mut ResolveState,\n128\t    depth: u8,\n129\t) -> ResolvedChain {\n130\t    match base {\n131\t        CollectedType::Named { name, args } => {\n132\t            // Omit/Pick/Partial/Readonly applied to a *structured* reference — e.g. a\n133\t            // member of `Omit<T, keyof U> & U` after `T`/`U` were substituted with real\n134\t            // types (see resolver/substitute.rs). Handled directly here, rather than via\n135\t            // the string-based `resolve_props_chain` path below, so nested generics and\n136\t            // `keyof` operands survive structurally instead of being flattened to a\n137\t            // single opaque display string first.\n138\t            if let Some(alias) = super::substitute::synthesize_utility_alias(name.as_str(), args, file_path) {\n139\t                return resolve_type_alias_chain(&alias, file_path, mapping, ctx, state, depth);\n140\t            }\n141\t\n142\t            // A user-defined generic alias referenced with structured (possibly\n143\t            // cross-file, possibly nested-generic) arguments — e.g.\n144\t            // `SelectRootBaseProps<T>` used as `Assign<T, U>`'s own `U` argument.\n145\t            // Substituted and resolved directly here so the nested generic survives,\n146\t            // rather than falling through to the string-based path below (which would\n147\t            // flatten it to a single opaque display string before substitution ever ran).\n148\t            if let Some(alias) = super::substitute::generic_alias_with_structured_args(\n149\t                name.as_str(),\n150\t                args,\n151\t                file_path,\n152\t                ctx,\n153\t                &mut state.diagnostics,\n154\t            ) {\n155\t                return resolve_type_alias_chain(&alias, file_path, mapping, ctx, state, depth + 1);\n156\t            }\n157\t\n158\t            let raw_args: Vec<String> = args.iter().map(|a| a.to_raw_string()).collect();\n159\t            resolve_props_chain(name.as_str(), &raw_args, file_path, mapping, ctx, state, depth + 1)\n160\t        }\n161\t        // Generic-alias substitution marker (see resolver/substitute.rs and the\n162\t        // `CollectedType::AtFile` doc comment): `inner` was written in `file`, not\n163\t        // whatever file this call chain has been resolving relative to — e.g. a\n164\t        // type argument substituted from the caller's scope into a callee alias\n165\t        // declared in a different file. Switch file context and continue.\n166\t        CollectedType::AtFile { file, inner } => resolve_base_as_chain(inner, file, mapping, ctx, state, depth),\n167\t        CollectedType::Intersection(members) => {\n168\t            let mut chain = ResolvedChain::default();\n169\t            for member in members {\n170\t                let sub = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n171\t                chain.merge_parent(sub);\n172\t            }\n173\t            chain\n174\t        }\n175\t        CollectedType::Object(fields) => {\n176\t            // Inline object type in an intersection: `ComponentPropsWithoutRef<'button'> & { asChild?: boolean }`\n177\t            // Expand the object fields directly as own props.\n178\t            let mut chain = ResolvedChain::default();\n179\t            for field in fields {\n180\t                let prop_type = resolve_collected_type(&field.collected_type, file_path, ctx, state, depth);\n181\t                chain.props.push(ParsedProp {\n182\t                    name: field.name.clone(),\n183\t                    prop_type,\n184\t                    required: field.required,\n185\t                    default_value: None,\n186\t                    description: field.description.clone(),\n187\t                    tags: Default::default(),\n188\t                    parent: None,\n189\t                    declarations: vec![],\n190\t                });\n191\t            }\n192\t            chain\n193\t        }\n194\t        CollectedType::Union(members) => {\n195\t            // Delegate to the same discriminant-detection merge used for a\n196\t            // directly-aliased union (`type X = A | B`). A union doesn't stop being\n197\t            // discriminated just because it's wrapped in an intersection\n198\t            // (`type X = Base & (A | B)`, e.g. react-day-picker's real\n199\t            // `DayPickerProps`) or used as `Omit<A | B, K>`'s base — falling back to\n200\t            // a naive per-member merge here silently lost the discriminant and\n201\t            // collapsed each prop's type to whichever branch happened to be seen\n202\t            // last instead of a proper union across all branches.\n203\t            resolve_union_alias(members, file_path, mapping, ctx, state, depth)\n204\t        }\n205\t        // None of these can ever provide a props chain (a props type must be\n206\t        // object-like — an interface, intersection, union, or inline object).\n207\t        // Named explicitly, not via a wildcard, so a future CollectedType\n208\t        // variant forces a compile error here instead of silently falling\n209\t        // through to an empty, undiagnosed chain the way IndexedAccess and\n210\t        // Function once did.\n211\t        CollectedType::String\n212\t        | CollectedType::Number\n213\t        | CollectedType::Boolean\n214\t        | CollectedType::Null\n215\t        | CollectedType::Undefined\n216\t        | CollectedType::Any\n217\t        | CollectedType::Never\n218\t        | CollectedType::Unknown\n219\t        | CollectedType::Void\n220\t        | CollectedType::BigInt\n221\t        | CollectedType::Symbol\n222\t        | CollectedType::StringLiteral(_)\n223\t        | CollectedType::NumberLiteral(_)\n224\t        | CollectedType::BoolLiteral(_)\n225\t        | CollectedType::Array(_)\n226\t        | CollectedType::Tuple(_)\n227\t        | CollectedType::TypeOf(_)\n228\t        | CollectedType::IndexedAccess { .. }\n229\t        | CollectedType::TemplateLiteral(_)\n230\t        | CollectedType::Function { .. }\n231\t        | CollectedType::Conditional { .. }\n232\t        | CollectedType::Mapped { .. }\n233\t        | CollectedType::KeyOf(_)\n234\t        | CollectedType::Raw(_) => {\n235\t            state.diagnostics.push(Diagnostic {\n236\t                severity: DiagnosticSeverity::Warning,\n237\t                message: format!(\n238\t                    \"'{}' cannot be used as a component's props base in '{}' — expected an interface, \\\n239\t                     intersection, union, or inline object type\",\n240\t                    base.to_raw_string(),\n241\t                    file_path\n242\t                ),\n243\t                file: Some(file_path.to_string()),\n244\t                line: None,\n245\t                column: None,\n246\t                help: Some(\"Check that this member of the props type resolves to an object-like shape.\".into()),\n247\t                code: DiagnosticCode::OpaqueType,\n248\t            });\n249\t            ResolvedChain::default()\n250\t        }\n251\t    }\n252\t}\n253\t\n254\t/// Resolve a `CollectedTypeAlias::Union` — detect discriminated union if possible.\n255\t#[allow(clippy::too_many_arguments)]\n256\tpub(super) fn resolve_union_alias(\n257\t    members: &[CollectedType],\n258\t    file_path: &Utf8Path,\n259\t    mapping: &ComponentMapping,\n260\t    ctx: &ResolutionContext,\n261\t    state: &mut ResolveState,\n262\t    depth: u8,\n263\t) -> ResolvedChain {\n264\t    use super::chain::find_discriminant_prop;\n265\t\n266\t    // Collect all member chains for named types (only Named can be discriminated).\n267\t    let named_members: Vec<(&str, Vec<ParsedProp>)> = members\n268\t        .iter()\n269\t        .filter_map(|m| {\n270\t            if let CollectedType::Named { name, .. } = m {\n271\t                let mut branch_state = ResolveState {\n272\t                    visited: state.visited.clone(),\n273\t                    diagnostics: vec![],\n274\t                    in_scope_type_params: state.in_scope_type_params.clone(),\n275\t                };\n276\t                let chain =\n277\t                    resolve_props_chain(name.as_str(), &[], file_path, mapping, ctx, &mut branch_state, depth + 1);\n278\t                state.diagnostics.extend(branch_state.diagnostics);\n279\t                Some((name.as_str(), chain.props))\n280\t            } else {\n281\t                None\n282\t            }\n283\t        })\n284\t        .collect();\n285\t\n286\t    if named_members.len() < 2 {\n287\t        // Not a discriminated union — just merge all.\n288\t        let mut chain = ResolvedChain::default();\n289\t        for member in members {\n290\t            let sub = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n291\t            chain.merge_parent(sub);\n292\t        }\n293\t        return chain;\n294\t    }\n295\t\n296\t    // Try to find a discriminant prop (a prop whose type is a distinct string literal across all members).\n297\t    let discriminant = find_discriminant_prop(&named_members);\n298\t\n299\t    // Merge all props from all members. A prop's merged type is the union of every\n300\t    // distinct type it has across the members that declare it (deduped — two members\n301\t    // contributing the identical type must not produce a redundant single-member\n302\t    // union); a prop missing from at least one member becomes optional overall, even\n303\t    // if it was required in every member where it does appear, since the union type\n304\t    // doesn't guarantee its presence.\n305\t    let mut merged_props: BTreeMap<String, ParsedProp> = BTreeMap::new();\n306\t    let mut prop_types: BTreeMap<String, Vec<PropType>> = BTreeMap::new();\n307\t    let mut seen_count: BTreeMap<String, usize> = BTreeMap::new();\n308\t    let mut required_in_all: BTreeMap<String, bool> = BTreeMap::new();\n309\t    let mut total_variants: usize = 0;\n310\t\n311\t    for (_, member_props) in &named_members {\n312\t        total_variants += 1;\n313\t        record_variant_props(member_props, &mut merged_props, &mut prop_types, &mut seen_count, &mut required_in_all);\n314\t    }\n315\t\n316\t    // Also merge non-Named members (inline objects, intersections, nested unions, etc.)\n317\t    // that were excluded from the discriminant analysis above.\n318\t    for member in members {\n319\t        if !matches!(member, CollectedType::Named { .. }) {\n320\t            let sub_chain = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n321\t            total_variants += 1;\n322\t            record_variant_props(\n323\t                &sub_chain.props,\n324\t                &mut merged_props,\n325\t                &mut prop_types,\n326\t                &mut seen_count,\n327\t                &mut required_in_all,\n328\t            );\n329\t        }\n330\t    }\n331\t\n332\t    for (name, mut types) in prop_types {\n333\t        let prop_type = match types.len() {\n334\t            0 | 1 => match types.pop() {\n335\t                Some(t) => t,\n336\t                None => continue,\n337\t            },\n338\t            _ => PropType::Union(types),\n339\t        };\n340\t\n341\t        if let Some(entry) = merged_props.get_mut(&name) {\n342\t            entry.prop_type = prop_type;\n343\t            let present_everywhere = seen_count.get(&name).copied().unwrap_or(0) == total_variants;\n344\t            let required_everywhere = required_in_all.get(&name).copied().unwrap_or(false);\n345\t            entry.required = present_everywhere && required_everywhere;\n346\t        }\n347\t    }\n348\t\n349\t    // If we found a discriminant, merge its type as a union of all its literal values.\n350\t    if let Some(ref disc_name) = discriminant {\n351\t        let disc_literals: Vec<PropType> = named_members\n352\t            .iter()\n353\t            .filter_map(|(_, props)| props.iter().find(|p| &p.name == disc_name).map(|p| p.prop_type.clone()))\n354\t            .collect();\n355\t\n356\t        if let Some(disc_prop) = merged_props.get_mut(disc_name) {\n357\t            disc_prop.prop_type = PropType::Union(disc_literals);\n358\t        }\n359\t    }\n360\t\n361\t    // Emit discriminated union diagnostic if applicable.\n362\t    if discriminant.is_some() {\n363\t        state.diagnostics.push(Diagnostic {\n364\t            severity: DiagnosticSeverity::Info,\n365\t            message: format!(\n366\t                \"Discriminated union detected with discriminant prop '{}'\",\n367\t                discriminant.as_deref().unwrap_or(\"\")\n368\t            ),\n369\t            file: Some(file_path.to_string()),\n370\t            line: None,\n371\t            column: None,\n372\t            help: None,\n373\t            code: DiagnosticCode::DiscriminatedUnion,\n374\t        });\n375\t    }\n376\t\n377\t    ResolvedChain { props: merged_props.into_values().collect(), discriminant_prop: discriminant, ..Default::default() }\n378\t}\n379\t\n380\t/// Record one union member's props into the shared merge accumulators: the\n381\t/// first-seen `ParsedProp` (for name/description/parent/etc.), the set of\n382\t/// distinct types contributed for each prop name, how many members declared\n383\t/// it, and whether every member that declared it marked it required.\n384\tfn record_variant_props(\n385\t    props: &[ParsedProp],\n386\t    merged_props: &mut BTreeMap<String, ParsedProp>,\n387\t    prop_types: &mut BTreeMap<String, Vec<PropType>>,\n388\t    seen_count: &mut BTreeMap<String, usize>,\n389\t    required_in_all: &mut BTreeMap<String, bool>,\n390\t) {\n391\t    for prop in props {\n392\t        merged_props.entry(prop.name.clone()).or_insert_with(|| prop.clone());\n393\t\n394\t        let types = prop_types.entry(prop.name.clone()).or_default();\n395\t        if !types.contains(&prop.prop_type) {\n396\t            types.push(prop.prop_type.clone());\n397\t        }\n398\t\n399\t        *seen_count.entry(prop.name.clone()).or_insert(0) += 1;\n400\t\n401\t        required_in_all\n402\t            .entry(prop.name.clone())\n403\t            .and_modify(|required| *required = *required && prop.required)\n404\t            .or_insert(prop.required);\n405\t    }\n406\t}\n407\t\n408\t/// Resolve a `CollectedTypeAlias` to a `PropType` (at the type level, not chain level).\n409\t///\n410\t/// Members reference relative to `alias.file_path()` — the alias's OWN declaring\n411\t/// file — never the caller's `consuming_file`. A `type Combined = A | B` alias\n412\t/// imported cross-file still has `A`/`B` as same-file siblings of `Combined`\n413\t/// wherever it was actually declared, not siblings of whatever file imported it.\n414\tpub(super) fn resolve_type_alias_type(\n415\t    alias: &CollectedTypeAlias,\n416\t    ctx: &ResolutionContext,\n417\t    state: &mut ResolveState,\n418\t    depth: u8,\n419\t) -> PropType {\n420\t    let file_path = alias.file_path();\n421\t    match alias {\n422\t        CollectedTypeAlias::LiteralUnion { members, .. } => {\n423\t            PropType::LiteralUnion { members: members.clone(), has_default: false }\n424\t        }\n425\t        CollectedTypeAlias::Passthrough { target, .. } => {\n426\t            resolve_collected_type(target, file_path, ctx, state, depth + 1)\n427\t        }\n428\t        CollectedTypeAlias::Union { members, .. } => {\n429\t            let resolved: Vec<PropType> =\n430\t                members.iter().map(|m| resolve_collected_type(m, file_path, ctx, state, depth + 1)).collect();\n431\t            PropType::Union(resolved)\n432\t        }\n433\t        CollectedTypeAlias::Intersection { members, .. } => {\n434\t            let resolved: Vec<PropType> =\n435\t                members.iter().map(|m| resolve_collected_type(m, file_path, ctx, state, depth + 1)).collect();\n436\t            PropType::Intersection(resolved)\n437\t        }\n438\t        CollectedTypeAlias::Partial { base, .. } | CollectedTypeAlias::Required { base, .. } => {\n439\t            resolve_collected_type(base, file_path, ctx, state, depth + 1)\n440\t        }\n441\t        CollectedTypeAlias::Omit { base, .. } | CollectedTypeAlias::Pick { base, .. } => {\n442\t            // At the type level, just forward to the base type.\n443\t            resolve_collected_type(base, file_path, ctx, state, depth + 1)\n444\t        }\n445\t    }\n446\t}\n447\t"}]},"uuid":"0bb67c41-7e1b-483a-be2d-628b32759e1a","timestamp":"2026-07-25T21:11:25.094Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/alias.rs","content":"//! Type alias chain and type-level resolution.\n\nuse std::collections::BTreeMap;\n\nuse camino::Utf8Path;\nuse rustc_hash::FxHashSet;\n\nuse crate::types::*;\n\nuse super::chain::resolve_props_chain;\nuse super::collected::resolve_collected_type;\nuse super::{ResolutionContext, ResolvedChain};\n\n/// Resolve a `CollectedTypeAlias` as a props chain.\n#[allow(clippy::too_many_arguments)]\npub(super) fn resolve_type_alias_chain(\n    alias: &CollectedTypeAlias,\n    _consuming_file: &Utf8Path,\n    mapping: &ComponentMapping,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> ResolvedChain {\n    match alias {\n        // Delegate to the generic CollectedType→chain resolver, which already\n        // handles Named (interfaces/type aliases), Object (inline literals),\n        // Intersection, and Union targets. Previously this arm only matched\n        // `Named` and silently dropped everything else (e.g. an inline\n        // `{ x: string }` object literal used directly as props), which lost\n        // the whole component's props with no diagnostic.\n        CollectedTypeAlias::Passthrough { target, file_path } => {\n            resolve_base_as_chain(target, file_path, mapping, ctx, state, depth)\n        }\n\n        CollectedTypeAlias::Omit { base, omitted_keys, omitted_keys_of, file_path } => {\n            // Resolve the base type first, then remove omitted keys.\n            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n\n            let mut all_omitted: Vec<String> = omitted_keys.clone();\n            if let Some(keys_of) = omitted_keys_of {\n                // `Omit<Base, keyof Other>` — `Other`'s key set isn't known statically.\n                // Purely structural, not type inference: resolve `Other` as its own\n                // props chain (the same machinery used for `base` above) and take its\n                // field names as the omitted set.\n                //\n                // Branch on a cloned `visited` set (same pattern as `resolve_union_alias`'s\n                // discriminant probe below): `Other` is very often *also* resolved for real\n                // elsewhere in the same alias (e.g. the `& U` half of `Omit<T, keyof U> & U`).\n                // Sharing the main cycle-detection set would mark it visited here and make\n                // that later, legitimate resolution come back empty.\n                let mut branch_state = ResolveState {\n                    visited: state.visited.clone(),\n                    diagnostics: vec![],\n                    in_scope_type_params: state.in_scope_type_params.clone(),\n                };\n                let other_chain = resolve_base_as_chain(keys_of, file_path, mapping, ctx, &mut branch_state, depth);\n                state.diagnostics.extend(branch_state.diagnostics);\n                all_omitted.extend(other_chain.props.into_iter().map(|p| p.name));\n            }\n\n            let omitted_set: FxHashSet<&str> = all_omitted.iter().map(|k| k.as_str()).collect();\n            chain.props.retain(|p| !omitted_set.contains(p.name.as_str()));\n            // Record omitted keys in the relevant inheritance layer.\n            for layer in &mut chain.inheritance {\n                for key in &all_omitted {\n                    if !layer.omitted.contains(key) {\n                        layer.omitted.push(key.clone());\n                    }\n                }\n            }\n            chain\n        }\n\n        CollectedTypeAlias::Pick { base, picked_keys, file_path } => {\n            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n            let picked_set: FxHashSet<&str> = picked_keys.iter().map(|k| k.as_str()).collect();\n            chain.props.retain(|p| picked_set.contains(p.name.as_str()));\n            chain\n        }\n\n        CollectedTypeAlias::Partial { base, file_path } => {\n            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n            // Make all props optional.\n            for prop in &mut chain.props {\n                prop.required = false;\n            }\n            chain\n        }\n\n        CollectedTypeAlias::Required { base, file_path } => {\n            let mut chain = resolve_base_as_chain(base, file_path, mapping, ctx, state, depth);\n            // Make all props required.\n            for prop in &mut chain.props {\n                prop.required = true;\n            }\n            chain\n        }\n\n        CollectedTypeAlias::Union { members, file_path } => {\n            // Discriminated union — try to find the discriminant and merge all members.\n            resolve_union_alias(members, file_path, mapping, ctx, state, depth)\n        }\n\n        CollectedTypeAlias::Intersection { members, file_path } => {\n            // Merge all members' props.\n            let mut chain = ResolvedChain::default();\n            for member in members {\n                let member_chain = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n                chain.merge_parent(member_chain);\n            }\n            chain\n        }\n\n        CollectedTypeAlias::LiteralUnion { .. } => {\n            // Pure string union used as a type alias — not a props provider.\n            ResolvedChain::default()\n        }\n    }\n}\n\n/// Resolve a `CollectedType` as a props chain (for base types in aliases).\npub(super) fn resolve_base_as_chain(\n    base: &CollectedType,\n    file_path: &Utf8Path,\n    mapping: &ComponentMapping,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> ResolvedChain {\n    match base {\n        CollectedType::Named { name, args } => {\n            // Omit/Pick/Partial/Readonly applied to a *structured* reference — e.g. a\n            // member of `Omit<T, keyof U> & U` after `T`/`U` were substituted with real\n            // types (see resolver/substitute.rs). Handled directly here, rather than via\n            // the string-based `resolve_props_chain` path below, so nested generics and\n            // `keyof` operands survive structurally instead of being flattened to a\n            // single opaque display string first.\n            if let Some(alias) = super::substitute::synthesize_utility_alias(name.as_str(), args, file_path) {\n                return resolve_type_alias_chain(&alias, file_path, mapping, ctx, state, depth);\n            }\n\n            // A user-defined generic alias referenced with structured (possibly\n            // cross-file, possibly nested-generic) arguments — e.g.\n            // `SelectRootBaseProps<T>` used as `Assign<T, U>`'s own `U` argument.\n            // Substituted and resolved directly here so the nested generic survives,\n            // rather than falling through to the string-based path below (which would\n            // flatten it to a single opaque display string before substitution ever ran).\n            if let Some(alias) = super::substitute::generic_alias_with_structured_args(\n                name.as_str(),\n                args,\n                file_path,\n                ctx,\n                &mut state.diagnostics,\n            ) {\n                return resolve_type_alias_chain(&alias, file_path, mapping, ctx, state, depth + 1);\n            }\n\n            let raw_args: Vec<String> = args.iter().map(|a| a.to_raw_string()).collect();\n            resolve_props_chain(name.as_str(), &raw_args, file_path, mapping, ctx, state, depth + 1)\n        }\n        // Generic-alias substitution marker (see resolver/substitute.rs and the\n        // `CollectedType::AtFile` doc comment): `inner` was written in `file`, not\n        // whatever file this call chain has been resolving relative to — e.g. a\n        // type argument substituted from the caller's scope into a callee alias\n        // declared in a different file. Switch file context and continue.\n        CollectedType::AtFile { file, inner } => resolve_base_as_chain(inner, file, mapping, ctx, state, depth),\n        CollectedType::Intersection(members) => {\n            let mut chain = ResolvedChain::default();\n            for member in members {\n                let sub = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n                chain.merge_parent(sub);\n            }\n            chain\n        }\n        CollectedType::Object(fields) => {\n            // Inline object type in an intersection: `ComponentPropsWithoutRef<'button'> & { asChild?: boolean }`\n            // Expand the object fields directly as own props.\n            let mut chain = ResolvedChain::default();\n            for field in fields {\n                let prop_type = resolve_collected_type(&field.collected_type, file_path, ctx, state, depth);\n                chain.props.push(ParsedProp {\n                    name: field.name.clone(),\n                    prop_type,\n                    required: field.required,\n                    default_value: None,\n                    description: field.description.clone(),\n                    tags: Default::default(),\n                    parent: None,\n                    declarations: vec![],\n                });\n            }\n            chain\n        }\n        CollectedType::Union(members) => {\n            // Delegate to the same discriminant-detection merge used for a\n            // directly-aliased union (`type X = A | B`). A union doesn't stop being\n            // discriminated just because it's wrapped in an intersection\n            // (`type X = Base & (A | B)`, e.g. react-day-picker's real\n            // `DayPickerProps`) or used as `Omit<A | B, K>`'s base — falling back to\n            // a naive per-member merge here silently lost the discriminant and\n            // collapsed each prop's type to whichever branch happened to be seen\n            // last instead of a proper union across all branches.\n            resolve_union_alias(members, file_path, mapping, ctx, state, depth)\n        }\n        // None of these can ever provide a props chain (a props type must be\n        // object-like — an interface, intersection, union, or inline object).\n        // Named explicitly, not via a wildcard, so a future CollectedType\n        // variant forces a compile error here instead of silently falling\n        // through to an empty, undiagnosed chain the way IndexedAccess and\n        // Function once did.\n        CollectedType::String\n        | CollectedType::Number\n        | CollectedType::Boolean\n        | CollectedType::Null\n        | CollectedType::Undefined\n        | CollectedType::Any\n        | CollectedType::Never\n        | CollectedType::Unknown\n        | CollectedType::Void\n        | CollectedType::BigInt\n        | CollectedType::Symbol\n        | CollectedType::StringLiteral(_)\n        | CollectedType::NumberLiteral(_)\n        | CollectedType::BoolLiteral(_)\n        | CollectedType::Array(_)\n        | CollectedType::Tuple(_)\n        | CollectedType::TypeOf(_)\n        | CollectedType::IndexedAccess { .. }\n        | CollectedType::TemplateLiteral(_)\n        | CollectedType::Function { .. }\n        | CollectedType::Conditional { .. }\n        | CollectedType::Mapped { .. }\n        | CollectedType::KeyOf(_)\n        | CollectedType::Raw(_) => {\n            state.diagnostics.push(Diagnostic {\n                severity: DiagnosticSeverity::Warning,\n                message: format!(\n                    \"'{}' cannot be used as a component's props base in '{}' — expected an interface, \\\n                     intersection, union, or inline object type\",\n                    base.to_raw_string(),\n                    file_path\n                ),\n                file: Some(file_path.to_string()),\n                line: None,\n                column: None,\n                help: Some(\"Check that this member of the props type resolves to an object-like shape.\".into()),\n                code: DiagnosticCode::OpaqueType,\n            });\n            ResolvedChain::default()\n        }\n    }\n}\n\n/// Resolve a `CollectedTypeAlias::Union` — detect discriminated union if possible.\n#[allow(clippy::too_many_arguments)]\npub(super) fn resolve_union_alias(\n    members: &[CollectedType],\n    file_path: &Utf8Path,\n    mapping: &ComponentMapping,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> ResolvedChain {\n    use super::chain::find_discriminant_prop;\n\n    // Collect all member chains for named types (only Named can be discriminated).\n    let named_members: Vec<(&str, Vec<ParsedProp>)> = members\n        .iter()\n        .filter_map(|m| {\n            if let CollectedType::Named { name, .. } = m {\n                let mut branch_state = ResolveState {\n                    visited: state.visited.clone(),\n                    diagnostics: vec![],\n                    in_scope_type_params: state.in_scope_type_params.clone(),\n                };\n                let chain =\n                    resolve_props_chain(name.as_str(), &[], file_path, mapping, ctx, &mut branch_state, depth + 1);\n                state.diagnostics.extend(branch_state.diagnostics);\n                Some((name.as_str(), chain.props))\n            } else {\n                None\n            }\n        })\n        .collect();\n\n    if named_members.len() < 2 {\n        // Not a discriminated union — just merge all.\n        let mut chain = ResolvedChain::default();\n        for member in members {\n            let sub = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n            chain.merge_parent(sub);\n        }\n        return chain;\n    }\n\n    // Try to find a discriminant prop (a prop whose type is a distinct string literal across all members).\n    let discriminant = find_discriminant_prop(&named_members);\n\n    // Merge all props from all members. A prop's merged type is the union of every\n    // distinct type it has across the members that declare it (deduped — two members\n    // contributing the identical type must not produce a redundant single-member\n    // union); a prop missing from at least one member becomes optional overall, even\n    // if it was required in every member where it does appear, since the union type\n    // doesn't guarantee its presence.\n    let mut merged_props: BTreeMap<String, ParsedProp> = BTreeMap::new();\n    let mut prop_types: BTreeMap<String, Vec<PropType>> = BTreeMap::new();\n    let mut seen_count: BTreeMap<String, usize> = BTreeMap::new();\n    let mut required_in_all: BTreeMap<String, bool> = BTreeMap::new();\n    let mut total_variants: usize = 0;\n\n    for (_, member_props) in &named_members {\n        total_variants += 1;\n        record_variant_props(member_props, &mut merged_props, &mut prop_types, &mut seen_count, &mut required_in_all);\n    }\n\n    // Also merge non-Named members (inline objects, intersections, nested unions, etc.)\n    // that were excluded from the discriminant analysis above.\n    for member in members {\n        if !matches!(member, CollectedType::Named { .. }) {\n            let sub_chain = resolve_base_as_chain(member, file_path, mapping, ctx, state, depth);\n            total_variants += 1;\n            record_variant_props(\n                &sub_chain.props,\n                &mut merged_props,\n                &mut prop_types,\n                &mut seen_count,\n                &mut required_in_all,\n            );\n        }\n    }\n\n    for (name, mut types) in prop_types {\n        let prop_type = match types.len() {\n            0 | 1 => match types.pop() {\n                Some(t) => t,\n                None => continue,\n            },\n            _ => PropType::Union(types),\n        };\n\n        if let Some(entry) = merged_props.get_mut(&name) {\n            entry.prop_type = prop_type;\n            let present_everywhere = seen_count.get(&name).copied().unwrap_or(0) == total_variants;\n            let required_everywhere = required_in_all.get(&name).copied().unwrap_or(false);\n            entry.required = present_everywhere && required_everywhere;\n        }\n    }\n\n    // If we found a discriminant, merge its type as a union of all its literal values.\n    if let Some(ref disc_name) = discriminant {\n        let disc_literals: Vec<PropType> = named_members\n            .iter()\n            .filter_map(|(_, props)| props.iter().find(|p| &p.name == disc_name).map(|p| p.prop_type.clone()))\n            .collect();\n\n        if let Some(disc_prop) = merged_props.get_mut(disc_name) {\n            disc_prop.prop_type = PropType::Union(disc_literals);\n        }\n    }\n\n    // Emit discriminated union diagnostic if applicable.\n    if discriminant.is_some() {\n        state.diagnostics.push(Diagnostic {\n            severity: DiagnosticSeverity::Info,\n            message: format!(\n                \"Discriminated union detected with discriminant prop '{}'\",\n                discriminant.as_deref().unwrap_or(\"\")\n            ),\n            file: Some(file_path.to_string()),\n            line: None,\n            column: None,\n            help: None,\n            code: DiagnosticCode::DiscriminatedUnion,\n        });\n    }\n\n    ResolvedChain { props: merged_props.into_values().collect(), discriminant_prop: discriminant, ..Default::default() }\n}\n\n/// Record one union member's props into the shared merge accumulators: the\n/// first-seen `ParsedProp` (for name/description/parent/etc.), the set of\n/// distinct types contributed for each prop name, how many members declared\n/// it, and whether every member that declared it marked it required.\nfn record_variant_props(\n    props: &[ParsedProp],\n    merged_props: &mut BTreeMap<String, ParsedProp>,\n    prop_types: &mut BTreeMap<String, Vec<PropType>>,\n    seen_count: &mut BTreeMap<String, usize>,\n    required_in_all: &mut BTreeMap<String, bool>,\n) {\n    for prop in props {\n        merged_props.entry(prop.name.clone()).or_insert_with(|| prop.clone());\n\n        let types = prop_types.entry(prop.name.clone()).or_default();\n        if !types.contains(&prop.prop_type) {\n            types.push(prop.prop_type.clone());\n        }\n\n        *seen_count.entry(prop.name.clone()).or_insert(0) += 1;\n\n        required_in_all\n            .entry(prop.name.clone())\n            .and_modify(|required| *required = *required && prop.required)\n            .or_insert(prop.required);\n    }\n}\n\n/// Resolve a `CollectedTypeAlias` to a `PropType` (at the type level, not chain level).\n///\n/// Members reference relative to `alias.file_path()` — the alias's OWN declaring\n/// file — never the caller's `consuming_file`. A `type Combined = A | B` alias\n/// imported cross-file still has `A`/`B` as same-file siblings of `Combined`\n/// wherever it was actually declared, not siblings of whatever file imported it.\npub(super) fn resolve_type_alias_type(\n    alias: &CollectedTypeAlias,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> PropType {\n    let file_path = alias.file_path();\n    match alias {\n        CollectedTypeAlias::LiteralUnion { members, .. } => {\n            PropType::LiteralUnion { members: members.clone(), has_default: false }\n        }\n        CollectedTypeAlias::Passthrough { target, .. } => {\n            resolve_collected_type(target, file_path, ctx, state, depth + 1)\n        }\n        CollectedTypeAlias::Union { members, .. } => {\n            let resolved: Vec<PropType> =\n                members.iter().map(|m| resolve_collected_type(m, file_path, ctx, state, depth + 1)).collect();\n            PropType::Union(resolved)\n        }\n        CollectedTypeAlias::Intersection { members, .. } => {\n            let resolved: Vec<PropType> =\n                members.iter().map(|m| resolve_collected_type(m, file_path, ctx, state, depth + 1)).collect();\n            PropType::Intersection(resolved)\n        }\n        CollectedTypeAlias::Partial { base, .. } | CollectedTypeAlias::Required { base, .. } => {\n            resolve_collected_type(base, file_path, ctx, state, depth + 1)\n        }\n        CollectedTypeAlias::Omit { base, .. } | CollectedTypeAlias::Pick { base, .. } => {\n            // At the type level, just forward to the base type.\n            resolve_collected_type(base, file_path, ctx, state, depth + 1)\n        }\n    }\n}\n","numLines":447,"startLine":1,"totalLines":447}},"sourceToolAssistantUUID":"1a8b4193-4758-4836-930e-9e4d8596a492","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
