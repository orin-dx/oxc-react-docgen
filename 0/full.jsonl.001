{"parentUuid":"6bccff7f-ff2c-4bd9-adb8-e22f2ab77041","isSidechain":false,"promptId":"808a5445-bf63-43b5-80bb-2c806292ef39","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AsN8T48KW8du8UXp6qP8bR","type":"tool_result","content":"700\t\n701\t        let output = extract(&options);\n702\t\n703\t        let icon = output.components.get(\"Icon\").expect(\"Icon component not found\");\n704\t        assert!(\n705\t            icon.props.contains_key(\"suppressHydrationWarning\"),\n706\t            \"expected a real SVGAttributes field to resolve as an own prop in Full mode, got {:?}\",\n707\t            icon.props.keys().collect::<Vec<_>>()\n708\t        );\n709\t        assert!(icon.props.contains_key(\"size\"), \"own prop 'size' should still be present\");\n710\t    }\n711\t\n712\t    // ── test_named_type_only_import_from_react_resolves_to_real_dts ──────────\n713\t    //\n714\t    // Regression test for: `import type { AriaAttributes } from \"react\"` used"}]},"uuid":"5e64b12e-f110-4221-a2c0-17fae406d9a4","timestamp":"2026-07-25T19:50:00.105Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/pipeline/mod.rs","content":"\n        let output = extract(&options);\n\n        let icon = output.components.get(\"Icon\").expect(\"Icon component not found\");\n        assert!(\n            icon.props.contains_key(\"suppressHydrationWarning\"),\n            \"expected a real SVGAttributes field to resolve as an own prop in Full mode, got {:?}\",\n            icon.props.keys().collect::<Vec<_>>()\n        );\n        assert!(icon.props.contains_key(\"size\"), \"own prop 'size' should still be present\");\n    }\n\n    // ── test_named_type_only_import_from_react_resolves_to_real_dts ──────────\n    //\n    // Regression test for: `import type { AriaAttributes } from \"react\"` used","numLines":15,"startLine":700,"totalLines":1246}},"sourceToolAssistantUUID":"6bccff7f-ff2c-4bd9-adb8-e22f2ab77041","se