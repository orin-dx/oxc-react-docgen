((r) => [r.fixture, r]))\n}\n\nconst ours = loadBaseline('oxc-react-docgen')\nconst rdt = loadBaseline('react-docgen-typescript')\nconst rdg = loadBaseline('react-docgen')\n\nif (!ours) {\n  console.error('No oxc-react-docgen baseline found — run `pnpm run:ours` first.')\n  process.exit(1)\n}\n\n// ─── Divergence taxonomy ──────────────────────────────────────────────────\n//\n// Classifies a (ours, comparator) type-string mismatch into a bucket by\n// observable shape only — it can't see root cause, just the diff. Root","numLines":25,"startLine":1,"totalLines":262}},"sourceToolAssistantUUID":"c75df6fd-71a6-4656-93a2-a076b604e551","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen/apps/validate","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
