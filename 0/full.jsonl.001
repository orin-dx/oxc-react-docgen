{"parentUuid":"beb0f4c2-7f1c-45f1-923f-01d163ccb5ce","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01RNfM7KdVCBekF2tZPKYjLe","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"d83be67f-8b07-459c-989b-529791ef5ca7\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/oxc-react-codegen\\\",\\\"project\\\":\\\"oxc-react-codegen\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":58},"type":"attachment","uuid":"00060819-e0d2-4626-9f0a-4af64b534153","timestamp":"2026-07-25T19:43:16.395Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"00060819-e0d2-4626-9f0a-4af64b534153","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/react_types.rs","snippet":"1\t//! Baked-in knowledge of React and DOM types.\n2\t//! No file I/O — these are compile-time constants derived from @types/react.\n3\t\n4\t/// HTML element names recognized as component-level inheritors.\n5\t///\n6\t/// Maps `@types/react` HTML attribute type names to their corresponding DOM element names.\n7\tpub fn html_element_for(type_name: &str) -> Option<&'static str> {\n8\t    match type_name {\n9\t        \"ButtonHTMLAttributes\" => Some(\"button\"),\n10\t        \"InputHTMLAttributes\" => Some(\"input\"),\n11\t        \"TextareaHTMLAttributes\" => Some(\"textarea\"),\n12\t        \"SelectHTMLAttributes\" => Some(\"select\"),\n13\t        \"AnchorHTMLAttributes\" => Some(\"a\"),\n14\t        \"FormHTMLAttributes\" => Some(\"form\"),\n15\t        \"LabelHTMLAttributes\" => Some(\"label\"),\n16\t        \"ImgHTMLAttributes\" => Some(\"img\"),\n17\t        \"VideoHTMLAttributes\" => Some(\"video\"),\n18\t        \"AudioHTMLAttributes\" => Some(\"audio\"),\n19\t        \"HTMLAttributes\" => Some(\"div\"),\n20\t        \"DOMAttributes\" => Some(\"div\"),\n21\t        \"AriaAttributes\" => None,             // not an element, but recognized as built-in\n22\t        \"SVGAttributes\" | \"SVGProps\" => None, // SVG — no single element to pick from the name alone\n23\t        \"HTMLProps\" => Some(\"div\"), // generic HTML props → div (overridden below when a real element arg is given)\n24\t        _ => None,\n25\t    }\n26\t}\n27\t\n28\t/// `SVGAttributes<T>`/`SVGProps<T>`/`HTMLProps<T>` carry no element in their own\n29\t/// name (unlike `ButtonHTMLAttributes`, where the element is baked into the\n30\t/// name) — but a real call site always supplies a concrete DOM element type as\n31\t/// `T`, e.g. `React.SVGAttributes<SVGSVGElement>` or `React.HTMLProps<HTMLDivElement>`.\n32\t/// Derives the element tag from that argument so these generic forms get the\n33\t/// same real, structural HTML-attribute expansion (Full mode) and\n34\t/// `notableInherited` treatment (Curated mode) that the concrete forms\n35\t/// already get from `html_element_for` alone. Only covers the element types\n36\t/// that actually appear as `SVGAttributes`/`HTMLProps` type arguments in\n37\t/// practice — falls back to `None` (the prior, safe opaque behavior) for\n38\t/// anything not in this list rather than guessing at a tag name that's wrong\n39\t/// (e.g. `HTMLAnchorElement`'s real tag is `a`, not a naive strip-and-lowercase\n40\t/// of the interface name).\n41\tpub fn html_element_from_type_arg(type_arg: &str) -> Option<&'static str> {\n42\t    match type_arg {\n43\t        \"HTMLAnchorElement\" => Some(\"a\"),\n44\t        \"HTMLButtonElement\" => Some(\"button\"),\n45\t        \"HTMLDivElement\" => Some(\"div\"),\n46\t        \"HTMLSpanElement\" => Some(\"span\"),\n47\t        \"HTMLFormElement\" => Some(\"form\"),\n48\t        \"HTMLImageElement\" => Some(\"img\"),\n49\t        \"HTMLInputElement\" => Some(\"input\"),\n50\t        \"HTMLLabelElement\" => Some(\"label\"),\n51\t        \"HTMLSelectElement\" => Some(\"select\"),\n52\t        \"HTMLTextAreaElement\" => Some(\"textarea\"),\n53\t        \"HTMLVideoElement\" => Some(\"video\"),\n54\t        \"HTMLAudioElement\" => Some(\"audio\"),\n55\t        \"HTMLParagraphElement\" => Some(\"p\"),\n56\t        \"HTMLUListElement\" => Some(\"ul\"),\n57\t        \"HTMLOListElement\" => Some(\"ol\"),\n58\t        \"HTMLLIElement\" => Some(\"li\"),\n59\t        \"HTMLTableElement\" => Some(\"table\"),\n60\t        \"SVGSVGElement\" => Some(\"svg\"),\n61\t        \"SVGCircleElement\" => Some(\"circle\"),\n62\t        \"SVGPathElement\" => Some(\"path\"),\n63\t        \"SVGRectElement\" => Some(\"rect\"),\n64\t        \"SVGLineElement\" => Some(\"line\"),\n65\t        \"SVGGElement\" => Some(\"g\"),\n66\t        _ => None,\n67\t    }\n68\t}\n69\t\n70\t/// Types that are terminal — never need further resolution.\n71\t///\n72\t/// These are React-specific type names that we recognize as builtins and don't\n73\t/// attempt to chase through imports.\n74\t///\n75\t/// `extra` allows callers (e.g. the resolver) to pass additional builtin names\n76\t/// from `PipelineOptions.extra_builtins` without needing to change this file.\n77\tpub fn is_react_builtin(name: &str, extra: &rustc_hash::FxHashSet<compact_str::CompactString>) -> bool {\n78\t    extra.contains(name)\n79\t        || matches!(\n80\t            name,\n81\t            \"ReactNode\"\n82\t                | \"ReactElement\"\n83\t                | \"JSX.Element\"\n84\t                | \"CSSProperties\"\n85\t                | \"CSSObject\"\n86\t                | \"SyntheticEvent\"\n87\t                | \"MouseEvent\"\n88\t                | \"KeyboardEvent\"\n89\t                | \"ChangeEvent\"\n90\t                | \"FocusEvent\"\n91\t                | \"FormEvent\"\n92\t                | \"DragEvent\"\n93\t                | \"TouchEvent\"\n94\t                | \"WheelEvent\"\n95\t                | \"AnimationEvent\"\n96\t                | \"TransitionEvent\"\n97\t                | \"ClipboardEvent\"\n98\t                | \"CompositionEvent\"\n99\t                | \"MouseEventHandler\"\n100\t                | \"KeyboardEventHandler\"\n101\t                | \"ChangeEventHandler\"\n102\t                | \"FocusEventHandler\"\n103\t                | \"FormEventHandler\"\n104\t                | \"DragEventHandler\"\n105\t                | \"TouchEventHandler\"\n106\t                | \"WheelEventHandler\"\n107\t                | \"AnimationEventHandler\"\n108\t                | \"TransitionEventHandler\"\n109\t                | \"ClipboardEventHandler\"\n110\t                | \"CompositionEventHandler\"\n111\t                | \"PointerEventHandler\"\n112\t                | \"ReactEventHandler\"\n113\t                | \"SubmitEventHandler\"\n114\t                | \"InputEventHandler\"\n115\t                | \"ToggleEventHandler\"\n116\t                | \"FC\"\n117\t                | \"FunctionComponent\"\n118\t                | \"VFC\"\n119\t                | \"VoidFunctionComponent\"\n120\t                | \"ComponentType\"\n121\t                | \"PropsWithChildren\"\n122\t                | \"PropsWithRef\"\n123\t                | \"RefObject\"\n124\t                | \"Ref\"\n125\t                | \"ForwardedRef\"\n126\t                | \"MutableRefObject\"\n127\t                | \"RefCallback\"\n128\t                | \"LegacyRef\"\n129\t                | \"Context\"\n130\t                | \"Consumer\"\n131\t                | \"Provider\"\n132\t                | \"ComponentPropsWithoutRef\"\n133\t                | \"ComponentPropsWithRef\"\n134\t                | \"ComponentProps\"\n135\t                | \"ElementRef\"\n136\t                | \"ElementType\"\n137\t                | \"ReactPortal\"\n138\t                | \"ReactFragment\"\n139\t                | \"ReactChild\"\n140\t                | \"ForwardRefExoticComponent\"\n141\t                | \"RefAttributes\"\n142\t                | \"ComponentRef\"\n143\t                | \"JSXElementConstructor\"\n144\t                | \"SVGAttributes\"\n145\t                | \"SVGProps\"\n146\t                | \"HTMLProps\"\n147\t        )\n148\t}\n149\t\n150\t/// Returns the curated list of notable HTML attribute prop names for a given element.\n151\t///\n152\t/// Used to populate `ComponentEntry.notable_inherited` — the subset of inherited\n153\t/// HTML props that are most relevant for documentation and prop tables.\n154\tpub fn notable_html_attrs(element: &str) -> &'static [&'static str] {\n155\t    match element {\n156\t        \"button\" => &[\n157\t            \"onClick\",\n158\t            \"onKeyDown\",\n159\t            \"onKeyUp\",\n160\t            \"onFocus\",\n161\t            \"onBlur\",\n162\t            \"disabled\",\n163\t            \"type\",\n164\t            \"form\",\n165\t            \"name\",\n166\t            \"value\",\n167\t            \"tabIndex\",\n168\t            \"aria-label\",\n169\t            \"aria-describedby\",\n170\t            \"aria-expanded\",\n171\t            \"aria-pressed\",\n172\t            \"aria-haspopup\",\n173\t        ],\n174\t        \"input\" => &[\n175\t            \"onChange\",\n176\t            \"onInput\",\n177\t            \"onFocus\",\n178\t            \"onBlur\",\n179\t            \"value\",\n180\t            \"defaultValue\",\n181\t            \"placeholder\",\n182\t            \"type\",\n183\t            \"disabled\",\n184\t            \"readOnly\",\n185\t            \"required\",\n186\t            \"name\",\n187\t            \"min\",\n188\t            \"max\",\n189\t            \"pattern\",\n190\t            \"autoComplete\",\n191\t            \"checked\",\n192\t            \"defaultChecked\",\n193\t        ],\n194\t        \"a\" => &[\"href\", \"target\", \"rel\", \"download\", \"onClick\"],\n195\t        \"textarea\" => &[\n196\t            \"onChange\",\n\n... [63 lines truncated] ..."},"type":"attachment","uuid":"4456a0dc-3b24-465e-8af2-bee5ecabb12d","timestamp":"2026-07-25T19:43:16.420Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
