hiserror         = \"2.0\"\nmiette            = \"7.6\"\nanyhow            = \"1.0\"\n\n# Parallelism\nrayon             = \"1.12\"\ntokio             = { version = \"1.52\", features = [\"rt-multi-thread\", \"process\", \"io-util\", \"sync\", \"macros\"] }\n\n# File system\nignore            = \"0.4\"\n\n# LSP (Tier 4 scaffold — not implemented)\nlsp-types         = \"0.97\"\n\n# CLI\nclap              = { version = \"4.6\", features = [\"derive\", \"env\", \"wrap_help\"] }\nclap_complete     = \"4.6\"\nclap_mangen       = \"0.3\"\nindicatif         = \"0.18\"\ntracing-indicatif = \"0.3\"\ntracing           = \"0.1\"\ntracing-subscriber = { version = \"0.3\", features = [\"env-filter\", \"fmt\"] }\nowo-colors        = \"4.3\"\nwatchexec         = \"8.2\"\n\n# NAPI (3.x series)\nnapi              = { version = \"3\", features = [\"napi4\"] }\nnapi-derive       = \"3\"\n\n# Dev\ndivan             = \"0.1\"\ninsta             = { version = \"1.48\", features = [\"json\", \"redactions\"] }\npretty_assertions = \"1.4\"\ntempfile          = \"3.20\"\n\n[profile.release]\nopt-level = 3\nlto = \"thin\"\ncodegen-units = 1\n\n[profile.bench]\ninherits = \"release\"\ndebug = true\n","structuredPatch":[{"oldStart":69,"oldLines":7,"newStart":69,"newLines":7,"lines":[" napi-derive       = \"3\""," "," # Dev","-divan             = \"0.1\"","+criterion         = \"0.7\""," insta             = { version = \"1.48\", features = [\"json\", \"redactions\"] }"," pretty_assertions = \"1.4\""," tempfile          = \"3.20\""]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"87d28a69-32fb-4017-a897-0c4ffe5c267d","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
