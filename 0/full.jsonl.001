umber\n  typeDiffBuckets: Record<TypeDiffBucket, number>\n  diffs: PropDiff[]\n}\n\nfunction comparePair(\n  oursMap: Map<string, ToolResult>,\n  otherMap: Map<string, ToolResult>,\n  comparatorName: 'react-docgen-typescript' | 'react-docgen',\n): PairSummary {\n  const summary: PairSummary = {\n    comparator: comparatorName,\n    componentsCompared: 0,\n    propsUnion: 0,\n    matched: 0,\n    mismatched: 0,\n    missingInOurs: 0,\n    missingButHtmlInheritanceCovered: 0,\n    extraInOurs: 0,\n    agreementRate: 0,\n    typeDiffBuckets: {\n      'cosmetic-formatting': 0,\n      'literal-narrowed-vs-widened': 0,\n      'union-member-order': 0,\n      'optional-undefined-representation': 0,\n      'structural-type-difference': 0,\n    },\n    diffs: [],\n  }\n\n  for (const [key, ourResult] of oursMap) {\n    const otherResult = otherMap.get(key)\n    if (!otherResult || ourResult.error || otherResult.error) continue\n\n    const [fixture, component] = [key.split('/').slice(0, -1).join('/'), key.split('/').at(-1) ?? key]\n    const ourComp = Object.values(ourResult.output)[0]\n    const otherComp = Object.values(otherResult.output)[0]\n    if (!ourComp || !otherComp) continue\n","numLines":40,"startLine":108,"totalLines":255}},"sourceToolAssistantUUID":"8bf20197-6d15-4466-a90d-2956b8ba6f7e","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen/apps/validate","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
