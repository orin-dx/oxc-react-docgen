{"parentUuid":"3967cdc5-ebd3-4322-91ca-e41b67377360","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Pu6Ec1CWnprYMb6gwrmm8","type":"tool_result","content":"1\t//! Central dispatch: CollectedType → PropType.\n2\t\n3\tuse camino::Utf8Path;\n4\t\n5\tuse crate::types::*;\n6\t\n7\tuse super::func::{resolve_function_type, resolve_typeof};\n8\tuse super::named::resolve_named;\n9\tuse super::primitives::{resolve_indexed_access, resolve_intersection, resolve_union};\n10\tuse super::template::resolve_template_literal;\n11\tuse super::{ResolutionContext, MAX_DEPTH};\n12\t\n13\t/// Central dispatch: convert a `CollectedType` to a `PropType`.\n14\t/// Never re-parses strings — everything is already structured.\n15\t#[allow(clippy::too_many_arguments)]\n16\tpub fn resolve_collected_type(\n17\t    ct: &CollectedType,\n18\t    consuming_file: &Utf8Path,\n19\t    ctx: &ResolutionContext,\n20\t    state: &mut ResolveState,\n21\t    depth: u8,\n22\t) -> PropType {\n23\t    if depth > MAX_DEPTH {\n24\t        state.diagnostics.push(Diagnostic {\n25\t            severity: DiagnosticSeverity::Warning,\n26\t            message: format!(\"Max resolution depth exceeded resolving type: {}\", ct.to_raw_string()),\n27\t            file: Some(consuming_file.to_string()),\n28\t            line: None,\n29\t            column: None,\n30\t            help: None,\n31\t            code: DiagnosticCode::MaxDepthExceeded,\n32\t        });\n33\t        return PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::DepthExceeded };\n34\t    }\n35\t\n36\t    match ct {\n37\t        // ── Primitives ────────────────────────────────────────────────────────\n38\t        CollectedType::String => PropType::String,\n39\t        CollectedType::Number => PropType::Number,\n40\t        CollectedType::Boolean => PropType::Boolean,\n41\t        CollectedType::Null => PropType::Null,\n42\t        CollectedType::Undefined => PropType::Undefined,\n43\t        CollectedType::Any => PropType::Any,\n44\t        CollectedType::Never => PropType::Never,\n45\t        CollectedType::Unknown => PropType::Unknown,\n46\t        CollectedType::Void => PropType::Void,\n47\t        // BigInt/Symbol — no dedicated PropType; surface as Named.\n48\t        CollectedType::BigInt => PropType::Named { name: \"bigint\".into(), args: vec![] },\n49\t        CollectedType::Symbol => PropType::Named { name: \"symbol\".into(), args: vec![] },\n50\t\n51\t        // ── Literals ─────────────────────────────────────────────────────────\n52\t        CollectedType::StringLiteral(s) => PropType::StringLiteral(s.to_string()),\n53\t        CollectedType::NumberLiteral(n) => PropType::NumberLiteral(*n),\n54\t        CollectedType::BoolLiteral(b) => PropType::BoolLiteral(*b),\n55\t\n56\t        // ── Composites ───────────────────────────────────────────────────────\n57\t        CollectedType::Union(members) => resolve_union(members, consuming_file, ctx, state, depth),\n58\t        CollectedType::Intersection(members) => resolve_intersection(members, consuming_file, ctx, state, depth),\n59\t        CollectedType::Array(inner) => {\n60\t            PropType::Array(Box::new(resolve_collected_type(inner, consuming_file, ctx, state, depth + 1)))\n61\t        }\n62\t        CollectedType::Tuple(members) => PropType::Tuple(\n63\t            members.iter().map(|m| resolve_collected_type(m, consuming_file, ctx, state, depth + 1)).collect(),\n64\t        ),\n65\t        CollectedType::Object(fields) => PropType::Object(\n66\t            fields\n67\t                .iter()\n68\t                .map(|f| ObjectField {\n69\t                    name: f.name.clone(),\n70\t                    prop_type: resolve_collected_type(&f.collected_type, consuming_file, ctx, state, depth + 1),\n71\t                    required: f.required,\n72\t                    description: f.description.clone(),\n73\t                })\n74\t                .collect(),\n75\t        ),\n76\t\n77\t        // ── Named type reference ──────────────────────────────────────────────\n78\t        CollectedType::Named { name, args } => resolve_named(name, args, consuming_file, ctx, state, depth),\n79\t\n80\t        // ── typeof X ─────────────────────────────────────────────────────────\n81\t        CollectedType::TypeOf(name) => resolve_typeof(name, consuming_file, ctx, &mut state.diagnostics),\n82\t\n83\t        // ── keyof X — only meaningful as Omit's key argument (handled structurally\n84\t        // there, see resolver/alias.rs); standalone usage needs a general\n85\t        // type-to-key-names resolver we don't have, so degrade gracefully.\n86\t        CollectedType::KeyOf(_) => PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType },\n87\t\n88\t        // ── Generic-alias substitution marker — switch file context to where\n89\t        // `inner` was actually written (see the `CollectedType::AtFile` doc\n90\t        // comment) and continue resolving from there.\n91\t        CollectedType::AtFile { file, inner } => resolve_collected_type(inner, file, ctx, state, depth),\n92\t\n93\t        // ── Indexed access ───────────────────────────────────────────────────\n94\t        CollectedType::IndexedAccess { obj, key } => {\n95\t            resolve_indexed_access(obj, key, consuming_file, ctx, state, depth)\n96\t        }\n97\t\n98\t        // ── Template literal ─────────────────────────────────────────────────\n99\t        CollectedType::TemplateLiteral(parts) => resolve_template_literal(parts, consuming_file, ctx, state, depth),\n100\t\n101\t        // ── Function type ─────────────────────────────────────────────────────\n102\t        CollectedType::Function { params, param_names, return_type } => {\n103\t            resolve_function_type(params, param_names, return_type, consuming_file, ctx, state, depth)\n104\t        }\n105\t\n106\t        // ── Opaque (needs type checker) ───────────────────────────────────────\n107\t        CollectedType::Conditional { .. } => {\n108\t            PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::ConditionalType }\n109\t        }\n110\t        CollectedType::Mapped { .. } => PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType },\n111\t\n112\t        // ── Raw fallback ─────────────────────────────────────────────────────\n113\t        CollectedType::Raw(s) => {\n114\t            let trimmed = s.trim();\n115\t            // `typeof X` — ExtendsRef.type_args serialized form; resolve as Named.\n116\t            if let Some(name) = trimmed.strip_prefix(\"typeof \") {\n117\t                return PropType::Named { name: name.trim().into(), args: vec![] };\n118\t            }\n119\t            // Double-quoted string literal: `\"button\"` → StringLiteral.\n120\t            if trimmed.starts_with('\"') && trimmed.ends_with('\"') && trimmed.len() >= 2 {\n121\t                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n122\t            }\n123\t            // Single-quoted string literal: `'button'` → StringLiteral.\n124\t            if trimmed.starts_with('\\'') && trimmed.ends_with('\\'') && trimmed.len() >= 2 {\n125\t                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n126\t            }\n127\t            // TypeScript primitive keywords — tuple elements come through Raw because\n128\t            // TSTupleElement falls through to source-text extraction for non-optional,\n129\t            // non-rest elements. Recognise keywords here so they emit the proper PropType.\n130\t            match trimmed {\n131\t                \"string\" => return PropType::String,\n132\t                \"number\" => return PropType::Number,\n133\t                \"boolean\" => return PropType::Boolean,\n134\t                \"null\" => return PropType::Null,\n135\t                \"undefined\" => return PropType::Undefined,\n136\t                \"never\" => return PropType::Never,\n137\t                \"void\" => return PropType::Void,\n138\t                \"any\" => return PropType::Any,\n139\t                \"unknown\" => return PropType::Unknown,\n140\t                _ => {}\n141\t            }\n142\t            // Simple identifier → Named type reference.\n143\t            if !trimmed.is_empty()\n144\t                && !trimmed.contains(' ')\n145\t                && !trimmed.contains('|')\n146\t                && !trimmed.contains('&')\n147\t                && !trimmed.contains('<')\n148\t            {\n149\t                PropType::Named { name: trimmed.into(), args: vec![] }\n150\t            } else {\n151\t                PropType::Opaque { raw: s.clone(), reason: OpaqueReason::DepthExceeded }\n152\t            }\n153\t        }\n154\t    }\n155\t}\n156\t"}]},"uuid":"6205d2d6-1869-4823-ada2-efb6eb2061fb","timestamp":"2026-07-22T19:44:00.400Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/collected.rs","content":"//! Central dispatch: CollectedType → PropType.\n\nuse camino::Utf8Path;\n\nuse crate::types::*;\n\nuse super::func::{resolve_function_type, resolve_typeof};\nuse super::named::resolve_named;\nuse super::primitives::{resolve_indexed_access, resolve_intersection, resolve_union};\nuse super::template::resolve_template_literal;\nuse super::{ResolutionContext, MAX_DEPTH};\n\n/// Central dispatch: convert a `CollectedType` to a `PropType`.\n/// Never re-parses strings — everything is already structured.\n#[allow(clippy::too_many_arguments)]\npub fn resolve_collected_type(\n    ct: &CollectedType,\n    consuming_file: &Utf8Path,\n    ctx: &ResolutionContext,\n    state: &mut ResolveState,\n    depth: u8,\n) -> PropType {\n    if depth > MAX_DEPTH {\n        state.diagnostics.push(Diagnostic {\n            severity: DiagnosticSeverity::Warning,\n            message: format!(\"Max resolution depth exceeded resolving type: {}\", ct.to_raw_string()),\n            file: Some(consuming_file.to_string()),\n            line: None,\n            column: None,\n            help: None,\n            code: DiagnosticCode::MaxDepthExceeded,\n        });\n        return PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::DepthExceeded };\n    }\n\n    match ct {\n        // ── Primitives ────────────────────────────────────────────────────────\n        CollectedType::String => PropType::String,\n        CollectedType::Number => PropType::Number,\n        CollectedType::Boolean => PropType::Boolean,\n        CollectedType::Null => PropType::Null,\n        CollectedType::Undefined => PropType::Undefined,\n        CollectedType::Any => PropType::Any,\n        CollectedType::Never => PropType::Never,\n        CollectedType::Unknown => PropType::Unknown,\n        CollectedType::Void => PropType::Void,\n        // BigInt/Symbol — no dedicated PropType; surface as Named.\n        CollectedType::BigInt => PropType::Named { name: \"bigint\".into(), args: vec![] },\n        CollectedType::Symbol => PropType::Named { name: \"symbol\".into(), args: vec![] },\n\n        // ── Literals ─────────────────────────────────────────────────────────\n        CollectedType::StringLiteral(s) => PropType::StringLiteral(s.to_string()),\n        CollectedType::NumberLiteral(n) => PropType::NumberLiteral(*n),\n        CollectedType::BoolLiteral(b) => PropType::BoolLiteral(*b),\n\n        // ── Composites ───────────────────────────────────────────────────────\n        CollectedType::Union(members) => resolve_union(members, consuming_file, ctx, state, depth),\n        CollectedType::Intersection(members) => resolve_intersection(members, consuming_file, ctx, state, depth),\n        CollectedType::Array(inner) => {\n            PropType::Array(Box::new(resolve_collected_type(inner, consuming_file, ctx, state, depth + 1)))\n        }\n        CollectedType::Tuple(members) => PropType::Tuple(\n            members.iter().map(|m| resolve_collected_type(m, consuming_file, ctx, state, depth + 1)).collect(),\n        ),\n        CollectedType::Object(fields) => PropType::Object(\n            fields\n                .iter()\n                .map(|f| ObjectField {\n                    name: f.name.clone(),\n                    prop_type: resolve_collected_type(&f.collected_type, consuming_file, ctx, state, depth + 1),\n                    required: f.required,\n                    description: f.description.clone(),\n                })\n                .collect(),\n        ),\n\n        // ── Named type reference ──────────────────────────────────────────────\n        CollectedType::Named { name, args } => resolve_named(name, args, consuming_file, ctx, state, depth),\n\n        // ── typeof X ─────────────────────────────────────────────────────────\n        CollectedType::TypeOf(name) => resolve_typeof(name, consuming_file, ctx, &mut state.diagnostics),\n\n        // ── keyof X — only meaningful as Omit's key argument (handled structurally\n        // there, see resolver/alias.rs); standalone usage needs a general\n        // type-to-key-names resolver we don't have, so degrade gracefully.\n        CollectedType::KeyOf(_) => PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType },\n\n        // ── Generic-alias substitution marker — switch file context to where\n        // `inner` was actually written (see the `CollectedType::AtFile` doc\n        // comment) and continue resolving from there.\n        CollectedType::AtFile { file, inner } => resolve_collected_type(inner, file, ctx, state, depth),\n\n        // ── Indexed access ───────────────────────────────────────────────────\n        CollectedType::IndexedAccess { obj, key } => {\n            resolve_indexed_access(obj, key, consuming_file, ctx, state, depth)\n        }\n\n        // ── Template literal ─────────────────────────────────────────────────\n        CollectedType::TemplateLiteral(parts) => resolve_template_literal(parts, consuming_file, ctx, state, depth),\n\n        // ── Function type ─────────────────────────────────────────────────────\n        CollectedType::Function { params, param_names, return_type } => {\n            resolve_function_type(params, param_names, return_type, consuming_file, ctx, state, depth)\n        }\n\n        // ── Opaque (needs type checker) ───────────────────────────────────────\n        CollectedType::Conditional { .. } => {\n            PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::ConditionalType }\n        }\n        CollectedType::Mapped { .. } => PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType },\n\n        // ── Raw fallback ─────────────────────────────────────────────────────\n        CollectedType::Raw(s) => {\n            let trimmed = s.trim();\n            // `typeof X` — ExtendsRef.type_args serialized form; resolve as Named.\n            if let Some(name) = trimmed.strip_prefix(\"typeof \") {\n                return PropType::Named { name: name.trim().into(), args: vec![] };\n            }\n            // Double-quoted string literal: `\"button\"` → StringLiteral.\n            if trimmed.starts_with('\"') && trimmed.ends_with('\"') && trimmed.len() >= 2 {\n                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n            }\n            // Single-quoted string literal: `'button'` → StringLiteral.\n            if trimmed.starts_with('\\'') && trimmed.ends_with('\\'') && trimmed.len() >= 2 {\n                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n            }\n            // TypeScript primitive keywords — tuple elements come through Raw because\n            // TSTupleElement falls through to source-text extraction for non-optional,\n            // non-rest elements. Recognise keywords here so they emit the proper PropType.\n            match trimmed {\n                \"string\" => return PropType::String,\n                \"number\" => return PropType::Number,\n                \"boolean\" => return PropType::Boolean,\n                \"null\" => return PropType::Null,\n                \"undefined\" => return PropType::Undefined,\n                \"never\" => return PropType::Never,\n                \"void\" => return PropType::Void,\n                \"any\" => return PropType::Any,\n                \"unknown\" => return PropType::Unknown,\n                _ => {}\n            }\n            // Simple identifier → Named type reference.\n            if !trimmed.is_empty()\n                && !trimmed.contains(' ')\n                && !trimmed.contains('|')\n                && !trimmed.contains('&')\n                && !trimmed.contains('<')\n            {\n                PropType::Named { name: trimmed.into(), args: vec![] }\n            } else {\n                PropType::Opaque { raw: s.clone(), reason: OpaqueReason::DepthExceeded }\n            }\n        }\n    }\n}\n","numLines":156,"startLine":1,"totalLines":156}},"sourceToolAssistantUUID":"3967cdc5-ebd3-4322-91ca-e41b67377360","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
