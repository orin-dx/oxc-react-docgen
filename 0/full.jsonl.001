{"parentUuid":"532596e3-7729-4592-93e2-2d0e77184e72","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PostToolUse:Bash","toolUseID":"toolu_01WrLbnSETuVtTWPToQVdUpW","hookEvent":"PostToolUse","content":"","stdout":"{\"terminalSequence\":\"\\u001b]777;notify;warp://cli-agent;{\\\"v\\\":1,\\\"agent\\\":\\\"claude\\\",\\\"event\\\":\\\"tool_complete\\\",\\\"session_id\\\":\\\"d83be67f-8b07-459c-989b-529791ef5ca7\\\",\\\"cwd\\\":\\\"/Users/gabe/Projects/oxc-react-codegen\\\",\\\"project\\\":\\\"oxc-react-codegen\\\",\\\"tool_name\\\":\\\"Bash\\\"}\\u0007\"}\n","stderr":"/Users/gabe/.claude/plugins/cache/claude-code-warp/warp/2.1.0/scripts/emit-terminal-sequence.sh: line 82: /dev/tty: Device not configured\n","exitCode":0,"command":"${CLAUDE_PLUGIN_ROOT}/scripts/on-post-tool-use.sh","durationMs":69},"type":"attachment","uuid":"66e39f57-3747-47b2-a6af-cf1686cafd6f","timestamp":"2026-07-25T20:19:21.127Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
