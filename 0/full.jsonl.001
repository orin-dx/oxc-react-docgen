) = round_tripped else {\n            panic!(\"expected CollectedType::Object, got {:?}\", round_tripped);\n        };\n        assert_eq!(fields.len(), 1);\n        assert_eq!(fields[0].name, \"label\");\n        assert_eq!(fields[0].required, true);\n        assert_eq!(fields[0].description, \"the label\");\n    }\n}","originalFile":null,"structuredPatch":[{"oldStart":786,"oldLines":3,"newStart":786,"newLines":35,"lines":["     /// `export interface Foo { }` / `export type Bar = ...` / `export const X`","     LocalDeclaration { name: std::string::String, is_type_only: bool },"," }","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    // The DTS parse cache (crates/core/src/cache.rs) serializes with plain","+    // rmp_serde::to_vec/from_slice, which MessagePack-encodes structs","+    // POSITIONALLY (as an array of values), not as a map of field names —","+    // so a Deserialize impl must implement `visit_seq`, not just `visit_map`.","+    #[test]","+    fn collected_object_field_round_trips_through_rmp_serde_positional_encoding() {","+        let field = CollectedObjectField {","+            name: \"label\".to_owned(),","+            collected_type: CollectedType::String,","+            required: true,","+            description: \"the label\".to_owned(),","+        };","+        let ct = CollectedType::Object(vec![field]);","+","+        let bytes = rmp_serde::to_vec(&ct).expect(\"serialization should succeed\");","+        let round_tripped: CollectedType =","+            rmp_serde::from_slice(&bytes).expect(\"deserialization should succeed for rmp_serde's positional encoding\");","+","+        let CollectedType::Object(fields) = round_tripped else {","+            panic!(\"expected CollectedType::Object, got {:?}\", round_tripped);","+        };","+        assert_eq!(fields.len(), 1);","+        assert_eq!(fields[0].name, \"label\");","+        assert_eq!(fields[0].required, true);","+        assert_eq!(fields[0].description, \"the label\");","+    }","+}"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"edeae95e-936f-4289-8f95-ed321d55c376","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
