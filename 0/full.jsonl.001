{"parentUuid":"586c8da1-53b9-4693-948d-a88b615ead71","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/packages/vite-plugin/tests/unit/plugin.test.ts","snippet":"1\timport { describe, it, expect, vi, beforeEach } from 'vitest'\n2\t\n3\t// Mock BEFORE importing plugin — vi.mock is hoisted by Vitest\n4\tvi.mock('@oxc-react-docgen/napi', () => ({\n5\t  createSession: vi.fn().mockReturnValue(42),\n6\t  initializeSession: vi\n7\t    .fn()\n8\t    .mockResolvedValue(JSON.stringify({ components: {}, enums: {}, diagnostics: [], stats: {} })),\n9\t  extractFileIncremental: vi.fn().mockResolvedValue(\n10\t    JSON.stringify({\n11\t      updatedComponents: [\n12\t        {\n13\t          displayName: 'Button',\n14\t          filePath: '/project/src/Button.tsx',\n15\t          props: {},\n16\t          inheritance: [],\n17\t          notableInherited: {},\n18\t          description: '',\n19\t          discriminantProp: null,\n20\t          composes: [],\n21\t          tags: {},\n22\t          methods: [],\n23\t        },\n24\t      ],\n25\t      affectedFiles: ['/project/src/Button.tsx'],\n26\t      diagnostics: [],\n27\t      durationMs: 5,\n28\t    }),\n29\t  ),\n30\t  closeSession: vi.fn(),\n31\t}))\n32\t\n33\timport { oxcReactDocgen } from '../../src/index.js'\n34\timport * as napi from '@oxc-react-docgen/napi'\n35\t\n36\tdescribe('oxcReactDocgen', () => {\n37\t  let plugin: ReturnType<typeof oxcReactDocgen>\n38\t\n39\t  beforeEach(() => {\n40\t    vi.clearAllMocks()\n41\t    plugin = oxcReactDocgen({ srcDirs: ['src'] })\n42\t    // Simulate Vite calling configResolved\n43\t    ;(plugin.configResolved as Function)({ root: '/project' })\n44\t  })\n45\t\n46\t  // ── resolveId ──────────────────────────────────────────────────────────────\n47\t\n48\t  describe('resolveId', () => {\n49\t    it('resolves the virtual module id', () => {\n50\t      const result = (plugin.resolveId as Function)('virtual:oxc-react-docgen')\n51\t      expect(result).toBe('\\0virtual:oxc-react-docgen')\n52\t    })\n53\t\n54\t    it('returns undefined for unrelated ids', () => {\n55\t      expect((plugin.resolveId as Function)('react')).toBeUndefined()\n56\t      expect((plugin.resolveId as Function)('./Button.tsx')).toBeUndefined()\n57\t    })\n58\t  })\n59\t\n60\t  // ── load ───────────────────────────────────────────────────────────────────\n61\t\n62\t  describe('load', () => {\n63\t    it('returns a JS module for the resolved virtual id', () => {\n64\t      const code = (plugin.load as Function)('\\0virtual:oxc-react-docgen') as string\n65\t      expect(code).toMatch(/^export default \\{/)\n66\t      const data = JSON.parse(code.replace('export default ', ''))\n67\t      expect(data).toHaveProperty('components')\n68\t    })\n69\t\n70\t    it('returns undefined for other ids', () => {\n71\t      expect((plugin.load as Function)('\\0other')).toBeUndefined()\n72\t      expect((plugin.load as Function)('virtual:oxc-react-docgen')).toBeUndefined()\n73\t    })\n74\t  })\n75\t\n76\t  // ── configResolved ─────────────────────────────────────────────────────────\n77\t\n78\t  describe('configResolved', () => {\n79\t    it('creates a NAPI session with resolved absolute src dirs', () => {\n80\t      expect(napi.createSession).toHaveBeenCalledWith(expect.objectContaining({ srcDirs: ['/project/src'] }))\n81\t    })\n82\t  })\n83\t\n84\t  // ── configureServer ────────────────────────────────────────────────────────\n85\t\n86\t  describe('configureServer', () => {\n87\t    it('calls initializeSession with the session id and resolved options', async () => {\n88\t      const mockServer = {\n89\t        environments: { client: { hot: { send: vi.fn() } } },\n90\t      } as any\n91\t      // configureServer returns a teardown fn; initializeSession is async internally.\n92\t      // Flush the microtask queue so the .then() callback runs before asserting.\n93\t      ;(plugin.configureServer as Function)(mockServer)\n94\t      await vi.waitUntil(() => (napi.initializeSession as any).mock.calls.length > 0)\n95\t      await (napi.initializeSession as any).mock.results[0].value\n96\t      expect(napi.initializeSession).toHaveBeenCalledWith(42, expect.objectContaining({ srcDirs: ['/project/src'] }))\n97\t    })\n98\t  })\n99\t\n100\t  // ── hotUpdate ──────────────────────────────────────────────────────────────\n101\t\n102\t  describe('hotUpdate', () => {\n103\t    const clientEnv = () => ({\n104\t      environment: { name: 'client', hot: { send: vi.fn() } },\n105\t    })\n106\t\n107\t    const makeOpts = (file: string) => ({\n108\t      file,\n109\t      type: 'update' as const,\n110\t      modules: [],\n111\t      timestamp: 1000,\n112\t      read: vi.fn().mockResolvedValue(''),\n113\t      server: {} as any,\n114\t    })\n115\t\n116\t    it('calls extractFileIncremental for tsx files in srcDirs', async () => {\n117\t      const ctx = clientEnv()\n118\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n119\t      expect(napi.extractFileIncremental).toHaveBeenCalledWith(\n120\t        '/project/src/Button.tsx',\n121\t        42,\n122\t        expect.objectContaining({ srcDirs: ['/project/src'] }),\n123\t      )\n124\t    })\n125\t\n126\t    it('sends oxc-react-docgen:update over HMR', async () => {\n127\t      const ctx = clientEnv()\n128\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n129\t      expect(ctx.environment.hot.send).toHaveBeenCalledWith(\n130\t        'oxc-react-docgen:update',\n131\t        expect.objectContaining({ file: '/project/src/Button.tsx' }),\n132\t      )\n133\t    })\n134\t\n135\t    it('returns undefined so React Fast Refresh still processes the file', async () => {\n136\t      const ctx = clientEnv()\n137\t      const result = await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n138\t      expect(result).toBeUndefined()\n139\t    })\n140\t\n141\t    it('skips SSR and other non-client environments', async () => {\n142\t      const ctx = { environment: { name: 'ssr', hot: { send: vi.fn() } } }\n143\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n144\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n145\t    })\n146\t\n147\t    it('skips files outside srcDirs', async () => {\n148\t      const ctx = clientEnv()\n149\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/node_modules/react/index.js'))\n150\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n151\t    })\n152\t\n153\t    it('skips non-ts/tsx files inside srcDirs', async () => {\n154\t      const ctx = clientEnv()\n155\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/styles.css'))\n156\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n157\t    })\n158\t\n159\t    it('skips files in a sibling directory that shares the srcDir prefix', async () => {\n160\t      const ctx = clientEnv()\n161\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src-generated/Button.tsx'))\n162\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n163\t    })\n164\t  })\n165\t\n166\t  // ── buildEnd ───────────────────────────────────────────────────────────────\n167\t\n168\t  describe('buildEnd', () => {\n169\t    it('closes the NAPI session', () => {\n170\t      ;(plugin.buildEnd as Function)()\n171\t      expect(napi.closeSession).toHaveBeenCalledWith(42)\n172\t    })\n173\t  })\n174\t\n175\t  // ── buildStart ─────────────────────────────────────────────────────────────\n176\t  //\n177\t  // configureServer (which runs the cold extraction that populates the virtual\n178\t  // module's data) is a dev-server-only hook — Vite never calls it during\n179\t  // `vite build`. Without a build-mode extraction path, a production build's\n180\t  // `virtual:oxc-react-docgen` import always resolved to the empty placeholder\n181\t  // stats/components declared at plugin construction time.\n182\t\n183\t  describe('buildStart', () => {\n184\t    it('runs cold extraction when the command is \"build\"', async () => {\n185\t      ;(plugin.configResolved as Function)({ root: '/project', command: 'build' })\n186\t      await (plugin.buildStart as Function)()\n187\t      expect(napi.initializeSession).toHaveBeenCalledWith(42, expect.objectContaining({ srcDirs: ['/project/src'] }))\n188\t      const code = (plugin.load as Function)('\\0virtual:oxc-react-docgen') as string\n189\t      expect(code).toMatch(/^export default \\{/)\n190\t    })\n191\t\n192\t    it('does not run cold extraction when the command is \"serve\" (configureServer handles it)', async () => {\n\n... [22 lines truncated] ..."},"type":"attachment","uuid":"b11e295d-6466-4bb1-88d2-a114158960d3","timestamp":"2026-07-24T22:16:10.415Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
