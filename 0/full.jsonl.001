{"parentUuid":"691b8e45-132c-4d06-a801-f6a07a11f6fd","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FL2nVoSiVMNjsLGrhXMMqM","type":"tool_result","content":"1\t//! Component detection: FC annotation, forwardRef, HOC-wrapped, ForwardRefExoticComponent.\n2\t\n3\tuse std::collections::BTreeMap;\n4\t\n5\tuse oxc_ast::ast::*;\n6\t\n7\tuse crate::types::ComponentMapping;\n8\t\n9\tuse super::{is_pascal_case, SourceDataCollector};\n10\t\n11\t/// Peel any wrapping `as X` casts down to the real expression underneath.\n12\t/// Needed because component libraries commonly cast a forwardRef/HOC call to a\n13\t/// hand-rolled wrapper type instead of relying on `@types/react`'s own generics\n14\t/// (Fluent UI's own source notes this is \"required due to lack of distributive\n15\t/// union to support unions on @types/react\").\n16\tfn unwrap_as_expression<'a, 'b>(expr: &'b Expression<'a>) -> &'b Expression<'a> {\n17\t    let mut expr = expr;\n18\t    while let Expression::TSAsExpression(as_expr) = expr {\n19\t        expr = &as_expr.expression;\n20\t    }\n21\t    expr\n22\t}\n23\t\n24\timpl<'src> SourceDataCollector<'src> {\n25\t    // ─── Component detection helpers ──────────────────────────────────────────\n26\t\n27\t    /// Try to extract a PascalCase name from a VariableDeclarator's binding.\n28\t    pub(super) fn extract_pascal_name<'a>(&self, decl: &VariableDeclarator<'a>) -> Option<String> {\n29\t        match &decl.id {\n30\t            BindingPattern::BindingIdentifier(id) => {\n31\t                let name = id.name.as_str();\n32\t                if is_pascal_case(name) {\n33\t                    Some(name.to_owned())\n34\t                } else {\n35\t                    None\n36\t                }\n37\t            }\n38\t            _ => None,\n39\t        }\n40\t    }"}]},"uuid":"8a53ba5a-759b-4f08-ab32-00c8bed8e8cd","timestamp":"2026-07-22T21:06:47.880Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/extractor/component.rs","content":"//! Component detection: FC annotation, forwardRef, HOC-wrapped, ForwardRefExoticComponent.\n\nuse std::collections::BTreeMap;\n\nuse oxc_ast::ast::*;\n\nuse crate::types::ComponentMapping;\n\nuse super::{is_pascal_case, SourceDataCollector};\n\n/// Peel any wrapping `as X` casts down to the real expression underneath.\n/// Needed because component libraries commonly cast a forwardRef/HOC call to a\n/// hand-rolled wrapper type instead of relying on `@types/react`'s own generics\n/// (Fluent UI's own source notes this is \"required due to lack of distributive\n/// union to support unions on @types/react\").\nfn unwrap_as_expression<'a, 'b>(expr: &'b Expression<'a>) -> &'b Expression<'a> {\n    let mut expr = expr;\n    while let Expression::TSAsExpression(as_expr) = expr {\n        expr = &as_expr.expression;\n    }\n    expr\n}\n\nimpl<'src> SourceDataCollector<'src> {\n    // ─── Component detection helpers ──────────────────────────────────────────\n\n    /// Try to extract a PascalCase name from a VariableDeclarator's binding.\n    pub(super) fn extract_pascal_name<'a>(&self, decl: &VariableDeclarator<'a>) -> Option<String> {\n        match &decl.id {\n            BindingPattern::BindingIdentifier(id) => {\n                let name = id.name.as_str();\n                if is_pascal_case(name) {\n                    Some(name.to_owned())\n                } else {\n                    None\n                }\n            }\n            _ => None,\n        }\n    }","numLines":40,"startLine":1,"totalLines":341}},"sourceToolAssistantUUID":"691b8e45-132c-4d06-a801-f6a07a11f6fd","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
