ec<String>>,\n42\t    pub vanilla_extract: Option<bool>,\n43\t    pub cache_dir: Option<String>,\n44\t    pub resolve_complex_types: Option<bool>,\n45\t    // Complex fields accepted as JSON strings to avoid napi object complexity:\n46\t    /// JSON: Record<string, string[]>\n47\t    pub extra_paths_json: Option<String>,\n48\t    /// JSON: Record<string, {kind: ...}>\n49\t    pub known_type_overrides_json: Option<String>,\n50\t}\n51\t\n52\t// ─── From<JsExtractOptions> for PipelineOptions ───────────────────────────────\n53\t\n54\timpl From<JsExtractOptions> for PipelineOptions {\n55\t    fn from(js: JsExtractOptions) -> Self {\n56\t        use compact_str::CompactString;\n57\t\n58\t        let extra_builtins: rustc_hash::FxHashSet<CompactString> =\n59\t            js.extra_builtins.unwrap_or_default().into_iter().map(CompactString::from).collect();\n60\t\n61\t        let extra_paths: rustc_hash::FxHashMap<String, Vec<camino::Utf8PathBuf>> = js\n62\t            .extra_paths_json\n63\t            .and_then(|s| serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&s).ok())\n64\t            .map(|map| {\n65\t                map.into_iter()\n66\t                    .filter_map(|(k, v)| {\n67\t                        let paths: Vec<camino::Utf8PathBuf> =\n68\t                            v.as_array()?.iter().filter_map(|p| p.as_str()).map(camino::Utf8PathBuf::from).collect();\n69\t                        Some((k, paths))\n70\t                    })\n71\t                    .collect()\n72\t            })\n73\t            .unwrap_or_default();\n74\t\n75\t        let known_type_overrides: rustc_hash::FxHashMap<String, oxc_react_docgen_core::pipeline::KnownTypeOverride> =\n76\t            js.known_type_overrides_json.and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default();\n77\t\n78\t        PipelineOptions {\n79\t            src_dirs: js.src_dirs.into_iter().map(Into::into).collect(),\n80\t            exclude_patterns: js.exclude.unwrap_or_default(),\n81\t            react_version: match js.react_version.as_deref() {\n82\t                Some(\"react18\") => oxc_react_docgen_core::react_types::REACT_18,\n83\t                _ => oxc_react_docgen_core::react_types::REACT_19,\n84\t            },\n85\t            cross_package: js.cross_package.unwrap_or(true),\n86\t            pandacss_outdir: js.pandacss_outdir.map(Into::into),\n87\t            variant_functions: js\n88\t                .variant_functions\n89\t                .unwrap_or_else(|| vec![\"cva\".into(), \"tv\".into(), \"defineRecipe\".into(), \"recipe\".into()]),\n90\t            html_attributes: match js.html_attributes.as_deref() {\n91\t                Some(\"full\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Full,\n92\t                Some(\"none\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::None,\n93\t                _ => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Curated,\n94\t            },\n95\t            tsconfig_path: js.tsconfig_path.map(Into::into),\n96\t            extra_paths,\n97\t            known_type_overrides,\n98\t            extra_builtins,\n99\t            vanilla_extract: js.vanilla_extract.unwrap_or(false),\n100\t            cache_dir: js.cache_dir.map(Into::into),"}]},"uuid":"ae2f4e8a-31eb-40b2-8aa4-9292fe895bed","timestamp":"2026-07-22T20:26:21.359Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/binding/src/lib.rs","content":"use std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Arc, LazyLock};\n\nuse camino::Utf8Path;\nuse dashmap::DashMap;\nuse napi_derive::napi;\n\nuse oxc_react_docgen_core::pipeline::{\n    extraction_output_to_json, incremental_update_to_json, PipelineOptions, WatchSession,\n};\n\n// ─── Session store ────────────────────────────────────────────────────────────\n\nstatic SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>> = LazyLock::new(DashMap::new);\nstatic NEXT_SESSION_ID: AtomicU64 = AtomicU64::new(0);\n\nfn next_session_id() -> u32 {\n    let pid = std::process::id() as u64;\n    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\n    // Combine pid (upper 16 bits) with counter (lower 16 bits) into u32.\n    // This avoids collisions across concurrent Vite dev server instances.\n    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\n}\n\n// ─── JsExtractOptions ─────────────────────────────────────────────────────────\n\n/// Options passed from TypeScript — flat struct for easy NAPI marshalling.\n#[napi(object)]\npub struct JsExtractOptions {\n    pub src_dirs: Vec<String>,\n    pub exclude: Option<Vec<String>>,\n    #[napi(ts_type = \"'react18' | 'react19'\")]\n    pub react_version: Option<String>,\n    pub cross_package: Option<bool>,\n    pub pandacss_outdir: Option<String>,\n    pub variant_functions: Option<Vec<String>>,\n    #[napi(ts_type = \"'curated' | 'full' | 'none'\")]\n    pub html_attributes: Option<String>,\n    // Fields from architectural review:\n    pub tsconfig_path: Option<String>,\n    pub extra_builtins: Option<Vec<String>>,\n    pub vanilla_extract: Option<bool>,\n    pub cache_dir: Option<String>,\n    pub resolve_complex_types: Option<bool>,\n    // Complex fields accepted as JSON strings to avoid napi object complexity:\n    /// JSON: Record<string, string[]>\n    pub extra_paths_json: Option<String>,\n    /// JSON: Record<string, {kind: ...}>\n    pub known_type_overrides_json: Option<String>,\n}\n\n// ─── From<JsExtractOptions> for PipelineOptions ───────────────────────────────\n\nimpl From<JsExtractOptions> for PipelineOptions {\n    fn from(js: JsExtractOptions) -> Self {\n        use compact_str::CompactString;\n\n        let extra_builtins: rustc_hash::FxHashSet<CompactString> =\n            js.extra_builtins.unwrap_or_default().into_iter().map(CompactString::from).collect();\n\n        let extra_paths: rustc_hash::FxHashMap<String, Vec<camino::Utf8PathBuf>> = js\n            .extra_paths_json\n            .and_then(|s| serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&s).ok())\n            .map(|map| {\n                map.into_iter()\n                    .filter_map(|(k, v)| {\n                        let paths: Vec<camino::Utf8PathBuf> =\n                            v.as_array()?.iter().filter_map(|p| p.as_str()).map(camino::Utf8PathBuf::from).collect();\n                        Some((k, paths))\n                    })\n                    .collect()\n            })\n            .unwrap_or_default();\n\n        let known_type_overrides: rustc_hash::FxHashMap<String, oxc_react_docgen_core::pipeline::KnownTypeOverride> =\n            js.known_type_overrides_json.and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default();\n\n        PipelineOptions {\n            src_dirs: js.src_dirs.into_iter().map(Into::into).collect(),\n            exclude_patterns: js.exclude.unwrap_or_default(),\n            react_version: match js.react_version.as_deref() {\n                Some(\"react18\") => oxc_react_docgen_core::react_types::REACT_18,\n                _ => oxc_react_docgen_core::react_types::REACT_19,\n            },\n            cross_package: js.cross_package.unwrap_or(true),\n            pandacss_outdir: js.pandacss_outdir.map(Into::into),\n            variant_functions: js\n                .variant_functions\n                .unwrap_or_else(|| vec![\"cva\".into(), \"tv\".into(), \"defineRecipe\".into(), \"recipe\".into()]),\n            html_attributes: match js.html_attributes.as_deref() {\n                Some(\"full\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Full,\n                Some(\"none\") => oxc_react_docgen_core::pipeline::HtmlAttributeMode::None,\n                _ => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Curated,\n            },\n            tsconfig_path: js.tsconfig_path.map(Into::into),\n            extra_paths,\n            known_type_overrides,\n            extra_builtins,\n            vanilla_extract: js.vanilla_extract.unwrap_or(false),\n            cache_dir: js.cache_dir.map(Into::into),","numLines":100,"startLine":1,"totalLines":182}},"sourceToolAssistantUUID":"c9dba211-4555-47f7-aff6-1f077a01679a","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
