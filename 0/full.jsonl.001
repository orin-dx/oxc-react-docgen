{"parentUuid":"76a489af-bd73-4b4d-ad8f-b6a17d9e1d93","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013g2mEM7xwwq1CZpurmRE18","type":"tool_result","content":"1\timport { describe, it, expect, vi, beforeEach } from 'vitest'\n2\t\n3\t// Mock BEFORE importing plugin — vi.mock is hoisted by Vitest\n4\tvi.mock('@oxc-react-docgen/napi', () => ({\n5\t  createSession: vi.fn().mockReturnValue(42),\n6\t  initializeSession: vi.fn().mockResolvedValue(\n7\t    JSON.stringify({ components: {}, enums: {}, diagnostics: [], stats: {} })\n8\t  ),\n9\t  extractFileIncremental: vi.fn().mockResolvedValue(\n10\t    JSON.stringify({\n11\t      updatedComponents: [{ displayName: 'Button', filePath: '/project/src/Button.tsx', props: {}, inheritance: [], notableInherited: {}, description: '', discriminantProp: null, composes: [], tags: {}, methods: [] }],\n12\t      affectedFiles: ['/project/src/Button.tsx'],\n13\t      diagnostics: [],\n14\t      durationMs: 5,\n15\t    })\n16\t  ),\n17\t  closeSession: vi.fn(),\n18\t}))\n19\t\n20\timport { oxcReactDocgen } from '../../src/index.js'\n21\timport * as napi from '@oxc-react-docgen/napi'\n22\t\n23\tdescribe('oxcReactDocgen', () => {\n24\t  let plugin: ReturnType<typeof oxcReactDocgen>\n25\t\n26\t  beforeEach(() => {\n27\t    vi.clearAllMocks()\n28\t    plugin = oxcReactDocgen({ srcDirs: ['src'] })\n29\t    // Simulate Vite calling configResolved\n30\t    ;(plugin.configResolved as Function)({ root: '/project' })\n31\t  })\n32\t\n33\t  // ── resolveId ──────────────────────────────────────────────────────────────\n34\t\n35\t  describe('resolveId', () => {\n36\t    it('resolves the virtual module id', () => {\n37\t      const result = (plugin.resolveId as Function)('virtual:oxc-react-docgen')\n38\t      expect(result).toBe('\\0virtual:oxc-react-docgen')\n39\t    })\n40\t\n41\t    it('returns undefined for unrelated ids', () => {\n42\t      expect((plugin.resolveId as Function)('react')).toBeUndefined()\n43\t      expect((plugin.resolveId as Function)('./Button.tsx')).toBeUndefined()\n44\t    })\n45\t  })\n46\t\n47\t  // ── load ───────────────────────────────────────────────────────────────────\n48\t\n49\t  describe('load', () => {\n50\t    it('returns a JS module for the resolved virtual id', () => {\n51\t      const code = (plugin.load as Function)('\\0virtual:oxc-react-docgen') as string\n52\t      expect(code).toMatch(/^export default \\{/)\n53\t      const data = JSON.parse(code.replace('export default ', ''))\n54\t      expect(data).toHaveProperty('components')\n55\t    })\n56\t\n57\t    it('returns undefined for other ids', () => {\n58\t      expect((plugin.load as Function)('\\0other')).toBeUndefined()\n59\t      expect((plugin.load as Function)('virtual:oxc-react-docgen')).toBeUndefined()\n60\t    })\n61\t  })\n62\t\n63\t  // ── configResolved ─────────────────────────────────────────────────────────\n64\t\n65\t  describe('configResolved', () => {\n66\t    it('creates a NAPI session with resolved absolute src dirs', () => {\n67\t      expect(napi.createSession).toHaveBeenCalledWith(\n68\t        expect.objectContaining({ srcDirs: ['/project/src'] })\n69\t      )\n70\t    })\n71\t  })\n72\t\n73\t  // ── configureServer ────────────────────────────────────────────────────────\n74\t\n75\t  describe('configureServer', () => {\n76\t    it('calls initializeSession with the session id and resolved options', async () => {\n77\t      const mockServer = {\n78\t        environments: { client: { hot: { send: vi.fn() } } },\n79\t      } as any\n80\t      // configureServer returns a teardown fn; initializeSession is async internally.\n81\t      // Flush the microtask queue so the .then() callback runs before asserting.\n82\t      ;(plugin.configureServer as Function)(mockServer)\n83\t      await vi.waitUntil(() => (napi.initializeSession as any).mock.calls.length > 0)\n84\t      await (napi.initializeSession as any).mock.results[0].value\n85\t      expect(napi.initializeSession).toHaveBeenCalledWith(\n86\t        42,\n87\t        expect.objectContaining({ srcDirs: ['/project/src'] })\n88\t      )\n89\t    })\n90\t  })\n91\t\n92\t  // ── hotUpdate ──────────────────────────────────────────────────────────────\n93\t\n94\t  describe('hotUpdate', () => {\n95\t    const clientEnv = () => ({\n96\t      environment: { name: 'client', hot: { send: vi.fn() } },\n97\t    })\n98\t\n99\t    const makeOpts = (file: string) => ({\n100\t      file,\n101\t      type: 'update' as const,\n102\t      modules: [],\n103\t      timestamp: 1000,\n104\t      read: vi.fn().mockResolvedValue(''),\n105\t      server: {} as any,\n106\t    })\n107\t\n108\t    it('calls extractFileIncremental for tsx files in srcDirs', async () => {\n109\t      const ctx = clientEnv()\n110\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n111\t      expect(napi.extractFileIncremental).toHaveBeenCalledWith(\n112\t        '/project/src/Button.tsx',\n113\t        42,\n114\t        expect.objectContaining({ srcDirs: ['/project/src'] })\n115\t      )\n116\t    })\n117\t\n118\t    it('sends oxc-react-docgen:update over HMR', async () => {\n119\t      const ctx = clientEnv()\n120\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n121\t      expect(ctx.environment.hot.send).toHaveBeenCalledWith(\n122\t        'oxc-react-docgen:update',\n123\t        expect.objectContaining({ file: '/project/src/Button.tsx' })\n124\t      )\n125\t    })\n126\t\n127\t    it('returns undefined so React Fast Refresh still processes the file', async () => {\n128\t      const ctx = clientEnv()\n129\t      const result = await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n130\t      expect(result).toBeUndefined()\n131\t    })\n132\t\n133\t    it('skips SSR and other non-client environments', async () => {\n134\t      const ctx = { environment: { name: 'ssr', hot: { send: vi.fn() } } }\n135\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n136\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n137\t    })\n138\t\n139\t    it('skips files outside srcDirs', async () => {\n140\t      const ctx = clientEnv()\n141\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/node_modules/react/index.js'))\n142\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n143\t    })\n144\t\n145\t    it('skips non-ts/tsx files inside srcDirs', async () => {\n146\t      const ctx = clientEnv()\n147\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/styles.css'))\n148\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n149\t    })\n150\t\n151\t    it('skips files in a sibling directory that shares the srcDir prefix', async () => {\n152\t      const ctx = clientEnv()\n153\t      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src-generated/Button.tsx'))\n154\t      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n155\t    })\n156\t  })\n157\t\n158\t  // ── buildEnd ───────────────────────────────────────────────────────────────\n159\t\n160\t  describe('buildEnd', () => {\n161\t    it('closes the NAPI session', () => {\n162\t      ;(plugin.buildEnd as Function)()\n163\t      expect(napi.closeSession).toHaveBeenCalledWith(42)\n164\t    })\n165\t  })\n166\t})\n167\t"}]},"uuid":"9a9299e1-889f-44d5-97a4-7421666a87e9","timestamp":"2026-07-22T21:11:58.672Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/packages/vite-plugin/tests/unit/plugin.test.ts","content":"import { describe, it, expect, vi, beforeEach } from 'vitest'\n\n// Mock BEFORE importing plugin — vi.mock is hoisted by Vitest\nvi.mock('@oxc-react-docgen/napi', () => ({\n  createSession: vi.fn().mockReturnValue(42),\n  initializeSession: vi.fn().mockResolvedValue(\n    JSON.stringify({ components: {}, enums: {}, diagnostics: [], stats: {} })\n  ),\n  extractFileIncremental: vi.fn().mockResolvedValue(\n    JSON.stringify({\n      updatedComponents: [{ displayName: 'Button', filePath: '/project/src/Button.tsx', props: {}, inheritance: [], notableInherited: {}, description: '', discriminantProp: null, composes: [], tags: {}, methods: [] }],\n      affectedFiles: ['/project/src/Button.tsx'],\n      diagnostics: [],\n      durationMs: 5,\n    })\n  ),\n  closeSession: vi.fn(),\n}))\n\nimport { oxcReactDocgen } from '../../src/index.js'\nimport * as napi from '@oxc-react-docgen/napi'\n\ndescribe('oxcReactDocgen', () => {\n  let plugin: ReturnType<typeof oxcReactDocgen>\n\n  beforeEach(() => {\n    vi.clearAllMocks()\n    plugin = oxcReactDocgen({ srcDirs: ['src'] })\n    // Simulate Vite calling configResolved\n    ;(plugin.configResolved as Function)({ root: '/project' })\n  })\n\n  // ── resolveId ──────────────────────────────────────────────────────────────\n\n  describe('resolveId', () => {\n    it('resolves the virtual module id', () => {\n      const result = (plugin.resolveId as Function)('virtual:oxc-react-docgen')\n      expect(result).toBe('\\0virtual:oxc-react-docgen')\n    })\n\n    it('returns undefined for unrelated ids', () => {\n      expect((plugin.resolveId as Function)('react')).toBeUndefined()\n      expect((plugin.resolveId as Function)('./Button.tsx')).toBeUndefined()\n    })\n  })\n\n  // ── load ───────────────────────────────────────────────────────────────────\n\n  describe('load', () => {\n    it('returns a JS module for the resolved virtual id', () => {\n      const code = (plugin.load as Function)('\\0virtual:oxc-react-docgen') as string\n      expect(code).toMatch(/^export default \\{/)\n      const data = JSON.parse(code.replace('export default ', ''))\n      expect(data).toHaveProperty('components')\n    })\n\n    it('returns undefined for other ids', () => {\n      expect((plugin.load as Function)('\\0other')).toBeUndefined()\n      expect((plugin.load as Function)('virtual:oxc-react-docgen')).toBeUndefined()\n    })\n  })\n\n  // ── configResolved ─────────────────────────────────────────────────────────\n\n  describe('configResolved', () => {\n    it('creates a NAPI session with resolved absolute src dirs', () => {\n      expect(napi.createSession).toHaveBeenCalledWith(\n        expect.objectContaining({ srcDirs: ['/project/src'] })\n      )\n    })\n  })\n\n  // ── configureServer ────────────────────────────────────────────────────────\n\n  describe('configureServer', () => {\n    it('calls initializeSession with the session id and resolved options', async () => {\n      const mockServer = {\n        environments: { client: { hot: { send: vi.fn() } } },\n      } as any\n      // configureServer returns a teardown fn; initializeSession is async internally.\n      // Flush the microtask queue so the .then() callback runs before asserting.\n      ;(plugin.configureServer as Function)(mockServer)\n      await vi.waitUntil(() => (napi.initializeSession as any).mock.calls.length > 0)\n      await (napi.initializeSession as any).mock.results[0].value\n      expect(napi.initializeSession).toHaveBeenCalledWith(\n        42,\n        expect.objectContaining({ srcDirs: ['/project/src'] })\n      )\n    })\n  })\n\n  // ── hotUpdate ──────────────────────────────────────────────────────────────\n\n  describe('hotUpdate', () => {\n    const clientEnv = () => ({\n      environment: { name: 'client', hot: { send: vi.fn() } },\n    })\n\n    const makeOpts = (file: string) => ({\n      file,\n      type: 'update' as const,\n      modules: [],\n      timestamp: 1000,\n      read: vi.fn().mockResolvedValue(''),\n      server: {} as any,\n    })\n\n    it('calls extractFileIncremental for tsx files in srcDirs', async () => {\n      const ctx = clientEnv()\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n      expect(napi.extractFileIncremental).toHaveBeenCalledWith(\n        '/project/src/Button.tsx',\n        42,\n        expect.objectContaining({ srcDirs: ['/project/src'] })\n      )\n    })\n\n    it('sends oxc-react-docgen:update over HMR', async () => {\n      const ctx = clientEnv()\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n      expect(ctx.environment.hot.send).toHaveBeenCalledWith(\n        'oxc-react-docgen:update',\n        expect.objectContaining({ file: '/project/src/Button.tsx' })\n      )\n    })\n\n    it('returns undefined so React Fast Refresh still processes the file', async () => {\n      const ctx = clientEnv()\n      const result = await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n      expect(result).toBeUndefined()\n    })\n\n    it('skips SSR and other non-client environments', async () => {\n      const ctx = { environment: { name: 'ssr', hot: { send: vi.fn() } } }\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/Button.tsx'))\n      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n    })\n\n    it('skips files outside srcDirs', async () => {\n      const ctx = clientEnv()\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/node_modules/react/index.js'))\n      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n    })\n\n    it('skips non-ts/tsx files inside srcDirs', async () => {\n      const ctx = clientEnv()\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src/styles.css'))\n      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n    })\n\n    it('skips files in a sibling directory that shares the srcDir prefix', async () => {\n      const ctx = clientEnv()\n      await (plugin.hotUpdate as Function).call(ctx, makeOpts('/project/src-generated/Button.tsx'))\n      expect(napi.extractFileIncremental).not.toHaveBeenCalled()\n    })\n  })\n\n  // ── buildEnd ───────────────────────────────────────────────────────────────\n\n  describe('buildEnd', () => {\n    it('closes the NAPI session', () => {\n      ;(plugin.buildEnd as Function)()\n      expect(napi.closeSession).toHaveBeenCalledWith(42)\n    })\n  })\n})\n","numLines":167,"startLine":1,"totalLines":167}},"sourceToolAssistantUUID":"76a489af-bd73-4b4d-ad8f-b6a17d9e1d93","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
