_global_files: std::sync::OnceLock<Vec<Utf8PathBuf>>,\n    /// Guards initialize() so concurrent callers don't race to build caches.\n    initialized: Mutex<bool>,\n}\n\nimpl WatchSession {\n    /// Create an empty WatchSession (call `initialize()` before first use).\n    pub fn new(options: PipelineOptions) -> Self {\n        Self {\n            options,\n            global: ArcSwap::new(Arc::new(GlobalSourceData::default())),\n            reverse_deps: ArcSwap::new(Arc::new(ReverseDeps { inner: Default::default() })),\n            source_cache: DashMap::new(),\n            component_cache: DashMap::new(),\n            diagnostics: DashMap::new(),\n            ambient_global_files: std::sync::OnceLock::new(),\n            initialized: Mutex::new(false),\n        }\n    }"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1163,"cache_read_input_tokens":751288,"output_tokens":2390,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1163,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2390,"cache_read_input_tokens":751288,"cache_creation_input_tokens":1163,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1163},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdHhJTYoSsJ15XuRvJj28","type":"assistant","uuid":"2bef2912-9bfa-4444-af21-d05dfac7553e","timestamp":"2026-07-22T20:04:52.446Z","effort":"xhigh","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
