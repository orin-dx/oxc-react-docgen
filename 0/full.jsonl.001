{"parentUuid":"debcf10b-6650-4419-a8ef-3379f63719f4","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GEX8edjuocz715eBNmf62t","type":"tool_result","content":"1\t//! DTS cache — persists parsed `SourceData` across runs to avoid re-parsing unchanged .d.ts files.\n2\t//!\n3\t//! Cache validity is based on file size + mtime (nanosecond resolution).\n4\t//! Schema version bumps automatically invalidate the entire cache.\n5\t//!\n6\t//! The cache never panics — all I/O errors are silently swallowed and the cache\n7\t//! degrades gracefully to an empty state.\n8\t\n9\tuse camino::{Utf8Path, Utf8PathBuf};\n10\tuse dashmap::DashMap;\n11\tuse serde::{Deserialize, Serialize};\n12\tuse std::time::SystemTime;\n13\t\n14\tuse crate::types::SourceData;\n15\t\n16\t/// Bump this whenever `SourceData` format changes in a breaking way.\n17\tconst CACHE_SCHEMA_VERSION: u32 = 1;\n18\t\n19\t// ─── Internal key type ────────────────────────────────────────────────────────\n20\t"}]},"uuid":"6c55f974-a813-48fe-bf1e-f326922fd174","timestamp":"2026-07-22T20:31:39.436Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/cache.rs","content":"//! DTS cache — persists parsed `SourceData` across runs to avoid re-parsing unchanged .d.ts files.\n//!\n//! Cache validity is based on file size + mtime (nanosecond resolution).\n//! Schema version bumps automatically invalidate the entire cache.\n//!\n//! The cache never panics — all I/O errors are silently swallowed and the cache\n//! degrades gracefully to an empty state.\n\nuse camino::{Utf8Path, Utf8PathBuf};\nuse dashmap::DashMap;\nuse serde::{Deserialize, Serialize};\nuse std::time::SystemTime;\n\nuse crate::types::SourceData;\n\n/// Bump this whenever `SourceData` format changes in a breaking way.\nconst CACHE_SCHEMA_VERSION: u32 = 1;\n\n// ─── Internal key type ────────────────────────────────────────────────────────\n","numLines":20,"startLine":1,"totalLines":289}},"sourceToolAssistantUUID":"debcf10b-6650-4419-a8ef-3379f63719f4","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
