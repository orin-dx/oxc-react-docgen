e_type_alias_chain(&alias, consuming_file, mapping, ctx, state, depth);\n    }\n\n    // ── Step 5: Interface ─────────────────────────────────────────────────────\n    if let Some(iface) = lookup_interface(&ctx.global, canonical_file.as_str(), &canonical_name).cloned() {\n        return resolve_interface_chain(&iface, type_args, consuming_file, mapping, ctx, state, depth);\n    }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"2ba165c1-9b5a-417e-8add-7f9d2f42f2bf","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
