),","+        }","     }"," ","+    // Must run regardless of --json — this is the one thing CI actually","+    // depends on the exit code for.","     if output.diagnostics.iter().any(|d| matches!(d.severity, oxc_react_docgen_core::types::DiagnosticSeverity::Error))","     {","         std::process::exit(2);"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"79427395-7047-4a89-9fdb-670b14ef08ad","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
