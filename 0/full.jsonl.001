{"parentUuid":"499dc241-b778-4521-b52d-64cbd1e0230c","isSidechain":false,"promptId":"0cb60a71-2d64-41e9-8fe3-12f3a2549892","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UsbuQsvrMRyPY9NgY3XCnw","type":"tool_result","content":"40\t  if (r_rdg?.error) console.log(`  ❌ react-docgen: ${r_rdg.error.slice(0, 100)}`)\n41\t  if (r_rdt?.error) console.log(`  ❌ react-docgen-typescript: ${r_rdt.error.slice(0, 100)}`)\n42\t  if (r_ours?.error) console.log(`  ❌ oxc-react-docgen: ${r_ours.error.slice(0, 100)}`)\n43\t\n44\t  // Timing\n45\t  const times: string[] = []\n46\t  if (r_rdg) times.push(`rdg: ${r_rdg.durationMs.toFixed(1)}ms`)\n47\t  if (r_rdt) times.push(`rdt: ${r_rdt.durationMs.toFixed(1)}ms`)\n48\t  if (r_ours) times.push(`ours: ${r_ours.durationMs.toFixed(1)}ms`)\n49\t  if (times.length > 0) console.log(`  ⏱  ${times.join('  |  ')}`)\n50\t\n51\t  // Components per tool\n52\t  const rdgComps = Object.keys(r_rdg?.output ?? {})\n53\t  const rdtComps = Object.keys(r_rdt?.output ?? {})\n54\t  const oursComps = Object.keys(r_ours?.output ?? {})\n55\t  const allComps = new Set([...rdgComps, ...rdtComps, ...oursComps])\n56\t\n57\t  for (const comp of [...allComps].toSorted()) {\n58\t    const rdgProps = Object.keys(r_rdg?.output?.[comp]?.props ?? {})\n59\t    const rdtProps = Object.keys(r_rdt?.output?.[comp]?.props ?? {})\n60\t    const oursProps = Object.keys(r_ours?.output?.[comp]?.props ?? {})\n61\t\n62\t    console.log(`\\n  ### ${comp}`)\n63\t    console.log(`    props: rdg=${rdgProps.length}  rdt=${rdtProps.length}  ours=${oursProps.length}`)\n64\t\n65\t    rdtTotal += rdtProps.length\n66\t    oursTotal += oursProps.length\n67\t\n68\t    // Props ours has that rdt doesn't\n69\t    const oursOnly = oursProps.filter((p) => !rdtProps.includes(p))\n70\t    const rdtOnly = rdtProps.filter((p) => !oursProps.includes(p))\n71\t    const rdgOnly = rdgProps.filter((p) => !oursProps.includes(p))\n72\t    const common = oursProps.filter((p) => rdtProps.