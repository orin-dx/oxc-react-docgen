{"parentUuid":"262662c7-bbf7-4a4c-bd5c-7f867bd30e38","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdHkgu8tkbWZFFzgaDHZ2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TAiR4j6Dk57rbcPxv7gvWs","name":"Read","input":{"file_path":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/import_map.rs"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3271,"cache_read_input_tokens":138395,"output_tokens":892,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3271,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":892,"cache_read_input_tokens":138395,"cache_creation_input_tokens":3271,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3271},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdHkgqhWtrkp9bzea2qoX","type":"assistant","uuid":"48ce285c-4eda-4297-8a07-5b968e707167","timestamp":"2026-07-22T20:49:06.276Z","effort":"xhigh","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"48ce285c-4eda-4297-8a07-5b968e707167","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TAiR4j6Dk57rbcPxv7gvWs","type":"tool_result","content":"1\t//! Import resolution map — built from `GlobalSourceData`, used read-only during resolution.\n2\t//!\n3\t//! Answers the question: \"in file F, the name N was imported — what specifier and\n4\t//! canonical name does it refer to?\"  Actual path resolution (specifier → absolute\n5\t//! path) is left to the caller via `oxc_resolver`.\n6\t\n7\tuse camino::{Utf8Path, Utf8PathBuf};\n8\tuse compact_str::CompactString;\n9\tuse rustc_hash::FxHashMap;\n10\t\n11\tuse crate::types::{GlobalSourceData, LexedExport};\n12\t\n13\t// ─── Public Types ─────────────────────────────────────────────────────────────\n14\t\n15\t/// Where an imported name comes from, as written in the source.\n16\t#[derive(Debug, Clone)]\n17\tpub struct ImportRef {\n18\t    /// The import specifier as written: `\"@radix-ui/react-button\"`, `\"./types\"`, etc.\n19\t    pub specifier: String,\n20\t    /// The exported name in the source module (original name before `as` rename).\n21\t    pub exported_name: CompactString,\n22\t    /// `true` for `import type { ... }` bindings.\n23\t    #[allow(dead_code)]\n24\t    pub is_type_only: bool,\n25\t}\n26\t\n27\t/// Result of walking one step of a re-export chain.\n28\t#[allow(dead_code)]\n29\t#[derive(Debug, Clone)]\n30\tpub enum ReExportStep {\n31\t    /// Found a named re-export — caller resolves `source_specifier` to a file and recurses.\n32\t    Named { source_specifier: String, source_name: String },\n33\t    /// Found one or more `export * from \"...\"` entries — caller checks each.\n34\t    Wildcards(Vec<String>),\n35\t}\n36\t\n37\t// ─── ImportResolutionMap ──────────────────────────────────────────────────────\n38\t\n39\t/// Maps `(consuming_file, local_name)` → import reference.\n40\t/// Built once from `GlobalSourceData`, then used read-only during parallel resolution.\n41\tpub struct ImportResolutionMap {\n42\t    /// `file_path` → (`local_name` → specifier + original exported name).\n43\t    /// Nested (rather than a flat `(Utf8PathBuf, CompactString)` key) so lookups can\n44\t    /// borrow `&Utf8Path` directly instead of cloning the whole path per call.\n45\t    /// Note: we store the specifier string, not the resolved file path.\n46\t    /// The resolver calls `oxc_resolver` to turn specifiers into absolute paths.\n47\t    bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>>,\n48\t\n49\t    /// `barrel_file` → specifiers it wildcard-re-exports from (`export * from \"...\"`).\n50\t    #[allow(dead_code)]\n51\t    wildcard_sources: FxHashMap<Utf8PathBuf, Vec<String>>,\n52\t}\n53\t\n54\timpl ImportResolutionMap {\n55\t    /// Build from a fully-merged `GlobalSourceData`.\n56\t    /// Called once per extraction run, before parallel resolution starts.\n57\t    ///\n58\t    /// No I/O — pure data transformation.\n59\t    pub fn build(global: &GlobalSourceData) -> Self {\n60\t        let mut bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>> = FxHashMap::default();\n61\t        let mut wildcard_sources: FxHashMap<Utf8PathBuf, Vec<String>> = FxHashMap::default();\n62\t\n63\t        // ── Populate bindings from import_map ──────────────────────────────\n64\t        for (file_path, import_bindings) in &global.import_map {\n65\t            let per_file = bindings.entry(file_path.clone()).or_default();\n66\t            for binding in import_bindings {\n67\t                per_file.insert(\n68\t                    binding.local_name.clone(),\n69\t                    ImportRef {\n70\t                        specifier: binding.specifier.clone(),\n71\t                        exported_name: binding.exported_name.clone(),\n72\t                        is_type_only: binding.is_type_only,\n73\t                    },\n74\t                );\n75\t            }\n76\t        }\n77\t\n78\t        // ── Populate wildcard_sources from re_export_map ──────────────────\n79\t        for (file_path, exports) in &global.re_export_map {\n80\t            for export in exports {\n81\t                if let LexedExport::ReExportAll { source_specifier, .. } = export {\n82\t                    wildcard_sources.entry(file_path.clone()).or_default().push(source_specifier.clone());\n83\t                }\n84\t            }\n85\t        }\n86\t\n87\t        Self { bindings, wildcard_sources }\n88\t    }\n89\t\n90\t    /// Given a file and a local name used in that file, return where it was imported from.\n91\t    ///\n92\t    /// Returns `None` if the name is locally defined (not imported).\n93\t    pub fn find_import(&self, file: &Utf8Path, local_name: &str) -> Option<&ImportRef> {\n94\t        self.bindings.get(file)?.get(local_name)\n95\t    }\n96\t\n97\t    /// Walk one step of the re-export chain for `barrel_file`.\n98\t    ///\n99\t    /// - If a `ReExportNamed` entry matches `exported_name`, returns `Named { .. }`.\n100\t    /// - If no named match is found but there are `ReExportAll` entries, returns `Wildcards(..)`.\n101\t    /// - Returns `None` if the barrel file has no relevant re-exports.\n102\t    #[allow(dead_code)]\n103\t    pub fn resolve_reexport_chain(\n104\t        &self,\n105\t        barrel_file: &Utf8Path,\n106\t        exported_name: &str,\n107\t        global: &GlobalSourceData,\n108\t    ) -> Option<ReExportStep> {\n109\t        let exports = global.re_export_map.get(barrel_file)?;\n110\t\n111\t        let mut wildcard_specifiers: Vec<String> = Vec::new();\n112\t\n113\t        for export in exports {\n114\t            match export {\n115\t                LexedExport::ReExportNamed { local_name, source_name, source_specifier, .. } => {\n116\t                    if local_name == exported_name {\n117\t                        return Some(ReExportStep::Named {\n118\t                            source_specifier: source_specifier.clone(),\n119\t                            source_name: source_name.clone(),\n120\t                        });\n121\t                    }\n122\t                }\n123\t                LexedExport::ReExportAll { source_specifier, .. } => {\n124\t                    wildcard_specifiers.push(source_specifier.clone());\n125\t                }\n126\t                // Namespace re-exports and local declarations are not relevant here.\n127\t                _ => {}\n128\t            }\n129\t        }\n130\t\n131\t        if !wildcard_specifiers.is_empty() {\n132\t            Some(ReExportStep::Wildcards(wildcard_specifiers))\n133\t        } else {\n134\t            None\n135\t        }\n136\t    }\n137\t\n138\t    /// Return the list of specifiers wildcard-re-exported from `barrel_file`.\n139\t    ///\n140\t    /// Returns an empty slice if the file has no `export * from \"...\"` entries.\n141\t    #[allow(dead_code)]\n142\t    pub fn wildcard_sources_for(&self, barrel_file: &Utf8Path) -> &[String] {\n143\t        self.wildcard_sources.get(barrel_file).map(|v| v.as_slice()).unwrap_or(&[])\n144\t    }\n145\t}\n146\t\n147\t// ─── Tests ────────────────────────────────────────────────────────────────────\n148\t\n149\t#[cfg(test)]\n150\tmod tests {\n151\t    use super::*;\n152\t    use crate::types::{GlobalSourceData, ImportBinding, LexedExport};\n153\t    use camino::Utf8PathBuf;\n154\t    use compact_str::CompactString;\n155\t\n156\t    /// Convenience builder for `GlobalSourceData`.\n157\t    fn make_global(\n158\t        imports: Vec<(Utf8PathBuf, Vec<ImportBinding>)>,\n159\t        exports: Vec<(Utf8PathBuf, Vec<LexedExport>)>,\n160\t    ) -> GlobalSourceData {\n161\t        let mut g = GlobalSourceData::default();\n162\t        for (path, bindings) in imports {\n163\t            g.import_map.insert(path, bindings);\n164\t        }\n165\t        for (path, exps) in exports {\n166\t            g.re_export_map.insert(path, exps);\n167\t        }\n168\t        g\n169\t    }\n170\t\n171\t    fn make_binding(local_name: &str, exported_name: &str, specifier: &str, is_type_only: bool) -> ImportBinding {\n172\t        ImportBinding {\n173\t            local_name: CompactString::from(local_name),\n174\t            exported_name: CompactString::from(exported_name),\n175\t            specifier: specifier.to_owned(),\n176\t            is_type_only,\n177\t        }\n178\t    }\n179\t\n180\t    #[test]\n181\t    fn test_named_import_lookup() {\n182\t        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n183\t        let global = make_global(\n184\t            vec![(file.clone(), vec![make_binding(\"ButtonProps\", \"ButtonProps\", \"@radix-ui/react-button\", false)])],\n185\t            vec![],\n186\t        );\n187\t\n188\t        let map = ImportResolutionMap::build(&global);\n189\t\n190\t        let result = map.find_import(&file, \"ButtonProps\").expect(\"should find import\");\n191\t        assert_eq!(result.specifier, \"@radix-ui/react-button\");\n192\t        assert_eq!(result.exported_name.as_str(), \"ButtonProps\");\n193\t        assert!(!result.is_type_only);\n194\t    }\n195\t\n196\t    #[test]\n197\t    fn test_named_import_not_found() {\n198\t        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n199\t        let global = make_global(vec![], vec![]);\n200\t        let map = ImportResolutionMap::build(&global);\n201\t\n202\t        assert!(map.find_import(&file, \"LocalType\").is_none());\n203\t    }\n204\t\n205\t    #[test]\n206\t    fn test_renamed_import() {\n207\t        // import { Button as Btn } from \"@radix-ui/react-button\"\n208\t        let file = Utf8PathBuf::from(\"/project/src/Wrapper.tsx\");\n209\t        let global = make_global(\n210\t            vec![(file.clone(), vec![make_binding(\"Btn\", \"Button\", \"@radix-ui/react-button\", false)])],\n211\t            vec![],\n212\t        );\n213\t\n214\t        let map = ImportResolutionMap::build(&global);\n215\t\n216\t        // Looking up by local alias \"Btn\"\n217\t        let result = map.find_import(&file, \"Btn\").expect(\"should find renamed import\");\n218\t        assert_eq!(result.exported_name.as_str(), \"Button\");\n219\t        assert_eq!(result.specifier, \"@radix-ui/react-button\");\n220\t\n221\t        // Original name \"Button\" is NOT a local binding in this file\n222\t        assert!(map.find_import(&file, \"Button\").is_none());\n223\t    }\n224\t\n225\t    #[test]\n226\t    fn test_reexport_named_chain() {\n227\t        // barrel/index.ts: export { Foo as Bar } from \"./foo\"\n228\t        // Looking up \"Bar\" should return Named { source_name: \"Foo\", source_specifier: \"./foo\" }\n229\t        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n230\t        let global = make_global(\n231\t            vec![],\n232\t            vec![(\n233\t                barrel.clone(),\n234\t                vec![LexedExport::ReExportNamed {\n235\t                    local_name: \"Bar\".to_owned(),\n236\t                    source_name: \"Foo\".to_owned(),\n237\t                    source_specifier: \"./foo\".to_owned(),\n238\t                    is_type_only: false,\n239\t                }],\n240\t            )],\n241\t        );\n242\t\n243\t        let map = ImportResolutionMap::build(&global);\n244\t\n245\t        match map.resolve_reexport_chain(&barrel, \"Bar\", &global) {\n246\t            Some(ReExportStep::Named { source_specifier, source_name }) => {\n247\t                assert_eq!(source_specifier, \"./foo\");\n248\t                assert_eq!(source_name, \"Foo\");\n249\t            }\n250\t            other => panic!(\"expected Named, got {:?}\", other),\n251\t        }\n252\t    }\n253\t\n254\t    #[test]\n255\t    fn test_reexport_named_no_match() {\n256\t        // The barrel exports \"Bar\" but we ask for \"Baz\"\n257\t        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n258\t        let global = make_global(\n259\t            vec![],\n260\t            vec![(\n261\t                barrel.clone(),\n262\t                vec![LexedExport::ReExportNamed {\n263\t                    local_name: \"Bar\".to_owned(),\n264\t                    source_name: \"Foo\".to_owned(),\n265\t                    source_specifier: \"./foo\".to_owned(),\n266\t                    is_type_only: false,\n267\t                }],\n268\t            )],\n269\t        );\n270\t\n271\t        let map = ImportResolutionMap::build(&global);\n272\t        assert!(map.resolve_reexport_chain(&barrel, \"Baz\", &global).is_none());\n273\t    }\n274\t\n275\t    #[test]\n276\t    fn test_reexport_all() {\n277\t        // barrel/index.ts: export * from \"./types\"\n278\t        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n279\t        let global = make_global(\n280\t            vec![],\n281\t            vec![(\n282\t                barrel.clone(),\n283\t                vec![LexedExport::ReExportAll { source_specifier: \"./types\".to_owned(), is_type_only: false }],\n284\t            )],\n285\t        );\n286\t\n287\t        let map = ImportResolutionMap::build(&global);\n288\t\n289\t        // wildcard_sources_for should return [\"./types\"]\n290\t        let wildcards = map.wildcard_sources_for(&barrel);\n291\t        assert_eq!(wildcards, &[\"./types\"]);\n292\t\n293\t        // resolve_reexport_chain for any name should return Wildcards\n294\t        match map.resolve_reexport_chain(&barrel, \"AnyName\", &global) {\n295\t            Some(ReExportStep::Wildcards(specs)) => {\n296\t                assert_eq!(specs, vec![\"./types\"]);\n297\t            }\n298\t            other => panic!(\"expected Wildcards, got {:?}\", other),\n299\t        }\n300\t    }\n301\t\n302\t    #[test]\n303\t    fn test_reexport_named_takes_priority_over_wildcard() {\n304\t        // If a barrel has both a named re-export matching the name AND wildcards,\n305\t        // the named re-export wins (returned first).\n306\t        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n307\t        let global = make_global(\n308\t            vec![],\n309\t            vec![(\n310\t                barrel.clone(),\n311\t                vec![\n312\t                    LexedExport::ReExportAll { source_specifier: \"./everything\".to_owned(), is_type_only: false },\n313\t                    LexedExport::ReExportNamed {\n314\t                        local_name: \"Target\".to_owned(),\n315\t                        source_name: \"Target\".to_owned(),\n316\t                        source_specifier: \"./target\".to_owned(),\n317\t                        is_type_only: false,\n318\t                    },\n319\t                ],\n320\t            )],\n321\t        );\n322\t\n323\t        let map = ImportResolutionMap::build(&global);\n324\t\n325\t        match map.resolve_reexport_chain(&barrel, \"Target\", &global) {\n326\t            Some(ReExportStep::Named { source_specifier, source_name }) => {\n327\t                assert_eq!(source_specifier, \"./target\");\n328\t                assert_eq!(source_name, \"Target\");\n329\t            }\n330\t            other => panic!(\"expected Named, got {:?}\", other),\n331\t        }\n332\t    }\n333\t\n334\t    #[test]\n335\t    fn test_wildcard_sources_empty() {\n336\t        let barrel = Utf8PathBuf::from(\"/project/src/no-wildcards.ts\");\n337\t        let global = make_global(vec![], vec![]);\n338\t        let map = ImportResolutionMap::build(&global);\n339\t\n340\t        assert!(map.wildcard_sources_for(&barrel).is_empty());\n341\t    }\n342\t\n343\t    #[test]\n344\t    fn test_multiple_files() {\n345\t        let file_a = Utf8PathBuf::from(\"/project/src/A.tsx\");\n346\t        let file_b = Utf8PathBuf::from(\"/project/src/B.tsx\");\n347\t        let global = make_global(\n348\t            vec![\n349\t                (file_a.clone(), vec![make_binding(\"Foo\", \"Foo\", \"./foo\", true)]),\n350\t                (file_b.clone(), vec![make_binding(\"Foo\", \"Foo\", \"./other-foo\", false)]),\n351\t            ],\n352\t            vec![],\n353\t        );\n354\t\n355\t        let map = ImportResolutionMap::build(&global);\n356\t\n357\t        let a = map.find_import(&file_a, \"Foo\").expect(\"A should have Foo\");\n358\t        assert_eq!(a.specifier, \"./foo\");\n359\t        assert!(a.is_type_only);\n360\t\n361\t        let b = map.find_import(&file_b, \"Foo\").expect(\"B should have Foo\");\n362\t        assert_eq!(b.specifier, \"./other-foo\");\n363\t        assert!(!b.is_type_only);\n364\t    }\n365\t}\n366\t"}]},"uuid":"d2d5a2af-2e7d-4776-9878-c0263a186b4b","timestamp":"2026-07-22T20:49:06.369Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/import_map.rs","content":"//! Import resolution map — built from `GlobalSourceData`, used read-only during resolution.\n//!\n//! Answers the question: \"in file F, the name N was imported — what specifier and\n//! canonical name does it refer to?\"  Actual path resolution (specifier → absolute\n//! path) is left to the caller via `oxc_resolver`.\n\nuse camino::{Utf8Path, Utf8PathBuf};\nuse compact_str::CompactString;\nuse rustc_hash::FxHashMap;\n\nuse crate::types::{GlobalSourceData, LexedExport};\n\n// ─── Public Types ─────────────────────────────────────────────────────────────\n\n/// Where an imported name comes from, as written in the source.\n#[derive(Debug, Clone)]\npub struct ImportRef {\n    /// The import specifier as written: `\"@radix-ui/react-button\"`, `\"./types\"`, etc.\n    pub specifier: String,\n    /// The exported name in the source module (original name before `as` rename).\n    pub exported_name: CompactString,\n    /// `true` for `import type { ... }` bindings.\n    #[allow(dead_code)]\n    pub is_type_only: bool,\n}\n\n/// Result of walking one step of a re-export chain.\n#[allow(dead_code)]\n#[derive(Debug, Clone)]\npub enum ReExportStep {\n    /// Found a named re-export — caller resolves `source_specifier` to a file and recurses.\n    Named { source_specifier: String, source_name: String },\n    /// Found one or more `export * from \"...\"` entries — caller checks each.\n    Wildcards(Vec<String>),\n}\n\n// ─── ImportResolutionMap ──────────────────────────────────────────────────────\n\n/// Maps `(consuming_file, local_name)` → import reference.\n/// Built once from `GlobalSourceData`, then used read-only during parallel resolution.\npub struct ImportResolutionMap {\n    /// `file_path` → (`local_name` → specifier + original exported name).\n    /// Nested (rather than a flat `(Utf8PathBuf, CompactString)` key) so lookups can\n    /// borrow `&Utf8Path` directly instead of cloning the whole path per call.\n    /// Note: we store the specifier string, not the resolved file path.\n    /// The resolver calls `oxc_resolver` to turn specifiers into absolute paths.\n    bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>>,\n\n    /// `barrel_file` → specifiers it wildcard-re-exports from (`export * from \"...\"`).\n    #[allow(dead_code)]\n    wildcard_sources: FxHashMap<Utf8PathBuf, Vec<String>>,\n}\n\nimpl ImportResolutionMap {\n    /// Build from a fully-merged `GlobalSourceData`.\n    /// Called once per extraction run, before parallel resolution starts.\n    ///\n    /// No I/O — pure data transformation.\n    pub fn build(global: &GlobalSourceData) -> Self {\n        let mut bindings: FxHashMap<Utf8PathBuf, FxHashMap<CompactString, ImportRef>> = FxHashMap::default();\n        let mut wildcard_sources: FxHashMap<Utf8PathBuf, Vec<String>> = FxHashMap::default();\n\n        // ── Populate bindings from import_map ──────────────────────────────\n        for (file_path, import_bindings) in &global.import_map {\n            let per_file = bindings.entry(file_path.clone()).or_default();\n            for binding in import_bindings {\n                per_file.insert(\n                    binding.local_name.clone(),\n                    ImportRef {\n                        specifier: binding.specifier.clone(),\n                        exported_name: binding.exported_name.clone(),\n                        is_type_only: binding.is_type_only,\n                    },\n                );\n            }\n        }\n\n        // ── Populate wildcard_sources from re_export_map ──────────────────\n        for (file_path, exports) in &global.re_export_map {\n            for export in exports {\n                if let LexedExport::ReExportAll { source_specifier, .. } = export {\n                    wildcard_sources.entry(file_path.clone()).or_default().push(source_specifier.clone());\n                }\n            }\n        }\n\n        Self { bindings, wildcard_sources }\n    }\n\n    /// Given a file and a local name used in that file, return where it was imported from.\n    ///\n    /// Returns `None` if the name is locally defined (not imported).\n    pub fn find_import(&self, file: &Utf8Path, local_name: &str) -> Option<&ImportRef> {\n        self.bindings.get(file)?.get(local_name)\n    }\n\n    /// Walk one step of the re-export chain for `barrel_file`.\n    ///\n    /// - If a `ReExportNamed` entry matches `exported_name`, returns `Named { .. }`.\n    /// - If no named match is found but there are `ReExportAll` entries, returns `Wildcards(..)`.\n    /// - Returns `None` if the barrel file has no relevant re-exports.\n    #[allow(dead_code)]\n    pub fn resolve_reexport_chain(\n        &self,\n        barrel_file: &Utf8Path,\n        exported_name: &str,\n        global: &GlobalSourceData,\n    ) -> Option<ReExportStep> {\n        let exports = global.re_export_map.get(barrel_file)?;\n\n        let mut wildcard_specifiers: Vec<String> = Vec::new();\n\n        for export in exports {\n            match export {\n                LexedExport::ReExportNamed { local_name, source_name, source_specifier, .. } => {\n                    if local_name == exported_name {\n                        return Some(ReExportStep::Named {\n                            source_specifier: source_specifier.clone(),\n                            source_name: source_name.clone(),\n                        });\n                    }\n                }\n                LexedExport::ReExportAll { source_specifier, .. } => {\n                    wildcard_specifiers.push(source_specifier.clone());\n                }\n                // Namespace re-exports and local declarations are not relevant here.\n                _ => {}\n            }\n        }\n\n        if !wildcard_specifiers.is_empty() {\n            Some(ReExportStep::Wildcards(wildcard_specifiers))\n        } else {\n            None\n        }\n    }\n\n    /// Return the list of specifiers wildcard-re-exported from `barrel_file`.\n    ///\n    /// Returns an empty slice if the file has no `export * from \"...\"` entries.\n    #[allow(dead_code)]\n    pub fn wildcard_sources_for(&self, barrel_file: &Utf8Path) -> &[String] {\n        self.wildcard_sources.get(barrel_file).map(|v| v.as_slice()).unwrap_or(&[])\n    }\n}\n\n// ─── Tests ────────────────────────────────────────────────────────────────────\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use crate::types::{GlobalSourceData, ImportBinding, LexedExport};\n    use camino::Utf8PathBuf;\n    use compact_str::CompactString;\n\n    /// Convenience builder for `GlobalSourceData`.\n    fn make_global(\n        imports: Vec<(Utf8PathBuf, Vec<ImportBinding>)>,\n        exports: Vec<(Utf8PathBuf, Vec<LexedExport>)>,\n    ) -> GlobalSourceData {\n        let mut g = GlobalSourceData::default();\n        for (path, bindings) in imports {\n            g.import_map.insert(path, bindings);\n        }\n        for (path, exps) in exports {\n            g.re_export_map.insert(path, exps);\n        }\n        g\n    }\n\n    fn make_binding(local_name: &str, exported_name: &str, specifier: &str, is_type_only: bool) -> ImportBinding {\n        ImportBinding {\n            local_name: CompactString::from(local_name),\n            exported_name: CompactString::from(exported_name),\n            specifier: specifier.to_owned(),\n            is_type_only,\n        }\n    }\n\n    #[test]\n    fn test_named_import_lookup() {\n        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n        let global = make_global(\n            vec![(file.clone(), vec![make_binding(\"ButtonProps\", \"ButtonProps\", \"@radix-ui/react-button\", false)])],\n            vec![],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        let result = map.find_import(&file, \"ButtonProps\").expect(\"should find import\");\n        assert_eq!(result.specifier, \"@radix-ui/react-button\");\n        assert_eq!(result.exported_name.as_str(), \"ButtonProps\");\n        assert!(!result.is_type_only);\n    }\n\n    #[test]\n    fn test_named_import_not_found() {\n        let file = Utf8PathBuf::from(\"/project/src/Button.tsx\");\n        let global = make_global(vec![], vec![]);\n        let map = ImportResolutionMap::build(&global);\n\n        assert!(map.find_import(&file, \"LocalType\").is_none());\n    }\n\n    #[test]\n    fn test_renamed_import() {\n        // import { Button as Btn } from \"@radix-ui/react-button\"\n        let file = Utf8PathBuf::from(\"/project/src/Wrapper.tsx\");\n        let global = make_global(\n            vec![(file.clone(), vec![make_binding(\"Btn\", \"Button\", \"@radix-ui/react-button\", false)])],\n            vec![],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        // Looking up by local alias \"Btn\"\n        let result = map.find_import(&file, \"Btn\").expect(\"should find renamed import\");\n        assert_eq!(result.exported_name.as_str(), \"Button\");\n        assert_eq!(result.specifier, \"@radix-ui/react-button\");\n\n        // Original name \"Button\" is NOT a local binding in this file\n        assert!(map.find_import(&file, \"Button\").is_none());\n    }\n\n    #[test]\n    fn test_reexport_named_chain() {\n        // barrel/index.ts: export { Foo as Bar } from \"./foo\"\n        // Looking up \"Bar\" should return Named { source_name: \"Foo\", source_specifier: \"./foo\" }\n        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n        let global = make_global(\n            vec![],\n            vec![(\n                barrel.clone(),\n                vec![LexedExport::ReExportNamed {\n                    local_name: \"Bar\".to_owned(),\n                    source_name: \"Foo\".to_owned(),\n                    source_specifier: \"./foo\".to_owned(),\n                    is_type_only: false,\n                }],\n            )],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        match map.resolve_reexport_chain(&barrel, \"Bar\", &global) {\n            Some(ReExportStep::Named { source_specifier, source_name }) => {\n                assert_eq!(source_specifier, \"./foo\");\n                assert_eq!(source_name, \"Foo\");\n            }\n            other => panic!(\"expected Named, got {:?}\", other),\n        }\n    }\n\n    #[test]\n    fn test_reexport_named_no_match() {\n        // The barrel exports \"Bar\" but we ask for \"Baz\"\n        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n        let global = make_global(\n            vec![],\n            vec![(\n                barrel.clone(),\n                vec![LexedExport::ReExportNamed {\n                    local_name: \"Bar\".to_owned(),\n                    source_name: \"Foo\".to_owned(),\n                    source_specifier: \"./foo\".to_owned(),\n                    is_type_only: false,\n                }],\n            )],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n        assert!(map.resolve_reexport_chain(&barrel, \"Baz\", &global).is_none());\n    }\n\n    #[test]\n    fn test_reexport_all() {\n        // barrel/index.ts: export * from \"./types\"\n        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n        let global = make_global(\n            vec![],\n            vec![(\n                barrel.clone(),\n                vec![LexedExport::ReExportAll { source_specifier: \"./types\".to_owned(), is_type_only: false }],\n            )],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        // wildcard_sources_for should return [\"./types\"]\n        let wildcards = map.wildcard_sources_for(&barrel);\n        assert_eq!(wildcards, &[\"./types\"]);\n\n        // resolve_reexport_chain for any name should return Wildcards\n        match map.resolve_reexport_chain(&barrel, \"AnyName\", &global) {\n            Some(ReExportStep::Wildcards(specs)) => {\n                assert_eq!(specs, vec![\"./types\"]);\n            }\n            other => panic!(\"expected Wildcards, got {:?}\", other),\n        }\n    }\n\n    #[test]\n    fn test_reexport_named_takes_priority_over_wildcard() {\n        // If a barrel has both a named re-export matching the name AND wildcards,\n        // the named re-export wins (returned first).\n        let barrel = Utf8PathBuf::from(\"/project/src/index.ts\");\n        let global = make_global(\n            vec![],\n            vec![(\n                barrel.clone(),\n                vec![\n                    LexedExport::ReExportAll { source_specifier: \"./everything\".to_owned(), is_type_only: false },\n                    LexedExport::ReExportNamed {\n                        local_name: \"Target\".to_owned(),\n                        source_name: \"Target\".to_owned(),\n                        source_specifier: \"./target\".to_owned(),\n                        is_type_only: false,\n                    },\n                ],\n            )],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        match map.resolve_reexport_chain(&barrel, \"Target\", &global) {\n            Some(ReExportStep::Named { source_specifier, source_name }) => {\n                assert_eq!(source_specifier, \"./target\");\n                assert_eq!(source_name, \"Target\");\n            }\n            other => panic!(\"expected Named, got {:?}\", other),\n        }\n    }\n\n    #[test]\n    fn test_wildcard_sources_empty() {\n        let barrel = Utf8PathBuf::from(\"/project/src/no-wildcards.ts\");\n        let global = make_global(vec![], vec![]);\n        let map = ImportResolutionMap::build(&global);\n\n        assert!(map.wildcard_sources_for(&barrel).is_empty());\n    }\n\n    #[test]\n    fn test_multiple_files() {\n        let file_a = Utf8PathBuf::from(\"/project/src/A.tsx\");\n        let file_b = Utf8PathBuf::from(\"/project/src/B.tsx\");\n        let global = make_global(\n            vec![\n                (file_a.clone(), vec![make_binding(\"Foo\", \"Foo\", \"./foo\", true)]),\n                (file_b.clone(), vec![make_binding(\"Foo\", \"Foo\", \"./other-foo\", false)]),\n            ],\n            vec![],\n        );\n\n        let map = ImportResolutionMap::build(&global);\n\n        let a = map.find_import(&file_a, \"Foo\").expect(\"A should have Foo\");\n        assert_eq!(a.specifier, \"./foo\");\n        assert!(a.is_type_only);\n\n        let b = map.find_import(&file_b, \"Foo\").expect(\"B should have Foo\");\n        assert_eq!(b.specifier, \"./other-foo\");\n        assert!(!b.is_type_only);\n    }\n}\n","numLines":366,"startLine":1,"totalLines":366}},"sourceToolAssistantUUID":"48ce285c-4eda-4297-8a07-5b968e707167","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
