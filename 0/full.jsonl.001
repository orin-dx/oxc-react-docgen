        .diagnostics\n        .iter()\n        .filter(|d| matches!(d.severity, oxc_react_docgen_core::types::DiagnosticSeverity::Warning))\n        .collect();\n\n    if args.json {\n        println!(\"{}\", serde_json::to_string(&output.diagnostics).into_diagnostic()?);\n    } else if !quiet {\n        print_summary(&output, quiet);\n        print_diagnostics(&output.diagnostics);\n    }\n\n    if !errors.is_empty() {\n        std::process::exit(2);\n    }\n    if args.strict && !warnings.is_empty() {\n        std::process::exit(1);\n    }\n\n    Ok(())\n}\n","structuredPatch":[{"oldStart":37,"oldLines":11,"newStart":37,"newLines":11,"lines":["     }"," ","     if !errors.is_empty() {","-        std::process::exit(2);","+        return Ok(2);","     }","     if args.strict && !warnings.is_empty() {","-        std::process::exit(1);","+        return Ok(1);","     }"," ","-    Ok(())","+    Ok(0)"," }"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8c850dc1-83c9-4cb1-b308-5174cabb75bb","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
