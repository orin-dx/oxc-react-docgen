{"parentUuid":"85d6d5d0-03e9-4935-8497-854667c4d270","isSidechain":false,"attachment":{"type":"output_style","style":"Explanatory"},"type":"attachment","uuid":"429cb179-94ae-4fd9-a632-ad94be4b1ab5","timestamp":"2026-07-25T18:54:21.411Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"429cb179-94ae-4fd9-a632-ad94be4b1ab5","isSidechain":false,"message":{"model":"claude-sonnet-5","id":"msg_011CdPHP1tZvgx6WxZ8eG8sx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Bumw6tYSv7iWKYdBZSGsv3","name":"Write","input":{"file_path":"/Users/gabe/Projects/oxc-react-codegen/apps/validate/src/bench-cold.ts","content":"import { spawnSync } from 'node:child_process'\nimport { resolve } from 'node:path'\n\n// Cross-tool cold-extraction wall-clock comparison: each run below is a fresh\n// child process, so the timing includes process startup + module load + (for\n// rdt/rdg) TS-compiler/Babel init — the real cost a CI job or a fresh `npm\n// run build` pays, not an in-process warm-loop number that hides that cost.\n// This runs the WHOLE fixture corpus per invocation, same granularity as the\n// existing run:* scripts (rdt/rdg: one Node process for every fixture; ours:\n// one CLI process per library directory, summed) — a fair \"cost of running\n// this tool once over the repo\" comparison, not a per-file microbenchmark.\n\nconst RUNS = 5\n\ninterface Timing {\n  tool: string\n  script: string\n  msPerRun: number[]\n}\n\nfunction timeScript(tool: string, script: string): Timing {\n  const msPerRun: number[] = []\n  for (let i = 0; i < RUNS; i++) {\n    const start = performance.now()\n    const result = spawnSync('tsx', [resolve(import.meta.dirname, script)], {\n      encoding: 'utf8',\n      stdio: ['ignore', 'ignore', 'inherit'],\n      maxBuffer: 100 * 1024 * 1024,\n    })\n    const elapsed = performance.now() - start\n    if (result.error) throw new Error(`${script} failed to spawn: ${result.error.message}`)\n    if (result.status !== 0) throw new Error(`${script} exited with status ${result.status}`)\n    msPerRun.push(elapsed)\n  }\n  return { tool, script, msPerRun }\n}\n\nfunction median(xs: number[]): number {\n  const sorted = [...xs].toSorted((a, b) => a - b)\n  const mid = Math.floor(sorted.length / 2)\n  return sorted.length % 2 === 0 ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[mid]\n}\n\nfunction stddev(xs: number[]): number {\n  const mean = xs.reduce((a, b) => a + b, 0) / xs.length\n  const variance = xs.reduce((a, b) => a + (b - mean) ** 2, 0) / xs.length\n  return Math.sqrt(variance)\n}\n\nconst timings = [\n  timeScript('react-docgen', 'run-react-docgen.ts'),\n  timeScript('react-docgen-typescript', 'run-react-docgen-typescript.ts'),\n  timeScript('oxc-react-docgen', 'run-ours.ts'),\n]\n\nconsole.log(`\\nCold whole-corpus extraction, ${RUNS} runs each (fresh process per run):\\n`)\nconst report = timings.map((t) => ({\n  tool: t.tool,\n  runsMs: t.msPerRun.map((n) => Math.round(n * 10) / 10),\n  medianMs: Math.round(median(t.msPerRun) * 10) / 10,\n  stddevMs: Math.round(stddev(t.msPerRun) * 10) / 10,\n}))\n\nfor (const r of report) {\n  console.log(`${r.tool.padEnd(28)} median=${r.medianMs}ms  stddev=${r.stddevMs}ms  runs=[${r.runsMs.join(', ')}]`)\n}\n\nconst oursMedian = report.find((r) => r.tool === 'oxc-react-docgen')?.medianMs ?? 0\nfor (const r of report) {\n  if (r.tool === 'oxc-react-docgen' || oursMedian === 0) continue\n  console.log(`\\noxc-react-docgen is ${(r.medianMs / oursMedian).toFixed(1)}x faster than ${r.tool} (cold, whole corpus)`)\n}\n\nimport { writeFileSync } from 'node:fs'\nwriteFileSync('./bench-cold.json', JSON.stringify({ runs: RUNS, generatedAt: new Date().toISOString(), report }, null, 2))\nconsole.log(`\\nFull structured output written to apps/validate/bench-cold.json`)\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1035,"cache_read_input_tokens":253218,"output_tokens":1498,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1035,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1498,"cache_read_input_tokens":253218,"cache_creation_input_tokens":1035,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1035},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdPHNy4ewJRTMuG5JQsrV","type":"assistant","uuid":"61ea1065-7624-4f37-8df6-8821a6963dd5","timestamp":"2026-07-25T18:54:35.580Z","effort":"medium","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
