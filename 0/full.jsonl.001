{"parentUuid":"07bf535b-1156-48e0-8828-d613e9399d22","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/collected.rs","snippet":"1\t//! Central dispatch: CollectedType → PropType.\n2\t\n3\tuse camino::Utf8Path;\n4\t\n5\tuse crate::types::*;\n6\t\n7\tuse super::func::{resolve_function_type, resolve_typeof};\n8\tuse super::named::resolve_named;\n9\tuse super::primitives::{resolve_indexed_access, resolve_intersection, resolve_union};\n10\tuse super::template::resolve_template_literal;\n11\tuse super::{ResolutionContext, MAX_DEPTH};\n12\t\n13\t/// Central dispatch: convert a `CollectedType` to a `PropType`.\n14\t/// Never re-parses strings — everything is already structured.\n15\t#[allow(clippy::too_many_arguments)]\n16\tpub fn resolve_collected_type(\n17\t    ct: &CollectedType,\n18\t    consuming_file: &Utf8Path,\n19\t    ctx: &ResolutionContext,\n20\t    state: &mut ResolveState,\n21\t    depth: u8,\n22\t) -> PropType {\n23\t    if depth > MAX_DEPTH {\n24\t        state.diagnostics.push(Diagnostic {\n25\t            severity: DiagnosticSeverity::Warning,\n26\t            message: format!(\"Max resolution depth exceeded resolving type: {}\", ct.to_raw_string()),\n27\t            file: Some(consuming_file.to_string()),\n28\t            line: None,\n29\t            column: None,\n30\t            help: None,\n31\t            code: DiagnosticCode::MaxDepthExceeded,\n32\t        });\n33\t        return PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::DepthExceeded };\n34\t    }\n35\t\n36\t    match ct {\n37\t        // ── Primitives ────────────────────────────────────────────────────────\n38\t        CollectedType::String => PropType::String,\n39\t        CollectedType::Number => PropType::Number,\n40\t        CollectedType::Boolean => PropType::Boolean,\n41\t        CollectedType::Null => PropType::Null,\n42\t        CollectedType::Undefined => PropType::Undefined,\n43\t        CollectedType::Any => PropType::Any,\n44\t        CollectedType::Never => PropType::Never,\n45\t        CollectedType::Unknown => PropType::Unknown,\n46\t        CollectedType::Void => PropType::Void,\n47\t        // BigInt/Symbol — no dedicated PropType; surface as Named.\n48\t        CollectedType::BigInt => PropType::Named { name: \"bigint\".into(), args: vec![] },\n49\t        CollectedType::Symbol => PropType::Named { name: \"symbol\".into(), args: vec![] },\n50\t\n51\t        // ── Literals ─────────────────────────────────────────────────────────\n52\t        CollectedType::StringLiteral(s) => PropType::StringLiteral(s.to_string()),\n53\t        CollectedType::NumberLiteral(n) => PropType::NumberLiteral(*n),\n54\t        CollectedType::BoolLiteral(b) => PropType::BoolLiteral(*b),\n55\t\n56\t        // ── Composites ───────────────────────────────────────────────────────\n57\t        CollectedType::Union(members) => resolve_union(members, consuming_file, ctx, state, depth),\n58\t        CollectedType::Intersection(members) => resolve_intersection(members, consuming_file, ctx, state, depth),\n59\t        CollectedType::Array(inner) => {\n60\t            PropType::Array(Box::new(resolve_collected_type(inner, consuming_file, ctx, state, depth + 1)))\n61\t        }\n62\t        CollectedType::Tuple(members) => PropType::Tuple(\n63\t            members.iter().map(|m| resolve_collected_type(m, consuming_file, ctx, state, depth + 1)).collect(),\n64\t        ),\n65\t        CollectedType::Object(fields) => PropType::Object(\n66\t            fields\n67\t                .iter()\n68\t                .map(|f| ObjectField {\n69\t                    name: f.name.clone(),\n70\t                    prop_type: resolve_collected_type(&f.collected_type, consuming_file, ctx, state, depth + 1),\n71\t                    required: f.required,\n72\t                    description: f.description.clone(),\n73\t                })\n74\t                .collect(),\n75\t        ),\n76\t\n77\t        // ── Named type reference ──────────────────────────────────────────────\n78\t        CollectedType::Named { name, args } => resolve_named(name, args, consuming_file, ctx, state, depth),\n79\t\n80\t        // ── typeof X ─────────────────────────────────────────────────────────\n81\t        CollectedType::TypeOf(name) => resolve_typeof(name, consuming_file, ctx, &mut state.diagnostics),\n82\t\n83\t        // ── keyof X — only meaningful as Omit's key argument (handled structurally\n84\t        // there, see resolver/alias.rs); standalone usage needs a general\n85\t        // type-to-key-names resolver we don't have, so degrade gracefully.\n86\t        CollectedType::KeyOf(_) => {\n87\t            push_opaque_diagnostic(state, \"a standalone 'keyof'\", ct, consuming_file);\n88\t            PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType }\n89\t        }\n90\t\n91\t        // ── Generic-alias substitution marker — switch file context to where\n92\t        // `inner` was actually written (see the `CollectedType::AtFile` doc\n93\t        // comment) and continue resolving from there.\n94\t        CollectedType::AtFile { file, inner } => resolve_collected_type(inner, file, ctx, state, depth),\n95\t\n96\t        // ── Indexed access ───────────────────────────────────────────────────\n97\t        CollectedType::IndexedAccess { obj, key } => {\n98\t            resolve_indexed_access(obj, key, consuming_file, ctx, state, depth)\n99\t        }\n100\t\n101\t        // ── Template literal ─────────────────────────────────────────────────\n102\t        CollectedType::TemplateLiteral(parts) => resolve_template_literal(parts, consuming_file, ctx, state, depth),\n103\t\n104\t        // ── Function type ─────────────────────────────────────────────────────\n105\t        CollectedType::Function { params, param_names, return_type } => {\n106\t            resolve_function_type(params, param_names, return_type, consuming_file, ctx, state, depth)\n107\t        }\n108\t\n109\t        // ── Opaque (needs type checker) ───────────────────────────────────────\n110\t        CollectedType::Conditional { .. } => {\n111\t            push_opaque_diagnostic(state, \"a conditional type\", ct, consuming_file);\n112\t            PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::ConditionalType }\n113\t        }\n114\t        CollectedType::Mapped { .. } => {\n115\t            push_opaque_diagnostic(state, \"a mapped type\", ct, consuming_file);\n116\t            PropType::Opaque { raw: ct.to_raw_string(), reason: OpaqueReason::MappedType }\n117\t        }\n118\t\n119\t        // ── Raw fallback ─────────────────────────────────────────────────────\n120\t        CollectedType::Raw(s) => {\n121\t            let trimmed = s.trim();\n122\t            // `typeof X` — ExtendsRef.type_args serialized form; resolve as Named.\n123\t            if let Some(name) = trimmed.strip_prefix(\"typeof \") {\n124\t                return PropType::Named { name: name.trim().into(), args: vec![] };\n125\t            }\n126\t            // Double-quoted string literal: `\"button\"` → StringLiteral.\n127\t            if trimmed.starts_with('\"') && trimmed.ends_with('\"') && trimmed.len() >= 2 {\n128\t                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n129\t            }\n130\t            // Single-quoted string literal: `'button'` → StringLiteral.\n131\t            if trimmed.starts_with('\\'') && trimmed.ends_with('\\'') && trimmed.len() >= 2 {\n132\t                return PropType::StringLiteral(trimmed[1..trimmed.len() - 1].to_owned());\n133\t            }\n134\t            // TypeScript primitive keywords — tuple elements come through Raw because\n135\t            // TSTupleElement falls through to source-text extraction for non-optional,\n136\t            // non-rest elements. Recognise keywords here so they emit the proper PropType.\n137\t            match trimmed {\n138\t                \"string\" => return PropType::String,\n139\t                \"number\" => return PropType::Number,\n140\t                \"boolean\" => return PropType::Boolean,\n141\t                \"null\" => return PropType::Null,\n142\t                \"undefined\" => return PropType::Undefined,\n143\t                \"never\" => return PropType::Never,\n144\t                \"void\" => return PropType::Void,\n145\t                \"any\" => return PropType::Any,\n146\t                \"unknown\" => return PropType::Unknown,\n147\t                _ => {}\n148\t            }\n149\t            // Simple identifier → Named type reference.\n150\t            if !trimmed.is_empty()\n151\t                && !trimmed.contains(' ')\n\n... [31 lines truncated] ..."},"type":"attachment","uuid":"2c63dd12-9062-4e54-af3e-4a5956d06b70","timestamp":"2026-07-22T19:46:21.335Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
