{"parentUuid":"b983c0c9-1a9c-450e-a8bb-ee7a648e9fc9","isSidechain":false,"promptId":"eafe5a33-2a2e-4a79-89fc-581673fb3b40","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JoePpbcqk4ze5a58rEs1dB","type":"tool_result","content":"100\t            cache_dir: js.cache_dir.map(Into::into),\n101\t            resolve_complex_types: js.resolve_complex_types.unwrap_or(false),\n102\t            exclude_prefixes: vec![],\n103\t        }\n104\t    }\n105\t}\n106\t\n107\t// ─── Public NAPI functions ────────────────────────────────────────────────────\n108\t\n109\t/// Cold extraction — returns JSON string of ExtractionOutput.\n110\t/// Use for: build-time extraction, CLI backing, one-off runs.\n111\t#[napi]\n112\tpub async fn extract_all(options: JsExtractOptions) -> napi::Result<String> {\n113\t    let pipeline_options = PipelineOptions::from(options);\n114\t    tokio::task::spawn_blocking(move || {\n115\t        let output = oxc_react_docgen_core::pipeline::extract(&pipeline_options);\n116\t        extraction_output_to_json(&output).map_err(|e| napi::Error::from_reason(e.to_string()))\n117\t    })\n118\t    .await\n119\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n120\t}\n121\t\n122\t/// Create a persistent watch session. Returns session ID.\n123\t/// Call this in Vite's configResolved hook.\n124\t#[napi]\n125\tpub fn create_session(options: JsExtractOptions) -> u32 {\n126\t    let id = next_session_id();\n127\t    let session = Arc::new(WatchSession::new(PipelineOptions::from(options)));\n128\t    SESSIONS.insert(id, session);\n129\t    id\n130\t}\n131\t\n132\t/// Incremental extraction for a single changed file.\n133\t/// Returns JSON string of IncrementalUpdate.\n134\t/// Use for: Vite HMR hotUpdate.\n135\t#[napi]\n136\tpub async fn extract_file_incremental(\n137\t    file_path: String,\n138\t    session_id: u32,\n139\t    options: JsExtractOptions,\n140\t) -> napi::Result<String> {\n141\t    let session = SESSIONS\n142\t        .entry(session_id)\n143\t        .or_insert_with(|| Arc::new(WatchSession::new(PipelineOptions::from(options))))\n144\t        .clone();\n145\t\n146\t    tokio::task::spawn_blocking(move || {\n147\t        let path = Utf8Path::new(&file_path);\n148\t        let update = session.update_file(path);\n149\t        incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n150\t    })\n151\t    .await\n152\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n153\t}\n154\t\n155\t/// Initialize a watch session with a full cold extraction.\n156\t/// Returns JSON string of ExtractionOutput.\n157\t/// Call this after create_session(), in configureServer.\n158\t#[napi]\n159\tpub async fn initialize_session(session_id: u32, options: JsExtractOptions) -> napi::Result<String> {\n160\t    let session = match SESSIONS.get(&session_id) {\n161\t        Some(s) => s.clone(),\n162\t        None => {\n163\t            let s = Arc::new(WatchSession::new(PipelineOptions::from(options)));\n164\t            SESSIONS.insert(session_id, s.clone());\n165\t            s\n166\t        }\n167\t    };\n168\t    tokio::task::spawn_blocking(move || {\n169\t        let output = session.initialize();\n170\t        oxc_react_docgen_core::pipeline::extraction_output_to_json(&output)\n171\t            .map_err(|e| napi::Error::from_reason(e.to_string()))\n172\t    })\n173\t    .await\n174\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?"}]},"uuid":"7c45c935-6c26-407f-8073-c50283d525a1","timestamp":"2026-07-22T20:26:43.050Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/gabe/Projects/oxc-react-codegen/crates/binding/src/lib.rs","content":"            cache_dir: js.cache_dir.map(Into::into),\n            resolve_complex_types: js.resolve_complex_types.unwrap_or(false),\n            exclude_prefixes: vec![],\n        }\n    }\n}\n\n// ─── Public NAPI functions ────────────────────────────────────────────────────\n\n/// Cold extraction — returns JSON string of ExtractionOutput.\n/// Use for: build-time extraction, CLI backing, one-off runs.\n#[napi]\npub async fn extract_all(options: JsExtractOptions) -> napi::Result<String> {\n    let pipeline_options = PipelineOptions::from(options);\n    tokio::task::spawn_blocking(move || {\n        let output = oxc_react_docgen_core::pipeline::extract(&pipeline_options);\n        extraction_output_to_json(&output).map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n}\n\n/// Create a persistent watch session. Returns session ID.\n/// Call this in Vite's configResolved hook.\n#[napi]\npub fn create_session(options: JsExtractOptions) -> u32 {\n    let id = next_session_id();\n    let session = Arc::new(WatchSession::new(PipelineOptions::from(options)));\n    SESSIONS.insert(id, session);\n    id\n}\n\n/// Incremental extraction for a single changed file.\n/// Returns JSON string of IncrementalUpdate.\n/// Use for: Vite HMR hotUpdate.\n#[napi]\npub async fn extract_file_incremental(\n    file_path: String,\n    session_id: u32,\n    options: JsExtractOptions,\n) -> napi::Result<String> {\n    let session = SESSIONS\n        .entry(session_id)\n        .or_insert_with(|| Arc::new(WatchSession::new(PipelineOptions::from(options))))\n        .clone();\n\n    tokio::task::spawn_blocking(move || {\n        let path = Utf8Path::new(&file_path);\n        let update = session.update_file(path);\n        incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n}\n\n/// Initialize a watch session with a full cold extraction.\n/// Returns JSON string of ExtractionOutput.\n/// Call this after create_session(), in configureServer.\n#[napi]\npub async fn initialize_session(session_id: u32, options: JsExtractOptions) -> napi::Result<String> {\n    let session = match SESSIONS.get(&session_id) {\n        Some(s) => s.clone(),\n        None => {\n            let s = Arc::new(WatchSession::new(PipelineOptions::from(options)));\n            SESSIONS.insert(session_id, s.clone());\n            s\n        }\n    };\n    tokio::task::spawn_blocking(move || {\n        let output = session.initialize();\n        oxc_react_docgen_core::pipeline::extraction_output_to_json(&output)\n            .map_err(|e| napi::Error::from_reason(e.to_string()))\n    })\n    .await\n    .map_err(|e| napi::Error::from_reason(e.to_string()))?","numLines":75,"startLine":100,"totalLines":182}},"sourceToolAssistantUUID":"b983c0c9-1a9c-450e-a8bb-ee7a648e9fc9","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
