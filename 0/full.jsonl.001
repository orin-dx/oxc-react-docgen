{"parentUuid":"8c2b7db3-2862-4822-a2ed-e76ec4135d95","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/resolver/named.rs","snippet":"1\t//! Named type resolution.\n2\t\n3\tuse camino::Utf8Path;\n4\tuse compact_str::CompactString;\n5\t\n6\tuse crate::known::{push_known_opaque_diagnostic, resolve_known, KnownPatternResult};\n7\tuse crate::react_types;\n8\tuse crate::types::*;\n9\t\n10\tuse super::alias::resolve_type_alias_type;\n11\tuse super::collected::resolve_collected_type;\n12\tuse super::import::{\n13\t    lookup_ambient_global, lookup_interface, lookup_type_alias, resolve_to_canonical, AmbientGlobalLookup,\n14\t};\n15\tuse super::react::react_type_to_prop_type;\n16\tuse super::{ResolutionContext, MAX_DEPTH};\n17\t\n18\t#[allow(clippy::too_many_arguments)]\n19\tpub(super) fn resolve_named(\n20\t    name: &CompactString,\n21\t    args: &[CollectedType],\n22\t    consuming_file: &Utf8Path,\n23\t    ctx: &ResolutionContext,\n24\t    state: &mut ResolveState,\n25\t    depth: u8,\n26\t) -> PropType {\n27\t    if depth > MAX_DEPTH {\n28\t        state.diagnostics.push(super::max_depth_diagnostic(&format!(\"named type '{}'\", name), consuming_file));\n29\t        return PropType::Opaque { raw: name.to_string(), reason: OpaqueReason::DepthExceeded };\n30\t    }\n31\t\n32\t    // ── 1. React builtin check ────────────────────────────────────────────────\n33\t    let lookup_name = name.strip_prefix(\"React.\").unwrap_or(name.as_str());\n34\t    if react_types::is_react_builtin(lookup_name, &ctx.extra_builtins) {\n35\t        return react_type_to_prop_type(name.as_str(), args, consuming_file, ctx, state, depth);\n36\t    }\n37\t\n38\t    // Resolve type arguments eagerly — needed for both source lookups and known patterns.\n39\t    let resolved_args: Vec<PropType> =\n40\t        args.iter().map(|a| resolve_collected_type(a, consuming_file, ctx, state, depth + 1)).collect();\n41\t\n42\t    // ── 2. Import resolution → canonical (file, name) ─────────────────────────\n43\t    // Check source-defined types BEFORE known library patterns so that user-defined\n44\t    // types like ThemingProps or StylesApiProps are never silently replaced by\n45\t    // opaque known-pattern shortcuts.\n46\t    let (canonical_file, canonical_name) =\n47\t        resolve_to_canonical(name.as_str(), consuming_file, ctx, &mut state.diagnostics)\n48\t            .unwrap_or_else(|| (consuming_file.to_owned(), name.to_string()));\n49\t\n50\t    // ── 3. Type alias lookup ──────────────────────────────────────────────────\n51\t    if let Some((matched_key, alias)) = lookup_type_alias(&ctx.global, canonical_file.as_str(), &canonical_name) {\n52\t        let alias = alias.clone();\n53\t        // A generic alias's own declared type parameters (`type Foo<TData> = ...`)\n54\t        // are expected, unexpandable placeholders wherever referenced in its body —\n55\t        // not unresolvable types. Register them so step 7 below doesn't warn.\n56\t        if let Some(params) = ctx.global.type_alias_params.get(&matched_key) {\n57\t            state.in_scope_type_params.extend(params.iter().cloned());\n58\t        }\n59\t        return resolve_type_alias_type(&alias, ctx, state, depth);\n60\t    }\n61\t\n62\t    // ── 4. Interface lookup ───────────────────────────────────────────────────\n63\t    // At the prop-TYPE level (not chain level), an interface name is returned as Named.\n64\t    // Full prop expansion only happens at the component level via resolve_props_chain.\n65\t    if lookup_interface(&ctx.global, canonical_file.as_str(), &canonical_name).is_some() {\n66\t        return PropType::Named { name: name.clone(), args: resolved_args };\n67\t    }\n68\t\n69\t    // ── 5. Known pattern check (fallback — only when not found in source) ─────\n70\t    // Library opaque patterns (ThemingProps, StylesApiProps, VariantProps, …) are\n71\t    // applied only when the type cannot be resolved from the project's own source.\n72\t    if let Some(result) = resolve_known(name.as_str(), &resolved_args, &ctx.global, &ctx.enum_bare_index) {\n73\t        return match result {\n74\t            KnownPatternResult::Type(pt) => {\n75\t                if let PropType::Opaque { reason, .. } = &pt {\n76\t                    push_known_opaque_diagnostic(&mut state.diagnostics, reason, name.as_str(), consuming_file);\n77\t                }\n78\t                pt\n79\t            }\n80\t            KnownPatternResult::Alias { name: alias_name } => {\n81\t                // Follow the alias through resolve_named.\n82\t                let alias_ct = CollectedType::Named { name: alias_name.as_str().into(), args: vec![] };\n83\t                resolve_collected_type(&alias_ct, consuming_file, ctx, state, depth + 1)\n84\t            }\n85\t            KnownPatternResult::Props(_) => {\n86\t                // Props result at type level — surface as Named.\n87\t                PropType::Named { name: name.clone(), args: resolved_args }\n88\t            }\n89\t        };\n90\t    }\n91\t\n92\t    // ── 6. Silent no-op for well-known unresolvable types ────────────────────\n93\t    // TypeScript built-in utility types, DOM element types, and React HTML\n94\t    // attribute types all appear as prop types in real-world .d.ts files but\n95\t    // cannot be expanded without a type-checker. Return Named silently.\n96\t    let bare = name.strip_prefix(\"React.\").unwrap_or(name.as_str());\n97\t    if super::is_ts_utility_type(bare)\n98\t        || matches!(\n99\t            bare,\n100\t            // TypeScript primitives used as type names\n101\t            \"object\" | \"Object\" | \"Function\" | \"Symbol\" | \"BigInt\"\n102\t            // React HTML attribute types (not in is_react_builtin; appear as prop types)\n103\t            | \"HTMLAttributes\" | \"InputHTMLAttributes\" | \"TextareaHTMLAttributes\"\n104\t            | \"SelectHTMLAttributes\" | \"ButtonHTMLAttributes\" | \"AnchorHTMLAttributes\"\n105\t            | \"FormHTMLAttributes\" | \"LabelHTMLAttributes\" | \"ImgHTMLAttributes\"\n106\t            | \"VideoHTMLAttributes\" | \"AudioHTMLAttributes\" | \"DOMAttributes\"\n107\t            | \"AriaAttributes\" | \"HTMLInputTypeAttribute\" | \"HTMLAttributeReferrerPolicy\"\n108\t            | \"HTMLAttributeAnchorTarget\" | \"HTMLInputAutoCompleteAttribute\"\n109\t            // React SVG/generic HTML prop types\n110\t            | \"SVGAttributes\" | \"SVGProps\" | \"HTMLProps\"\n111\t            // React component utility types\n112\t            | \"ComponentRef\" | \"JSXElementConstructor\"\n113\t        )\n114\t        || bare.ends_with(\"HTMLAttributes\")\n115\t    {\n116\t        return PropType::Named { name: name.clone(), args: resolved_args };\n117\t    }\n118\t    // DOM element ref types (HTMLDivElement, HTMLInputElement, etc.)\n119\t    if bare.starts_with(\"HTML\") && bare.ends_with(\"Element\") {\n120\t        return PropType::Named { name: name.clone(), args: resolved_args };\n121\t    }\n122\t    if bare.starts_with(\"SVG\") && bare.ends_with(\"Element\") {\n123\t        return PropType::Named { name: name.clone(), args: resolved_args };\n124\t    }\n125\t\n126\t    // ── 6.5 Enclosing generic's own type parameter — expected, not unresolvable ─\n127\t    if state.in_scope_type_params.contains(bare) {\n128\t        return PropType::Named { name: name.clone(), args: resolved_args };\n129\t    }\n130\t\n131\t    // ── 6.7 TypeScript's own ambient globals (Date, RegExp, Element, ...) ────\n132\t    // Deliberately last: these never go through an import, so nothing earlier\n133\t    // ever had a reason to look here — but checked only after every other\n134\t    // shortcut above (including the well-known-TS-utility-type list at step 6)\n135\t    // has had its chance, since some names (Record, Partial, ...) are\n136\t    // themselves declared in these same lib files as mapped types this tool\n137\t    // can't expand, and step 6 already handles those correctly.\n138\t    if let Some(found) = lookup_ambient_global(ctx, bare) {\n139\t        return match found {\n140\t            AmbientGlobalLookup::Interface => PropType::Named { name: name.clone(), args: resolved_args },\n141\t            AmbientGlobalLookup::TypeAlias(alias) => {\n142\t                let alias = alias.clone();\n143\t                resolve_type_alias_type(&alias, ctx, state, depth)\n144\t            }\n145\t        };\n146\t    }\n147\t\n148\t    // ── 7. Unresolvable — emit diagnostic, return Named ───────────────────────\n149\t    let location_note =\n150\t        super::unresolved_location_note(name.as_str(), consuming_file, &canonical_file, &canonical_name);\n151\t    state.diagnostics.push(Diagnostic {\n\n... [13 lines truncated] ..."},"type":"attachment","uuid":"1376d67d-49de-4269-a20d-43d04076d8b9","timestamp":"2026-07-25T02:52:42.987Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
{"parentUuid":"1376d67d-49de-4269-a20d-43d04076d8b9","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/core/src/pipeline/mod.rs","snippet":"1\t//! Extraction pipeline — Phase 3b.\n2\t//!\n3\t//! Orchestrates: file discovery → parallel parse → global merge → parallel resolve → output.\n4\t//! Also manages DTS cache and incremental watch-mode state.\n5\t\n6\tuse std::collections::VecDeque;\n7\tuse std::sync::atomic::{AtomicU32, Ordering};\n8\tuse std::sync::Arc;\n9\tuse std::time::Instant;\n10\t\n11\tuse camino::{Utf8Path, Utf8PathBuf};\n12\tuse rayon::prelude::*;\n13\tuse rustc_hash::{FxHashMap, FxHashSet};\n14\tuse serde::{Deserialize, Serialize};\n15\t\n16\tuse crate::cache::DtsCache;\n17\tuse crate::resolver::{resolve_component, ResolutionContext};\n18\tuse crate::types::*;\n19\t\n20\tmod discover;\n21\tpub mod watch;\n22\t\n23\tuse discover::{discover_files, should_skip};\n24\tpub use watch::WatchSession;\n25\t\n26\t// ─── PipelineOptions ─────────────────────────────────────────────────────────\n27\t\n28\t/// User-supplied known type override for custom library patterns.\n29\t#[derive(Debug, Clone, Serialize, Deserialize)]\n30\t#[serde(tag = \"kind\", rename_all = \"camelCase\")]\n31\tpub enum KnownTypeOverride {\n32\t    Opaque { label: Option<String> },\n33\t    Alias { arg_index: usize },\n34\t    Skip,\n35\t}\n36\t\n37\t/// How much of an inherited HTML element's attribute surface to expose.\n38\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]\n39\t#[serde(rename_all = \"camelCase\")]\n40\tpub enum HtmlAttributeMode {\n41\t    /// ~15-20 curated, commonly-documented attributes per element (onClick,\n42\t    /// disabled, aria-*, etc.) — the default. Matches RDT's shape for consumers\n43\t    /// that filter node_modules-sourced props, just with a smaller, hand-picked set.\n44\t    Curated,\n45\t    /// Actually resolve @types/react's real HTMLAttributes/AriaAttributes/\n46\t    /// DOMAttributes/<Element>HTMLAttributes interface chain, matching RDT's full\n47\t    /// ~250-300 attributes per element.\n48\t    Full,\n49\t    /// Don't synthesize any inherited HTML attributes at all — own props only.\n50\t    None,\n51\t}\n52\t\n53\t/// Configuration for a single extraction run.\n54\t#[derive(Debug, Clone)]\n55\tpub struct PipelineOptions {\n56\t    /// Source directories to scan.\n57\t    pub src_dirs: Vec<Utf8PathBuf>,\n58\t    /// Extra glob-like patterns to exclude (on top of built-in: stories, tests, snapshots).\n59\t    pub exclude_patterns: Vec<String>,\n60\t    /// Component name prefixes to skip.\n61\t    pub exclude_prefixes: Vec<String>,\n62\t    /// React version — default: React 19.\n63\t    pub react_version: crate::react_types::ReactVersion,\n64\t    /// Whether to resolve cross-package types.\n65\t    pub cross_package: bool,\n66\t    /// PandaCSS generated output dir, if applicable.\n67\t    pub pandacss_outdir: Option<Utf8PathBuf>,\n68\t    /// Extra function names to treat as cva-like variant functions.\n69\t    pub variant_functions: Vec<String>,\n70\t    /// How much of an inherited HTML element's attributes to expose.\n71\t    pub html_attributes: HtmlAttributeMode,\n72\t    // ── Fields from architectural review ─────────────────────────────────────\n73\t    /// Path to tsconfig.json (auto-detected if None).\n74\t    pub tsconfig_path: Option<Utf8PathBuf>,\n75\t    /// Monorepo path aliases: package name → list of candidate root dirs.\n76\t    pub extra_paths: FxHashMap<String, Vec<Utf8PathBuf>>,\n77\t    /// User-supplied overrides for specific named types.\n78\t    pub known_type_overrides: FxHashMap<String, KnownTypeOverride>,\n79\t    /// Additional builtin type names beyond the React standard set.\n80\t    pub extra_builtins: FxHashSet<compact_str::CompactString>,\n81\t    /// Enable vanilla-extract CSS-in-JS support.\n82\t    pub vanilla_extract: bool,\n83\t    /// Cache directory. Defaults to `node_modules/.cache/oxc-react-docgen`.\n84\t    pub cache_dir: Option<Utf8PathBuf>,\n85\t    /// Future: opt-in to typescript-go for conditional/mapped type resolution.\n86\t    pub resolve_complex_types: bool,\n87\t}\n88\t\n89\timpl Default for PipelineOptions {\n90\t    fn default() -> Self {\n91\t        Self {\n92\t            src_dirs: vec![Utf8PathBuf::from(\"./src\")],\n93\t            exclude_patterns: vec![],\n94\t            exclude_prefixes: vec![],\n95\t            react_version: crate::react_types::REACT_19,\n96\t            cross_package: true,\n97\t            pandacss_outdir: None,\n98\t            variant_functions: vec![\"cva\".into(), \"tv\".into(), \"defineRecipe\".into(), \"recipe\".into()],\n99\t            html_attributes: HtmlAttributeMode::Curated,\n100\t            tsconfig_path: None,\n101\t            extra_paths: Default::default(),\n102\t            known_type_overrides: Default::default(),\n103\t            extra_builtins: Default::default(),\n104\t            vanilla_extract: false,\n105\t            cache_dir: None,\n106\t            resolve_complex_types: false,\n107\t        }\n108\t    }\n109\t}\n110\t\n111\t// ─── Incremental watch types ──────────────────────────────────────────────────\n112\t\n113\t/// Result of processing a single file change in watch mode.\n114\t#[derive(Serialize)]\n115\t#[serde(rename_all = \"camelCase\")]\n116\tpub struct IncrementalUpdate {\n117\t    pub updated_components: Vec<ComponentEntry>,\n118\t    pub affected_files: Vec<Utf8PathBuf>,\n119\t    pub diagnostics: Vec<Diagnostic>,\n120\t    pub duration_ms: u64,\n121\t}\n122\t\n123\t/// Reverse dependency graph: file → list of files that import from it.\n124\t/// Built once from GlobalSourceData; used by WatchSession for BFS propagation.\n125\tpub struct ReverseDeps {\n126\t    pub(super) inner: FxHashMap<Utf8PathBuf, Vec<Utf8PathBuf>>,\n127\t}\n128\t\n129\timpl ReverseDeps {\n130\t    /// Build from a fully-merged GlobalSourceData.\n131\t    pub fn build(global: &GlobalSourceData) -> Self {\n132\t        let mut inner: FxHashMap<Utf8PathBuf, Vec<Utf8PathBuf>> = Default::default();\n133\t\n134\t        for (consumer_file, imports) in &global.import_map {\n135\t            for import in imports {\n136\t                // Only chase relative imports — package imports can't be naively reversed.\n137\t                if import.specifier.starts_with('.') {\n138\t                    if let Some(parent) = consumer_file.parent() {\n139\t                        let target = parent.join(&import.specifier);\n140\t                        // Approximate extension normalization without I/O.\n141\t                        for ext in &[\".ts\", \".tsx\", \"/index.ts\", \"/index.tsx\"] {\n142\t                            let candidate = Utf8PathBuf::from(format!(\"{}{}\", target, ext));\n143\t                            inner.entry(candidate).or_default().push(consumer_file.clone());\n144\t                        }\n145\t                    }\n146\t                }\n147\t            }\n148\t        }\n149\t\n150\t        Self { inner }\n151\t    }\n152\t\n153\t    /// BFS: collect all files transitively affected by a change to `changed`.\n154\t    pub fn affected(&self, changed: &Utf8Path) -> FxHashSet<Utf8PathBuf> {\n155\t        let mut visited: FxHashSet<Utf8PathBuf> = Default::default();\n156\t        let mut queue: VecDeque<Utf8PathBuf> = VecDeque::new();\n157\t        queue.push_back(changed.to_owned());\n158\t\n159\t        while let Some(file) = queue.pop_front() {\n160\t            if visited.insert(file.clone()) {\n161\t                for dep in self.inner.get(&file).into_iter().flatten() {\n162\t                    queue.push_back(dep.clone());\n163\t                }\n164\t            }\n165\t        }\n166\t\n167\t        visited\n168\t    }\n169\t}\n170\t\n171\t// ─── JSON serialization helpers ──────────────────────────────────────────────\n172\t\n173\t/// Serialize an [`ExtractionOutput`] to a JSON string.\n174\t///\n175\t/// Defined in core (not in the NAPI crate) so the JSON-building logic for\n176\t/// `PropType`'s hand-written `Serialize` (see ADR 0002) happens once here,\n177\t/// not in every downstream crate.\n178\tpub fn extraction_output_to_json(output: &ExtractionOutput) -> Result<String, serde_json::Error> {\n179\t    serde_json::to_string(output)\n180\t}\n181\t\n182\t/// Serialize an [`IncrementalUpdate`] to a JSON string (same reason as above).\n183\tpub fn incremental_update_to_json(update: &IncrementalUpdate) -> Result<String, serde_json::Error> {\n184\t    serde_json::to_string(update)\n185\t}\n186\t\n187\t// ─── Main cold extraction ─────────────────────────────────────────────────────\n188\t\n189\t/// Stateless extraction — suitable for CLI and NAPI cold runs.\n\n... [1009 lines truncated] ..."},"type":"attachment","uuid":"cd421827-c192-4d23-a5b3-15e1114c060c","timestamp":"2026-07-25T02:52:42.988Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.219","gitBranch":"main","slug":"delightful-booping-fern"}
