{"parentUuid":"220ca88b-d168-48b7-9080-20c4b604deca","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/gabe/Projects/oxc-react-codegen/crates/binding/src/lib.rs","snippet":"1\tuse std::sync::atomic::{AtomicU64, Ordering};\n2\tuse std::sync::{Arc, LazyLock};\n3\t\n4\tuse camino::Utf8Path;\n5\tuse dashmap::DashMap;\n6\tuse napi_derive::napi;\n7\t\n8\tuse oxc_react_docgen_core::pipeline::{\n9\t    extraction_output_to_json, incremental_update_to_json, PipelineOptions, WatchSession,\n10\t};\n11\t\n12\t// ─── Session store ────────────────────────────────────────────────────────────\n13\t\n14\tstatic SESSIONS: LazyLock<DashMap<u32, Arc<WatchSession>>> = LazyLock::new(DashMap::new);\n15\tstatic NEXT_SESSION_ID: AtomicU64 = AtomicU64::new(0);\n16\t\n17\tfn next_session_id() -> u32 {\n18\t    let pid = std::process::id() as u64;\n19\t    let counter = NEXT_SESSION_ID.fetch_add(1, Ordering::Relaxed);\n20\t    // Combine pid (upper 16 bits) with counter (lower 16 bits) into u32.\n21\t    // This avoids collisions across concurrent Vite dev server instances.\n22\t    (((pid & 0xFFFF) << 16) | (counter & 0xFFFF)) as u32\n23\t}\n24\t\n25\t// ─── JsExtractOptions ─────────────────────────────────────────────────────────\n26\t\n27\t/// Options passed from TypeScript — flat struct for easy NAPI marshalling.\n28\t#[napi(object)]\n29\tpub struct JsExtractOptions {\n30\t    pub src_dirs: Vec<String>,\n31\t    pub exclude: Option<Vec<String>>,\n32\t    #[napi(ts_type = \"'react18' | 'react19'\")]\n33\t    pub react_version: Option<String>,\n34\t    pub cross_package: Option<bool>,\n35\t    pub pandacss_outdir: Option<String>,\n36\t    pub variant_functions: Option<Vec<String>>,\n37\t    #[napi(ts_type = \"'curated' | 'full' | 'none'\")]\n38\t    pub html_attributes: Option<String>,\n39\t    // Fields from architectural review:\n40\t    pub tsconfig_path: Option<String>,\n41\t    pub extra_builtins: Option<Vec<String>>,\n42\t    pub vanilla_extract: Option<bool>,\n43\t    pub cache_dir: Option<String>,\n44\t    pub resolve_complex_types: Option<bool>,\n45\t    // Complex fields accepted as JSON strings to avoid napi object complexity:\n46\t    /// JSON: Record<string, string[]>\n47\t    pub extra_paths_json: Option<String>,\n48\t    /// JSON: Record<string, {kind: ...}>\n49\t    pub known_type_overrides_json: Option<String>,\n50\t}\n51\t\n52\t// ─── TryFrom<JsExtractOptions> for PipelineOptions ────────────────────────────\n53\t\n54\timpl TryFrom<JsExtractOptions> for PipelineOptions {\n55\t    /// Names the bad `reactVersion` value — a typo (or a caller bypassing the\n56\t    /// `'react18' | 'react19'` TS type, e.g. via `as any`) must not silently\n57\t    /// fall back to react19 (crates/core/CLAUDE.md non-negotiable #6).\n58\t    type Error = String;\n59\t\n60\t    fn try_from(js: JsExtractOptions) -> Result<Self, Self::Error> {\n61\t        use compact_str::CompactString;\n62\t\n63\t        let mut opts =\n64\t            PipelineOptions { src_dirs: js.src_dirs.into_iter().map(Into::into).collect(), ..Default::default() };\n65\t\n66\t        if let Some(exclude) = js.exclude {\n67\t            opts.exclude_patterns = exclude;\n68\t        }\n69\t        if let Some(v) = js.react_version.as_deref() {\n70\t            opts.react_version = oxc_react_docgen_core::react_types::parse_react_version(v)\n71\t                .map_err(|bad| format!(\"reactVersion is '{bad}', expected \\\"react18\\\" or \\\"react19\\\"\"))?;\n72\t        }\n73\t        if let Some(cross_package) = js.cross_package {\n74\t            opts.cross_package = cross_package;\n75\t        }\n76\t        if let Some(dir) = js.pandacss_outdir {\n77\t            opts.pandacss_outdir = Some(dir.into());\n78\t        }\n79\t        if let Some(fns) = js.variant_functions {\n80\t            opts.variant_functions = fns;\n81\t        }\n82\t        if let Some(mode) = js.html_attributes.as_deref() {\n83\t            opts.html_attributes = match mode {\n84\t                \"full\" => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Full,\n85\t                \"none\" => oxc_react_docgen_core::pipeline::HtmlAttributeMode::None,\n86\t                _ => oxc_react_docgen_core::pipeline::HtmlAttributeMode::Curated,\n87\t            };\n88\t        }\n89\t        if let Some(path) = js.tsconfig_path {\n90\t            opts.tsconfig_path = Some(path.into());\n91\t        }\n92\t        if let Some(names) = js.extra_builtins {\n93\t            opts.extra_builtins = names.into_iter().map(CompactString::from).collect();\n94\t        }\n95\t        if let Some(json) = js.extra_paths_json {\n96\t            opts.extra_paths = serde_json::from_str(&json).map_err(|e| format!(\"extraPaths is not valid JSON: {e}\"))?;\n97\t        }\n98\t        if let Some(json) = js.known_type_overrides_json {\n99\t            opts.known_type_overrides =\n100\t                serde_json::from_str(&json).map_err(|e| format!(\"knownTypeOverrides is not valid JSON: {e}\"))?;\n101\t        }\n102\t        if let Some(v) = js.vanilla_extract {\n103\t            opts.vanilla_extract = v;\n104\t        }\n105\t        if let Some(dir) = js.cache_dir {\n106\t            opts.cache_dir = Some(dir.into());\n107\t        }\n108\t        if let Some(v) = js.resolve_complex_types {\n109\t            opts.resolve_complex_types = v;\n110\t        }\n111\t\n112\t        Ok(opts)\n113\t    }\n114\t}\n115\t\n116\t// ─── Public NAPI functions ────────────────────────────────────────────────────\n117\t\n118\t/// Cold extraction — returns JSON string of ExtractionOutput.\n119\t/// Use for: build-time extraction, CLI backing, one-off runs.\n120\t#[napi]\n121\tpub async fn extract_all(options: JsExtractOptions) -> napi::Result<String> {\n122\t    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n123\t    tokio::task::spawn_blocking(move || {\n124\t        let output = oxc_react_docgen_core::pipeline::extract(&pipeline_options);\n125\t        extraction_output_to_json(&output).map_err(|e| napi::Error::from_reason(e.to_string()))\n126\t    })\n127\t    .await\n128\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n129\t}\n130\t\n131\t/// Create a persistent watch session. Returns session ID.\n132\t/// Call this in Vite's configResolved hook.\n133\t#[napi]\n134\tpub fn create_session(options: JsExtractOptions) -> napi::Result<u32> {\n135\t    let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n136\t    let id = next_session_id();\n137\t    let session = Arc::new(WatchSession::new(pipeline_options));\n138\t    SESSIONS.insert(id, session);\n139\t    Ok(id)\n140\t}\n141\t\n142\t/// Incremental extraction for a single changed file.\n143\t/// Returns JSON string of IncrementalUpdate.\n144\t/// Use for: Vite HMR hotUpdate.\n145\t#[napi]\n146\tpub async fn extract_file_incremental(\n147\t    file_path: String,\n148\t    session_id: u32,\n149\t    options: JsExtractOptions,\n150\t) -> napi::Result<String> {\n151\t    let session = match SESSIONS.get(&session_id) {\n152\t        Some(s) => s.clone(),\n153\t        None => {\n154\t            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n155\t            let s = Arc::new(WatchSession::new(pipeline_options));\n156\t            SESSIONS.insert(session_id, s.clone());\n157\t            s\n158\t        }\n159\t    };\n160\t\n161\t    tokio::task::spawn_blocking(move || {\n162\t        let path = Utf8Path::new(&file_path);\n163\t        let update = session.update_file(path);\n164\t        incremental_update_to_json(&update).map_err(|e| napi::Error::from_reason(e.to_string()))\n165\t    })\n166\t    .await\n167\t    .map_err(|e| napi::Error::from_reason(e.to_string()))?\n168\t}\n169\t\n170\t/// Initialize a watch session with a full cold extraction.\n171\t/// Returns JSON string of ExtractionOutput.\n172\t/// Call this after create_session(), in configureServer.\n173\t#[napi]\n174\tpub async fn initialize_session(session_id: u32, options: JsExtractOptions) -> napi::Result<String> {\n175\t    let session = match SESSIONS.get(&session_id) {\n176\t        Some(s) => s.clone(),\n177\t        None => {\n178\t            let pipeline_options = PipelineOptions::try_from(options).map_err(napi::Error::from_reason)?;\n179\t            let s = Arc::new(WatchSession::new(pipeline_options));\n180\t            SESSIONS.insert(session_id, s.clone());\n181\t            s\n182\t        }\n183\t    };\n184\t    tokio::task::spawn_blocking(move || {\n185\t        let output = session.initialize();\n186\t        oxc_react_docgen_core::pipeline::extraction_output_to_json(&output)\n\n... [74 lines truncated] ..."},"type":"attachment","uuid":"cd9b62d7-894e-4eb1-a182-7f8970a6d7fc","timestamp":"2026-07-22T21:09:55.093Z","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
