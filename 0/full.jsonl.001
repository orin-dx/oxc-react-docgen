ct_version: None,\n        cache_dir: None,\n        html_attributes: None,\n        config_path,\n        extra_builtins: &[],\n    })?;\n    let output = oxc_react_docgen_core::pipeline::extract(&options);\n\n    let errors: Vec<_> = output\n        .diagnostics\n        .iter()\n        .filter(|d| matches!(d.severity, oxc_react_docgen_core::types::DiagnosticSeverity::Error))\n        .collect();\n    let warnings: Vec<_> = output\n        .diagnostics\n        .iter()\n        .filter(|d| matches!(d.severity, oxc_react_docgen_core::types::DiagnosticSeverity::Warning))\n        .collect();\n\n    if args.json {\n        println!(\"{}\", serde_json::to_string(&output.diagnostics).into_diagnostic()?);\n    } else if !quiet {\n        print_summary(&output, quiet);\n        print_diagnostics(&output.diagnostics);\n    }\n\n    if !errors.is_empty() {\n        return Ok(2);\n    }\n    if args.strict && !warnings.is_empty() {\n        return Ok(1);\n    }\n\n    Ok(0)\n}\n","structuredPatch":[{"oldStart":45,"oldLines":3,"newStart":45,"newLines":16,"lines":[" ","     Ok(0)"," }","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+","+    #[test]","+    fn json_mode_still_returns_the_error_exit_code() {","+        let args =","+            crate::CheckArgs { src: vec![\"/nonexistent/does-not-exist\".into()], strict: false, json: true };","+        let code = cmd_check(args, true, None).expect(\"cmd_check itself should not error\");","+        assert_eq!(code, 2, \"expected exit code 2 for a nonexistent src dir even in --json mode\");","+    }","+}"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"32314a0b-25af-4da9-8153-31660e4427ba","session_id":"d83be67f-8b07-459c-989b-529791ef5ca7","userType":"external","entrypoint":"cli","cwd":"/Users/gabe/Projects/oxc-react-codegen","sessionId":"d83be67f-8b07-459c-989b-529791ef5ca7","version":"2.1.217","gitBranch":"main","slug":"delightful-booping-fern"}
